#!/usr/bin/env zsh
# Top bar (aka. System Tray) config
set -e

LOG_FILE=/home/tim/local/tmp/autostart.log
echo "[$(date)] topBar called" >>$LOG_FILE

# Note that we need to use dconf rather than gsettings here as extensions
# might not have a schema registered, so using gsettings will do nothing
#
# Options are grouped by icon as they are displayed in the top bar, even if the
# config spans several extensions. They are ordered from left to right

dconf write /org/gnome/shell/extensions/unite/reduce-panel-spacing true

# "Activities" button (zoom out of everything)
dconf write /org/gnome/shell/extensions/just-perfection/activities-button false

# Window buttons (down, window, maximize)
dconf write /org/gnome/shell/extensions/unite/show-window-buttons "'never'"

# Spotify Controls + Track Info
# position: 'rightmost-left' (default) places it in the left panel box — use right panel instead
dconf write /org/gnome/shell/extensions/spotify-controls/position "'leftmost-right'"
# Show only the track title, no playback buttons or Spotify icon
dconf write /org/gnome/shell/extensions/spotify-controls/show-playback-controls false
dconf write /org/gnome/shell/extensions/spotify-controls/show-spotify-icon false

# Clock
dconf write /org/gnome/shell/extensions/just-perfection/clock-menu-position 1
dconf write /org/gnome/shell/extensions/just-perfection/clock-menu-position-offset 10
dconf write /org/gnome/shell/extensions/just-perfection/world-clock false
dconf write /org/gnome/shell/extensions/just-perfection/weather false
dconf write /org/gnome/shell/extensions/just-perfection/events-button false

# Hide keyboard indicator
dconf write /org/gnome/shell/extensions/just-perfection/keyboard-layout false
# Hide accessibility icon
dconf write /org/gnome/shell/extensions/just-perfection/accessibility-menu false

# Quick settings
gsettings set org.gnome.desktop.interface show-battery-percentage true
dconf write /org/gnome/shell/extensions/just-perfection/quick-settings-dark-mode false
dconf write /org/gnome/shell/extensions/just-perfection/quick-settings-night-light false
dconf write /org/gnome/shell/extensions/just-perfection/quick-settings-airplane-mode false

# Notifications below quick settings
dconf write /org/gnome/shell/extensions/just-perfection/notification-banner-position 2

# Symlink oroshi-modes extension to GNOME extensions directory
local extensionDir=~/.local/share/gnome-shell/extensions/oroshi-modes@oroshi
ln -fsn $OROSHI_ROOT/tools/ubuntu/24.04/extensions/oroshi-modes/lib $extensionDir

# Extensions are displayed in the order they are enabled, from right to left.
# To ensure consistent placement, disable all first then enable in order.

local topbarExtensions=(
  ubuntu-appindicators@ubuntu.com         # App Indicators (Dropbox, etc.)
  just-perfection-desktop@just-perfection # Just Perfection + Clock
  unite@hardpixel.eu                      # Unite (reduce spacing)
  oroshi-modes@oroshi                      # Oroshi Modes
  spotify-controls@Sonath21               # Spotify Controls + Track Info
  wsmatrix@martin.zurowietz.de            # Workspace Matrix (3x3 grid)
  advanced-alt-tab@G-dH.github.com        # AATWS (Advanced Alt-Tab Window Switcher)
)

# Disable all topbar extensions
for ext in "${topbarExtensions[@]}"; do
  gext disable $ext &>/dev/null
done

sleep 2

# Enable from right to left
for ext in "${topbarExtensions[@]}"; do
  gext enable $ext &>/dev/null
  sleep 2
done
