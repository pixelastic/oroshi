# Mock SSH server (Docker)
Host            mock
  HostName        localhost
  Port            2222
  User            mock
  IdentityFile    ~/.ssh/id_mock

# Default settings
Host            *
  # Compress ssh traffic
  Compression     yes
  # Re-use the same multiplexed connection.
  ControlMaster   auto
  ControlPath     ~/.ssh/master-%r@%h:%p
  # SSH Handshake is persisted for 30s
  ControlPersist  30s
