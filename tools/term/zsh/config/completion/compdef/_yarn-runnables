#compdef

# Suggest scripts defined in package.json for yarn run
function _yarn-runnables() {
  colors-load-definitions
  icons-load-definitions

  local suggestions=(${(f)"$(complete-yarn-scripts)"})
  [[ "$suggestions" == "" ]] && return 0

  local label=" $ICONS[node-package] package.json scripts "
  local header="$(completion-header language-javascript black "$label")"
  _describe -V "$header" suggestions
}
