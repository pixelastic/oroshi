# Safe-delete empty directories only if inside the git worktree
# Usage:
# $ rmdir-guarded emptydir          # Delete empty dir in worktree
# $ rmdir-guarded dir1 dir2         # Delete multiple empty dirs
setopt local_options err_return

function emitRefusal() {
  local need="This deletion needs the user's approval."
  local retry="Retry the exact same command with /bin/rmdir in place of rmdir:"
  local approval="the user will get an approval prompt, and nothing is deleted before they accept."

  echoerr "[claude-guarded:refused] $need $retry $approval"
}

function rejectReason() {
  errors+=("rmdir $1 rejected. Reason: $2.")
}

# No git repo → refuse
if ! git-directory-is-repository; then
  echoerr "rmdir rejected. Reason: Not in a git repository."
  emitRefusal
  return 1
fi

local worktreeRoot="$(git-directory-root)"

# Validate each path is inside the worktree
local -a errors=()
for dirPath in "$@"; do
  local absolutePath="${dirPath:a}"

  # Outside worktree → refuse
  if [[ "$absolutePath" != "$worktreeRoot"/* ]]; then
    rejectReason "$dirPath" "Not in current worktree"
  fi
done

# No partial deletion — if any path failed, refuse all
if [[ ${#errors} -gt 0 ]]; then
  for error in "${errors[@]}"; do
    echoerr "$error"
  done
  emitRefusal
  return 1
fi

/bin/rmdir "$@"
