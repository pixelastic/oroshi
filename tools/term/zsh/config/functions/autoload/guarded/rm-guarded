# Safe-delete files and directories only if recoverable from HEAD
# Anything strictly under a free root (/tmp, /dev/shm, ~/local/tmp) is always allowed
# Paths are judged on the target rm acts on, then passed to /bin/rm untouched
# Usage:
# $ rm-guarded file.txt           # Delete committed file
# $ rm-guarded -rf dir/           # Delete dir if all files in HEAD
# $ rm-guarded -f a.txt b.txt     # Flags forwarded to /bin/rm
# $ rm-guarded /tmp/scratch.txt   # Delete file under a free root
setopt local_options err_return

# Folders where deleting is always allowed (the folder itself stays protected)
local -a FREE_ROOTS=(/tmp /dev/shm "$HOME/local/tmp")

function emitRefusal() {
  local need="This deletion needs the user's approval."
  local retry="Retry the exact same command with /bin/rm in place of rm:"
  local approval="the user will get an approval prompt, and nothing is deleted before they accept."

  echoerr "[claude-guarded:refused] $need $retry $approval"
}

function rejectReason() {
  errors+=("rm $1 rejected. Reason: $2.")
}

# Reject directory if any file on disk is not in HEAD
function validateDirectory() {
  local dirPath=$1

  # Each file on disk must exist in HEAD (an empty directory is safe)
  local diskFile
  for diskFile in ${(f)"$(find "$dirPath" -type f 2>/dev/null)"}; do
    local relPath="${diskFile#"$worktreeRoot"/}"
    if ! git-commit-has-file "$relPath"; then
      rejectReason "$filePath" "$relPath not committed in HEAD"
    fi
  done
}

# Print the path rm acts on: parent folder fully resolved, last component kept
# rm removes a symlink itself, it does not follow it
function resolveAsRm() {
  local name="${1:t}"

  # No usable last component (., .., /): resolve everything
  if [[ "$name" == "" || "$name" == "." || "$name" == ".." ]]; then
    print -r -- "${1:A}"
    return 0
  fi

  print -r -- "${${1:h}:A}/$name"
}

# Is the path strictly under one of the free roots?
function isUnderFreeRoot() {
  local root
  for root in "${FREE_ROOTS[@]}"; do
    [[ "$1" == "${root:A}"/* ]] && return 0
  done
  return 1
}

# Check one requested path, record a reason in $errors when it must be refused
function validatePath() {
  local filePath=$1
  local targetPath="$(resolveAsRm "$filePath")"

  # Worktree rules come first: a worktree under a free root stays protected
  local isInWorktree=0
  [[ "$worktreeRoot" != "" && "$targetPath" == "$worktreeRoot"/* ]] && isInWorktree=1

  # Under a free root, outside the worktree → always allowed
  if [[ $isInWorktree -eq 0 ]] && isUnderFreeRoot "$targetPath"; then
    return 0
  fi

  # No git repo → refuse
  if [[ "$worktreeRoot" == "" ]]; then
    rejectReason "$filePath" "Not in a git repository"
    return 0
  fi

  # Outside worktree → refuse
  if [[ $isInWorktree -eq 0 ]]; then
    rejectReason "$filePath" "Not in current worktree"
    return 0
  fi

  # Directory with recursive flag → batch-check all files
  if [[ -d "$targetPath" && $isRecursive -eq 1 ]]; then
    validateDirectory "$targetPath"
    return 0
  fi

  # Regular file → check in HEAD
  if ! git-commit-has-file "${targetPath#"$worktreeRoot"/}"; then
    rejectReason "$filePath" "Not committed in HEAD"
  fi
}

# Outside a git repo there is no worktree: only free roots can be deleted
local worktreeRoot=""
if git-directory-is-repository; then
  local rawRoot="$(git-directory-root)"
  worktreeRoot="${rawRoot:A}"
fi

# Detect recursive flags (-E: scan without consuming $@)
zparseopts -E \
  r=flagRecursive \
  R=flagRecursive \
  -recursive=flagRecursive

local isRecursive=${#flagRecursive}

# Collect non-flag paths for validation
local -a filePaths=()
for arg in "$@"; do
  [[ "$arg" != -* ]] && filePaths+=("$arg")
done

# Validate each path
local -a errors=()
for requestedPath in "${filePaths[@]}"; do
  validatePath "$requestedPath"
done

# No partial deletion — if any path failed, refuse all
if [[ ${#errors} -gt 0 ]]; then
  for error in "${errors[@]}"; do
    echoerr "$error"
  done
  emitRefusal
  return 1
fi

# Pass original args verbatim — flags preserved in position
/bin/rm "$@"
