# Build a throw-away git repo for one harness run
# It holds an uncommitted notes.txt, and repo-local lists that rewrite /bin/rm to the probe
# Usage:
# $ guarded-harness-sandbox /tmp/box   # Create the sandbox in /tmp/box
setopt local_options err_return

local sandboxDir="$1"

# No directory → nothing to build
if [[ "$sandboxDir" == "" ]]; then
  echoerr "Usage: guarded-harness-sandbox <dir>"
  return 1
fi

git init \
  --initial-branch=main \
  --quiet \
  "$sandboxDir"
git -C "$sandboxDir" config \
  user.email "harness@oroshi"
git -C "$sandboxDir" config \
  user.name "Harness"
git -C "$sandboxDir" commit \
  --allow-empty \
  --quiet \
  --message="init"

# Never committed, so rm-guarded refuses it
echo "notes" >"$sandboxDir/notes.txt"

# The pre-tool hook reads both repo-local lists
mkdir -p "$sandboxDir/.claude"
jo "/bin/rm=guarded-harness-probe" >"$sandboxDir/.claude/rewrite-list.json"
jo -a "guarded-harness-probe" >"$sandboxDir/.claude/allow-list.json"
