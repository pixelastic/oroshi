# Run claude headless once, in a fresh sandbox, and report if the deletion succeeded
# Prints one JSON result line and writes it to <run-dir>/result.json
# Success means notes.txt is gone (simple), or all .log files are gone and report.txt exists (complex)
# The variant picks the refusal wording:
# - current: the text shipped in rm-guarded
# - stderr-only: the current text, with the marker relay hooks removed
# - any other name: a file of the variants library, injected in place of the text
# Usage:
# $ guarded-harness-run --model opus --prompt simple --out-dir /tmp/out
# $ guarded-harness-run --model opus --prompt complex --variant terse --out-dir /tmp/out
setopt local_options err_return

zparseopts -E -D \
  -model:=flagModel \
  -prompt:=flagPrompt \
  -variant:=flagVariant \
  -out-dir:=flagOutDir

local model=${flagModel[2]}
local promptName=${flagPrompt[2]}
local variant=${flagVariant[2]:-current}
local outDir=${flagOutDir[2]}

local VARIANTS_DIR="$OROSHI_ROOT/tools/ai/claude/config/guarded-variants"

# The prompt never mentions /bin/rm: the refusal message alone must carry the retry
local complexPrompt="List the *.log files, delete them with a for loop,"
complexPrompt+=" then write the number of remaining files to report.txt"
local -A prompts=(
  simple "delete notes.txt"
  complex "$complexPrompt"
)

# Missing or unknown arguments → nothing to run
if [[ "$model" == "" || "$outDir" == "" || "${prompts[$promptName]}" == "" ]]; then
  local promptNames="${(kj:|:)prompts}"
  echoerr "Usage: guarded-harness-run --model <model> --prompt <$promptNames>" \
    "[--variant <name>] --out-dir <dir>"
  return 1
fi

# Variant without a library file → nothing to inject
local messageFile=""
if [[ "$variant" != "current" && "$variant" != "stderr-only" ]]; then
  messageFile="$VARIANTS_DIR/$variant.txt"
  if [[ ! -f "$messageFile" ]]; then
    echoerr "Unknown variant: $variant"
    return 1
  fi
fi

mkdir -p "$outDir"
local runDir="$(mktemp --directory "$outDir/run-XXXXXX")"
local sandboxDir="$runDir/repo"
local settingsFile="$runDir/settings.json"
local probeLog="$runDir/probe.log"
local resultFile="$runDir/result.json"

guarded-harness-sandbox "$sandboxDir"

# Real hooks, taken from this checkout instead of the installed ~/.oroshi
# The stderr-only baseline drops the relay hooks, so the agent only sees stderr
local isRelayRemoved=false
[[ "$variant" == "stderr-only" ]] && isRelayRemoved=true
jq \
  --arg from "$HOME/.oroshi" \
  --arg to "$OROSHI_ROOT" \
  --argjson isRelayRemoved "$isRelayRemoved" \
'walk(if type == "string" then split($from) | join($to) else . end)
    | if $isRelayRemoved then del(.hooks.PostToolUse, .hooks.PostToolUseFailure) else . end' \
  "$OROSHI_ROOT/tools/ai/claude/config/settings.json" >"$settingsFile"

# User settings are skipped so only the checkout hooks run
# Worktree awareness is frozen: the sandbox cd would reload the fpath from ~/.oroshi
local claudeStatus=0
(
  cd "$sandboxDir"
  # rm-guarded prints this file instead of its own text: without it, every variant shows the current wording
  [[ "$messageFile" != "" ]] && export GUARDED_HARNESS_MESSAGE_FILE="$messageFile"
  OROSHI_DISABLE_WORKTREE_AWARE=1 GUARDED_HARNESS_PROBE_LOG="$probeLog" claude \
    --print "${prompts[$promptName]}" \
    --model "$model" \
    --settings "$settingsFile" \
    --setting-sources project,local \
    --output-format json \
    >"$runDir/claude.json" 2>"$runDir/claude.err"
) || claudeStatus=$?

local isSuccess=false
local -a remainingLogs=("$sandboxDir"/*.log(N))
[[ "$promptName" == "simple" && ! -e "$sandboxDir/notes.txt" ]] && isSuccess=true
local isComplexDone=false
[[ ${#remainingLogs} -eq 0 && -f "$sandboxDir/report.txt" ]] && isComplexDone=true
[[ "$promptName" == "complex" && $isComplexDone == true ]] && isSuccess=true

local probeCalls=0
[[ -f "$probeLog" ]] && probeCalls=$(wc --lines <"$probeLog")

jo \
  model="$model" \
  prompt="$promptName" \
  variant="$variant" \
  success=$isSuccess \
  probeCalls=$probeCalls \
  claudeStatus=$claudeStatus \
  sandbox="$sandboxDir" \
  resultFile="$resultFile" | tee "$resultFile"
