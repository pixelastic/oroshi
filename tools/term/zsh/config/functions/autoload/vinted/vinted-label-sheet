# Build one printable sheet per parcel: the shipping label and what goes in it
# Usage:
# $ vinted-label-sheet ~/labels ~/vinted
# $ vinted-label-sheet ~/labels ~/vinted --output ~/to-print
# $ vinted-label-sheet ~/labels ~/vinted --force
# The labels folder is the one filled by vinted-label-fetch. The second
# argument is the folder holding the listing JSON files (annonces folders),
# which link an item id to its title and photo.
# Each sheet holds the label at its real size, then a checklist of the items,
# with their photo. A long list continues on a second page. The sheets go in a
# Sheets folder next to the labels, unless --output is given. A label that
# already has a sheet is skipped, unless --force is given.
# Lists the labels with no listing, and the PDFs the index does not know.
setopt local_options err_return

zparseopts -E -D -output:=flagOutput -force=flagForce

local labelsDirectory="$1"
local listingsRoot="$2"
local outputDirectory=${flagOutput[2]:-${labelsDirectory}/Sheets}

# Both folders are required
if [[ "$labelsDirectory" == "" || "$listingsRoot" == "" ]]; then
  echoerr "Usage: vinted-label-sheet <labels-folder> <listings-root> [--output <folder>] [--force]"
  return 1
fi

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/bin/vinted-label-sheet.js" \
  "${labelsDirectory:A}" \
  "${listingsRoot:A}" \
  "${outputDirectory:A}" \
  "${flagForce:+force}"
