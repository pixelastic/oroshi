# Mark the listings sold on Vinted, from the seller's sales page
# Usage:
# $ vinted-listing-sync ~/books                   # Mark the sold listings
# $ vinted-listing-sync ~/books --older-than 30   # List the listings online for more than 30 days
# Opens the logged-in Vinted session (run vinted-login first) and reads the item
# id of each sold item. A listing is sold when the id in its url matches. The
# title is never used. Writes status sold and soldAt in the matching listing.json.
# With --older-than, nothing is opened and nothing is written.
setopt local_options err_return

zparseopts -E -D -older-than:=flagOlderThan

local root="$1"
local olderThan=${flagOlderThan[2]}

# The root is required
if [[ "$root" == "" ]]; then
  echoerr "Usage: vinted-listing-sync <root> [--older-than <days>]"
  return 1
fi

# The threshold must be a number of days
if [[ "${#flagOlderThan}" != 0 && ! "$olderThan" =~ ^[0-9]+$ ]]; then
  echoerr "--older-than expects a number of days"
  return 1
fi

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/bin/vinted-listing-sync.js" "${root:A}" ${flagOlderThan:+"$olderThan"}
