# Print the median asking price of Vinted listings matching keywords
# Usage:
# $ vinted-price "dune frank herbert"                  # One search
# $ vinted-price "dune herbert" "dune poche herbert"   # Several searches, merged
# Prices are asking prices, not sale prices.
setopt local_options err_return

# At least one search is required
if [[ "$1" == "" ]]; then
  echoerr "Usage: vinted-price <keywords> [<other keywords>...]"
  return 1
fi

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/bin/vinted-price.js" "$@"
