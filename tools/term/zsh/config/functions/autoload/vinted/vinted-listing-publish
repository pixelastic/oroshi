# Publish every draft listing under a root, and record the URL in each JSON
# Usage:
# $ vinted-listing-publish ~/books
# Listings are published one at a time, in path order, with a pause between two.
# A listing that already has a url is skipped, so a re-run is safe.
# The first failure stops the batch, and the failed listing stays a draft.
# Writes url, postedAt and status online in each published listing.json.
setopt local_options err_return

local root="$1"

# The root is required
if [[ "$root" == "" ]]; then
  echoerr "Usage: vinted-listing-publish <root>"
  return 1
fi

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/bin/vinted-listing-publish.js" "${root:A}"
