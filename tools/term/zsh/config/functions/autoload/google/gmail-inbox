# List inbox mails as a table: date, sender, subject
# Usage:
# $ gmail-inbox            # latest mails (default limit: 100), pro account
# $ gmail-inbox --perso    # perso account
# $ gmail-inbox --limit 5  # custom limit (default: 100)
setopt local_options err_return

zparseopts -E -D \
  -perso=flagPerso \
  -limit:=flagLimit

local isPerso=${#flagPerso}
local account="pro"
[[ $isPerso == 1 ]] && account="perso"
local limit=${flagLimit[2]}
local width=${COLUMNS:-80}

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/gmail/inbox.js" "$account" "$limit" "$width"
