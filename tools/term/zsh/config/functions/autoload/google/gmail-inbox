# List inbox threads as a table, one row per thread, unread threads first, most recent last message first
# Columns: unread marker (●), date (MM/DD HH:mm), message count (blank for one message), authors, subject
# Usage:
# $ gmail-inbox            # latest threads (default limit: 25), pro account
# $ gmail-inbox --perso    # perso account
# $ gmail-inbox --limit 5  # custom limit, counted in threads (default: 25)
setopt local_options err_return

zparseopts -E -D \
  -perso=flagPerso \
  -limit:=flagLimit

local isPerso=${#flagPerso}
local account="pro"
[[ $isPerso == 1 ]] && account="perso"
local limit=${flagLimit[2]}
local width=${COLUMNS:-80}

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/gmail/inbox.js" "$account" "$limit" "$width"
