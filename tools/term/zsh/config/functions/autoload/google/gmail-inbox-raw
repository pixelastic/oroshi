# List inbox mails, one per line: id▮subject▮first line of content
# Usage:
# $ gmail-inbox-raw            # 20 latest, pro account
# $ gmail-inbox-raw --perso    # perso account
# $ gmail-inbox-raw --limit 5  # custom limit
setopt local_options err_return

zparseopts -E -D \
  -perso=flagPerso \
  -limit:=flagLimit

local isPerso=${#flagPerso}
local account="pro"
[[ $isPerso == 1 ]] && account="perso"
local limit=${flagLimit[2]:-20}

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/gmail-inbox-raw.js" "$account" "$limit"
