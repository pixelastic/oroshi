# List inbox threads, one per line, unread threads first, most recent last message first
# Fields: threadId▮unread▮date▮count▮authors▮subject▮snippet▮lastMessageId▮lastMessageDate
# The latest threads of the Gmail inbox (important first, then everything else) are listed, unread ones before read ones, each group sorted by lastMessageDate (most recent first)
# unread is 1 or 0, date is ISO 8601 (latest message in the inbox), lastMessageDate is ISO 8601 (latest message of the thread, sent ones included), count is the number of messages, authors are separated by ▯, unread authors first
# Pass threadId to gmail-read to read the whole thread
# Usage:
# $ gmail-inbox-raw            # latest threads (default limit: 25), pro account
# $ gmail-inbox-raw --perso    # perso account
# $ gmail-inbox-raw --limit 5  # custom limit, counted in threads
setopt local_options err_return

zparseopts -E -D \
  -perso=flagPerso \
  -limit:=flagLimit

local isPerso=${#flagPerso}
local account="pro"
[[ $isPerso == 1 ]] && account="perso"
local limit=${flagLimit[2]}

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/gmail/inboxRaw.js" "$account" "$limit"
