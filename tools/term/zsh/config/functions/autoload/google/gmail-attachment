# Download one attachment of a mail, print the path of the saved file
# Find attachment ids with gmail-read (attachments key)
# Usage:
# $ gmail-attachment --message-id <id> --attachment-id <id>                # saved in the current directory
# $ gmail-attachment --message-id <id> --attachment-id <id> --out ~/docs   # existing directory: remote filename
# $ gmail-attachment --message-id <id> --attachment-id <id> --out ./a.pdf  # exact file path
# $ gmail-attachment --perso --message-id <id> --attachment-id <id>        # perso account
setopt local_options err_return

zparseopts -E -D \
  -perso=flagPerso \
  -message-id:=flagMessageId \
  -attachment-id:=flagAttachmentId \
  -out:=flagOut

local isPerso=${#flagPerso}
local account="pro"
[[ $isPerso == 1 ]] && account="perso"
local messageId=${flagMessageId[2]}
local attachmentId=${flagAttachmentId[2]}
local out=${flagOut[2]}

# Both ids are required
if [[ "$messageId" == "" || "$attachmentId" == "" ]]; then
  echoerr "Usage: gmail-attachment [--perso] --message-id <id> --attachment-id <id> [--out <path>]"
  return 1
fi

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/gmail/attachment.js" "$account" "$messageId" "$attachmentId" "$out"
