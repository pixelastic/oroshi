# Read every mail of a thread, output a JSON array, oldest first
# Each item has id, from, to, subject, date, snippet, body, attachments
# Each attachment has partId, filename, mimeType, size: pass the mail id and partId to gmail-attachment
# Usage:
# $ gmail-read <threadId>          # pro account
# $ gmail-read --perso <threadId>  # perso account
setopt local_options err_return

zparseopts -E -D \
  -perso=flagPerso

local isPerso=${#flagPerso}
local account="pro"
[[ $isPerso == 1 ]] && account="perso"

local threadId=$1
# A thread id is required
if [[ "$threadId" == "" ]]; then
  echoerr "Usage: gmail-read [--perso] <threadId>"
  return 1
fi

local libDir="${functions_source[$0]:A:h}/__lib"
node "${libDir}/gmail/read.js" "$account" "$threadId"
