# Convert glob patterns to real filepaths;
# Usage:
# $ glob "./*.js"
# $ glob "./**/**"
setopt local_options err_return

# The below zsh patterns work as follow
# - "~" expands any glob pattern
# - (N) means to ignore patterns that don't match anything
for arg in $@; do
  echo $~arg(N) | xargs -n1
done
