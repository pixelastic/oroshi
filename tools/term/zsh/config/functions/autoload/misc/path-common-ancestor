# Find the deepest common ancestor directory of one or more paths
# Usage:
# $ path-common-ancestor /home/tim/a/b /home/tim/a/c   # /home/tim/a
# $ path-common-ancestor /tmp/x /home/tim/y             # /
# $ path-common-ancestor /home/tim/a/b                  # /home/tim/a
setopt local_options err_return

[[ $# -eq 0 ]] && return 1

local result="${1:a:h}"

for path in "${@:2}"; do
  local dir="${path:a:h}"
  while [[ "$result" != "/" ]]; do
    [[ "$dir" == "$result" || "$dir" == "$result"/* ]] && break
    result="${result:h}"
  done
done

print "$result"
