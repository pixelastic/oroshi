# Add a rule to the autocorrect rules file (an existing key is overwritten)
# An empty replacement suppresses the word.
# Usage:
# $ mic2txt-autocorrect-add eovim NeoVim   # "eovim" becomes "NeoVim"
# $ mic2txt-autocorrect-add euh ""         # "euh" is removed
setopt local_options err_return

# Both arguments are required, but the replacement may be empty
if [[ $# -lt 2 ]]; then
  echoerr "Usage: mic2txt-autocorrect-add <wrong> <right>"
  return 1
fi

local wrong="$1"
local right="$2"
local rulesFile=~/.oroshi/tools/term/zsh/config/functions/autoload/mic2txt/__data/autocorrect.json

mkdir --parents "${rulesFile:h}"

# Start from an empty rules object when the file is empty
[[ -s "$rulesFile" ]] || print -r -- "{}" >"$rulesFile"

# The key is JSON-quoted so any word is a valid jq path
local jsonKey="$(jq --raw-output --null-input --arg wrong "$wrong" '$wrong | @json')"

# stdin is closed so an empty replacement is not read from the terminal
# json-set fails on invalid existing JSON and keeps the rules file as it is
json-set --input "$rulesFile" ".[${jsonKey}]" "$right" </dev/null
