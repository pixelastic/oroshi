# Re-encode volume in a video to make it louder
# Usage:
# $ video-volume-increase file.mp4            # Increase volume
# $ video-volume-increase file1.mp4 file2.mp4 # Several files
setopt local_options err_return

# ffmpeg is required
if [[ "$(which ffmpeg)" == "" ]]; then
  echo "ffmpeg not found, installing it."
  sudo apt-get install ffmpeg
  return
fi

for file in $@; do
  echo "Increasing volume of $file"
  local tmpFile="./tmp${RANDOM}.${file:e}"
  ffmpeg \
    -i "$file" \
    -vcodec copy \
    -acodec libmp3lame \
    -ab 128k \
    -filter:a "volume=2.0" \
    "$tmpFile"
  mv "$file" "${file}.bak"
  mv "$tmpFile" "$file"
done
