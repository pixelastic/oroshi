# Put a Notion database in the trash by its ID or URL, and print the ID
# Notion can restore it
# Usage:
# $ notion-database-delete databaseId
# $ notion-database-delete https://www.notion.so/workspace/Meetups-3e07be57b8fa81bcb066c0275ed4b363
# $ notion-database-delete databaseId --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/notion-database-delete.js" "$@"
