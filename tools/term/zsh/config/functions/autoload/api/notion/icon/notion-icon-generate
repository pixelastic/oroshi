# Set the icon of a Notion page from the first image it holds, and print one result per page
# The image is resized, uploaded to my server, and set as the icon
# A page that has an icon is skipped, unless --force. A page with no image is skipped
# Use --recursive to also process every sub-page, at every level
# Usage:
# $ notion-icon-generate --pageId pageId
# $ notion-icon-generate --pageId pageId --force
# $ notion-icon-generate --pageId pageId --recursive
# $ notion-icon-generate --pageId https://www.notion.so/workspace/Meetup-3e07be57b8fa81bcb066c0275ed4b363
# $ notion-icon-generate --pageId pageId --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/notion-icon-generate.js" "$@"
