# Put a Notion page in the trash by its ID or URL, and print the ID
# Notion can restore it
# Usage:
# $ notion-page-delete pageId
# $ notion-page-delete https://www.notion.so/workspace/Meetup-3e07be57b8fa81bcb066c0275ed4b363
# $ notion-page-delete pageId --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/notion-page-delete.js" "$@"
