# Set the icon of a Notion page, and print it
# The icon is an emoji or the URL of an image, as the positional argument
# Usage:
# $ notion-icon-update --pageId pageId 🎲
# $ notion-icon-update --pageId pageId https://example.com/icon.png
# $ notion-icon-update --pageId https://www.notion.so/workspace/Meetup-3e07be57b8fa81bcb066c0275ed4b363 🎲
# $ notion-icon-update --pageId pageId 🎲 --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/notion-icon-update.js" "$@"
