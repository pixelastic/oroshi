# Read the icon of a Notion page, and print it
# It is an emoji, or the URL of an image, or nothing when the page has no icon
# Usage:
# $ notion-icon-read --pageId pageId
# $ notion-icon-read --pageId https://www.notion.so/workspace/Meetup-3e07be57b8fa81bcb066c0275ed4b363
# $ notion-icon-read --pageId pageId --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/notion-icon-read.js" "$@"
