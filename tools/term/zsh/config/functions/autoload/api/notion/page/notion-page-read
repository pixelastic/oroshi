# Read a Notion page by its ID or URL, and print it as JSON
# Usage:
# $ notion-page-read pageId
# $ notion-page-read https://www.notion.so/workspace/Meetup-3e07be57b8fa81bcb066c0275ed4b363
# $ notion-page-read pageId --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/notion-page-read.js" "$@"
