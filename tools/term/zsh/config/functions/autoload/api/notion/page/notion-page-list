# List the sub-pages of a Notion page as a colored table, one row per page
# Usage:
# $ notion-page-list pageId
# $ notion-page-list https://www.notion.so/workspace/Meetup-3e07be57b8fa81bcb066c0275ed4b363
# $ notion-page-list pageId --limit 10
# $ notion-page-list pageId --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawPages="$($rawCommand "$@")"

# Nothing to display if there is no sub-page
[[ "$rawPages" == "" ]] && return 1

local rows=()
for rawPage in ${(f)rawPages}; do
  local fields=("${(@ps/▮/)rawPage}")

  # Color the id. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[notion-page-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
