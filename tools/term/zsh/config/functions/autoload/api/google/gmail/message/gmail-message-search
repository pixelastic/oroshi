# Search the Messages (Gmail conversations) with a native Gmail query, and print them as JSON
# The id is the id of the conversation
# Usage:
# $ gmail-message-search 'from:bob is:unread'
# $ gmail-message-search 'in:inbox newer_than:3m' --limit 10
# $ gmail-message-search 'from:bob' --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/gmail-message-search.js" "$@"
