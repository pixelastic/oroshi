# List the Threads of the inbox as a colored table, one row per Thread
# Unread Threads come first, then the most recent ones
# Columns: unread marker (●), date (MM/DD HH:mm), Message count (blank for one Message), authors, subject
# For machine consumption, use gmail-thread-list-raw
# Usage:
# $ gmail-thread-list
# $ gmail-thread-list --limit 10
# $ gmail-thread-list --account perso
setopt local_options err_return

zmodload zsh/datetime
colors-load-definitions
icons-load-definitions

local AUTHORS_WIDTH=28

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawThreads="$($rawCommand "$@")"

# Nothing to display if there is no Thread
[[ "$rawThreads" == "" ]] && return 1

# Width of the widest Message count, to right-align the column
local countWidth=1
for rawThread in ${(f)rawThreads}; do
  local rawCount="${${(@ps/▮/)rawThread}[3]}"
  [[ ${#rawCount} -gt $countWidth ]] && countWidth=${#rawCount}
done

local rows=()
local epoch
for rawThread in ${(f)rawThreads}; do
  local fields=("${(@ps/▮/)rawThread}")
  local isoDate="${fields[2]}"
  local messageCount="${fields[3]}"
  local authors="${fields[4]//▯/, }"
  local subject="${fields[5]}"
  local isUnread="${fields[7]}"

  # Cells are never empty, or `table` would collapse the columns
  local marker=" "
  [[ "$isUnread" == "true" ]] && marker="$ICONS[gmail-unread]"

  # The raw date is UTC, show it in the local timezone
  epoch=""
  TZ=UTC strftime -rs epoch '%Y-%m-%dT%H:%M:%S' "${isoDate[1,19]}" 2>/dev/null || epoch=""
  local date=" "
  [[ "$epoch" != "" ]] && date="$(strftime '%m/%d %H:%M' "$epoch")"

  local count=""
  [[ "$messageCount" -gt 1 ]] && count="$messageCount"
  count="${(l:$countWidth:)count}"

  text-truncate --reply --width $AUTHORS_WIDTH "$authors"
  authors="$REPLY"

  local columns=(
    "$marker"
    "$(colorize "$date" $COLORS[gmail-date])"
    "$(colorize "$count" $COLORS[gmail-count])"
    "$(colorize "$authors" $COLORS[gmail-author])"
    "$(colorize "${subject//$'\n'/ }" $COLORS[gmail-subject])"
  )
  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
