# Create an Event, and print it as JSON
# Fields: --title (required), --date-start (required), --date-end, --location,
# --description, --description-file, --attendees, --private and --public
# A date with a time, as YYYY-MM-DDTHH:MM, is a local time in the time zone of
# the Calendar. An offset is rejected
# A date without a time, as YYYY-MM-DD, makes an All-day Event. Its --date-end
# is its last day: the same day as the start for one day
# Without --date-end, an Event lasts one hour, and an All-day Event one day
# --description-file takes precedence over --description
# --attendees is a comma-separated list of e-mail addresses
# --private hides the details of the Event from the readers of the Calendar
# --public gives the Event the default visibility of the Calendar
# Both flags together fail with GCAL_VISIBILITY_CONFLICT
# It never sends an e-mail to an Attendee
# The Calendar is the Primary by default
# Output: same JSON as gcal-event-read
# Usage:
# $ gcal-event-create --title Dentist --date-start 2026-11-02T10:00
# $ gcal-event-create --title Dentist --date-start 2026-11-02T10:00 --date-end 2026-11-02T10:30
# $ gcal-event-create --title "Day off" --date-start 2026-11-02
# $ gcal-event-create --title "Trip" --date-start 2026-11-02 --date-end 2026-11-04
# $ gcal-event-create --title Lunch --date-start 2026-11-02T12:00 --location "Chez Paul" --attendees a@algolia.com,b@algolia.com
# $ gcal-event-create --title Review --date-start 2026-11-02T14:00 --description "Bring the file"
# $ gcal-event-create --title Review --date-start 2026-11-02T14:00 --description-file ./agenda.md
# $ gcal-event-create --title Dentist --date-start 2026-11-02T10:00 --private
# $ gcal-event-create --title Dentist --date-start 2026-11-02T10:00 --calendarId work@group.calendar.google.com
# $ gcal-event-create --title Dentist --date-start 2026-11-02T10:00 --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/gcal-event-create.js" "$@"
