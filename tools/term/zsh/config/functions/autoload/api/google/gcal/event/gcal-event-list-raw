# List the Events of a period, one per line, for machine consumption
# Sorted by start. Recurring Events are expanded into one Event per occurrence
# For human consumption, use gcal-event-list
# Fields: eventId▮title▮status▮dateStart▮dateEnd▮isAllDay▮attendeeCount▮location▮isPrivate
# dateStart and dateEnd hold a time, or a date for an All-day Event, whose
# dateEnd is its last day
# The period is today and the next 7 days by default
# Usage:
# $ gcal-event-list-raw
# $ gcal-event-list-raw --today
# $ gcal-event-list-raw --week
# $ gcal-event-list-raw --date-min 2026-11-02
# $ gcal-event-list-raw --date-max 2026-11-02
# $ gcal-event-list-raw --date-min 2026-11-02 --date-max 2026-11-06
# $ gcal-event-list-raw --calendarId work@group.calendar.google.com
# $ gcal-event-list-raw --limit 10
# $ gcal-event-list-raw --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/gcal-event-list-raw.js" "$@"
