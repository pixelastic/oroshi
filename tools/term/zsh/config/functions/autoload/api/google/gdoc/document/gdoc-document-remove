# Delete one passage of a Google Doc, and print it as JSON
# The passage is plain text in one paragraph, and must appear once
# Other text, formatting and comments stay
# Usage:
# $ gdoc-document-remove https://docs.google.com/document/d/docA/edit --old 'Obsolete sentence.'
# $ gdoc-document-remove docA --old-file ./old.txt
# $ gdoc-document-remove docA --old 'Obsolete sentence.' --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/gdoc-document-remove.js" "$@"
