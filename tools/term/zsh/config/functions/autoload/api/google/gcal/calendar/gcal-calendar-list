# List the Calendars of the Account as a colored table, one row per Calendar
# The Primary comes first, then the others by name
# Columns: calendarId, name, primary marker, time zone
# For machine consumption, use gcal-calendar-list-raw
# Usage:
# $ gcal-calendar-list
# $ gcal-calendar-list --limit 10
# $ gcal-calendar-list --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawCalendars="$($rawCommand "$@")"

# Nothing to display if there is no Calendar
[[ "$rawCalendars" == "" ]] && return 1

local rows=()
for rawCalendar in ${(f)rawCalendars}; do
  local fields=("${(@ps/▮/)rawCalendar}")
  local isPrimary="${fields[3]}"

  # Cells are never empty, or `table` would collapse the columns
  local primaryMarker=" "
  [[ "$isPrimary" == "true" ]] && primaryMarker="primary"

  local columns=(
    "$(colorize "${fields[1]}" $COLORS[gcal-calendar-id])"
    "$(colorize "${fields[2]}" $COLORS[gcal-calendar-name])"
    "$(colorize "$primaryMarker" $COLORS[gcal-calendar-primary])"
    "${fields[4]}"
  )
  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
