# Search the Events of a Calendar with a free text, one per line, for machine
# consumption
# The text matches the title, description, location, Attendees and organizer
# Sorted by start. Recurring Events are expanded into one Event per occurrence
# Fields: eventId▮title▮status▮dateStart▮dateEnd▮isAllDay▮attendeeCount▮location
# dateStart and dateEnd hold a time, or a date for an All-day Event, whose
# dateEnd is its last day
# Unlike gcal-event-list-raw, there is no default period: it searches the whole
# Calendar. Any date flag narrows it
# Usage:
# $ gcal-event-search dentist
# $ gcal-event-search "team lunch" --week
# $ gcal-event-search dentist --date-min 2026-11-02 --date-max 2026-11-06
# $ gcal-event-search dentist --calendarId work@group.calendar.google.com
# $ gcal-event-search dentist --limit 10
# $ gcal-event-search dentist --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/gcal-event-search.js" "$@"
