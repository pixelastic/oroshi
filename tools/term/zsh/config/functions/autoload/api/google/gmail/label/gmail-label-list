# List the user labels of the Account as a colored table, one row per label
# Each name has the color of its label, and stays uncolored without color
# Columns: labelId, name, type, backgroundColor, textColor
# For machine consumption, use gmail-label-list-raw
# Usage:
# $ gmail-label-list
# $ gmail-label-list work
# $ gmail-label-list --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawLabels="$($rawCommand "$@")"

# Nothing to display if there is no label
[[ "$rawLabels" == "" ]] && return 1

local rows=()
local field
for rawLabel in ${(f)rawLabels}; do
  local fields=("${(@ps/▮/)rawLabel}")
  local name="${fields[2]}"
  local backgroundColor="${fields[4]}"

  # A label with a color shows its name in true color
  colorize-hex --reply "$name" "$backgroundColor"
  name="$REPLY"

  # Cells are never empty, or `table` would collapse the columns
  local columns=("$(colorize "${fields[1]}" $COLORS[gmail-label-id])" "$name")
  for field in "${(@)fields[3,-1]}"; do
    columns+=("${field:- }")
  done

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
