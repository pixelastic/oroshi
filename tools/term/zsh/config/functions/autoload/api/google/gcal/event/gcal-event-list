# List the Events of a period as a colored table, one row per Event
# Sorted by start. An All-day Event has a mark instead of a time
# Columns: start, end, all-day marker, title, status, attendee count, location
# For machine consumption, use gcal-event-list-raw
# Usage:
# $ gcal-event-list
# $ gcal-event-list --today
# $ gcal-event-list --week
# $ gcal-event-list --date-min 2026-11-02 --date-max 2026-11-06
# $ gcal-event-list --calendarId work@group.calendar.google.com
# $ gcal-event-list --limit 10
# $ gcal-event-list --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawEvents="$($rawCommand "$@")"

# Nothing to display if there is no Event
[[ "$rawEvents" == "" ]] && return 1

local rows=()
for rawEvent in ${(f)rawEvents}; do
  local fields=("${(@ps/▮/)rawEvent}")
  local isAllDay="${fields[6]}"

  # Cells are never empty, or `table` would collapse the columns
  local allDayMarker=" "
  [[ "$isAllDay" == "true" ]] && allDayMarker="all-day"
  local title="${fields[2]:- }"
  local location="${fields[8]:- }"

  local columns=(
    "$(colorize "${fields[4]}" $COLORS[gcal-event-date])"
    "$(colorize "${fields[5]}" $COLORS[gcal-event-date])"
    "$(colorize "$allDayMarker" $COLORS[gcal-event-all-day])"
    "$(colorize "$title" $COLORS[gcal-event-title])"
    "$(colorize "${fields[3]}" $COLORS[gcal-event-status])"
    "${fields[7]}"
    "$location"
  )
  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
