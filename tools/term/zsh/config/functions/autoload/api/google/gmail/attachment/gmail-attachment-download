# Download one attachment of a Message, and print the path of the saved file
# The messageId and the partId are listed by gmail-thread-read (messageId and attachments)
# --out is an existing directory (keeps the remote filename) or a file path
# Usage:
# $ gmail-attachment-download messageId --partId 1.2                    # saved in the current directory
# $ gmail-attachment-download messageId --partId 1.2 --out ~/docs       # existing directory: remote filename
# $ gmail-attachment-download messageId --partId 1.2 --out ./a.pdf      # exact file path
# $ gmail-attachment-download messageId --partId 1.2 --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/gmail-attachment-download.js" "$@"
