# Invite people to an Event, and print it as JSON
# The eventId is printed by gcal-event-list-raw
# --eventId is required. The e-mail addresses are positional, one or more
# The existing Attendees are kept
# An address that is already an Attendee changes nothing and is not an error.
# Addresses are compared without their case
# When every address is already present, nothing is saved
# It never sends an e-mail to an Attendee (sendUpdates=none)
# The Calendar is the Primary by default
# Output: same JSON as gcal-event-read
# Usage:
# $ gcal-attendee-add --eventId eventId amy@algolia.com
# $ gcal-attendee-add --eventId eventId amy@algolia.com bob@algolia.com
# $ gcal-attendee-add --eventId eventId amy@algolia.com --calendarId work@group.calendar.google.com
# $ gcal-attendee-add --eventId eventId amy@algolia.com --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/gcal-attendee-add.js" "$@"
