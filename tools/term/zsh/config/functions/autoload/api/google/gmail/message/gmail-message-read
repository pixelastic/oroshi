# Read a Message (Gmail conversation) as a whole, and print its Mails as a JSON array, oldest first
# The id is the id printed by gmail-message-list-raw and gmail-message-search
# Each Mail has id, from, to, subject, date, snippet, body, attachments
# Usage:
# $ gmail-message-read messageId
# $ gmail-message-read messageId --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/gmail-message-read.js" "$@"
