# Read a Thread as a whole, and print it as a JSON envelope, with its Messages oldest first
# The threadId is printed by gmail-thread-list-raw and gmail-thread-search
# Envelope: threadId, subject, unread, messages
# Each Message has messageId, from, to, subject, date, snippet, body, attachments
# Usage:
# $ gmail-thread-read threadId
# $ gmail-thread-read threadId --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/gmail-thread-read.js" "$@"
