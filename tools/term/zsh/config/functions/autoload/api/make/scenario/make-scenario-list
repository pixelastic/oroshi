# List the Scenarios of the Make team as a colored table, one row per scenario
# For machine consumption, use make-scenario-list-raw
# Without text, every Scenario matches
# --folderId keeps only the Scenarios directly in that Folder
# Usage:
# $ make-scenario-list
# $ make-scenario-list "sync"
# $ make-scenario-list "sync" --limit 10
# $ make-scenario-list --folderId 399268
# $ make-scenario-list "sync" --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawScenarios="$($rawCommand "$@")"

# Nothing to display if there is no scenario
[[ "$rawScenarios" == "" ]] && return 1

local rows=()
for rawScenario in ${(f)rawScenarios}; do
  local fields=("${(@ps/▮/)rawScenario}")

  # Color the id. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[make-scenario-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
