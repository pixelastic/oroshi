# Enable a Make scenario by its ID, so it runs on its scheduling, and print it as JSON
# Usage:
# $ make-scenario-enable 925
# $ make-scenario-enable 925 --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/make-scenario-enable.js" "$@"
