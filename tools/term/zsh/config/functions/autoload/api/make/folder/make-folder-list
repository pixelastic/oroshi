# List the top-level Folders of the Make team as a colored table, one row per folder
# For machine consumption, use make-folder-list-raw
# Usage:
# $ make-folder-list
# $ make-folder-list --limit 10
# $ make-folder-list --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawFolders="$($rawCommand "$@")"

# Nothing to display if there is no folder
[[ "$rawFolders" == "" ]] && return 1

local rows=()
for rawFolder in ${(f)rawFolders}; do
  local fields=("${(@ps/▮/)rawFolder}")

  # Color the id. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[make-folder-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
