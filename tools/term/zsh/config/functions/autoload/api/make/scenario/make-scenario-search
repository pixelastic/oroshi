# Search the Scenarios of the Make team by name, and print them as JSON
# Without text, every Scenario matches
# --folderId keeps only the Scenarios directly in that Folder
# Usage:
# $ make-scenario-search "sync"
# $ make-scenario-search "sync" --limit 10
# $ make-scenario-search --folderId 399268
# $ make-scenario-search "sync" --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/make-scenario-search.js" "$@"
