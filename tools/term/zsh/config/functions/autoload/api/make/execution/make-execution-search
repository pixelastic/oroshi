# Search the Executions of a Make scenario, newest first, and print them as JSON
# The scenario is the anchor. --status is success, warning or error
# Dates are ISO 8601, a date without time is midnight UTC
# Usage:
# $ make-execution-search --scenarioId 925
# $ make-execution-search --scenarioId 925 --status error
# $ make-execution-search --scenarioId 925 --date-min 2026-10-12 --date-max 2026-10-13
# $ make-execution-search --scenarioId 925 --limit 10
# $ make-execution-search --scenarioId 925 --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/make-execution-search.js" "$@"
