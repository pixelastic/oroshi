# Rename or move a Make folder, and print it as JSON
# Only the given fields change
# Usage:
# $ make-folder-update 399268 --name "Paris Meetup 2026"
# $ make-folder-update 399268 --parentFolderId 399270
# $ make-folder-update 399268 --name "Paris" --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/make-folder-update.js" "$@"
