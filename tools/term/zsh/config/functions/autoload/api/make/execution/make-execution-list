# List the Executions of a Make scenario as a colored table, one row per execution
# For machine consumption, use make-execution-list-raw
# The scenario is the anchor. --status is success, warning or error
# Dates are ISO 8601, a date without time is midnight UTC
# Usage:
# $ make-execution-list --scenarioId 925
# $ make-execution-list --scenarioId 925 --status error
# $ make-execution-list --scenarioId 925 --date-min 2026-10-12 --date-max 2026-10-13
# $ make-execution-list --scenarioId 925 --limit 10
# $ make-execution-list --scenarioId 925 --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawExecutions="$($rawCommand "$@")"

# Nothing to display if there is no execution
[[ "$rawExecutions" == "" ]] && return 1

local rows=()
for rawExecution in ${(f)rawExecutions}; do
  local fields=("${(@ps/▮/)rawExecution}")

  # Color the id. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[make-execution-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
