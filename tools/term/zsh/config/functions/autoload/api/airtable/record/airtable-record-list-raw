# List the Records of an Airtable table, one per line
# For machines and agents: one line per item, columns separated by ▮, full values. For a table that is easy for a human to read, use airtable-record-list
# Fields: recordId▮fields
# The fields column holds all the Fields of the Record as one JSON object
# Without a formula, every Record matches
# Usage:
# $ airtable-record-list-raw --baseId appXXX --tableId Meetups
# $ airtable-record-list-raw --baseId appXXX --tableId Meetups "{Name}='Paris'"
# $ airtable-record-list-raw --baseId appXXX --tableId tblXXX --limit 10
# $ airtable-record-list-raw --baseId appXXX --tableId Meetups --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/airtable-record-list-raw.js" "$@"
