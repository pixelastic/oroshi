# List the Airtable bases the token can access, one per line
# For machines and agents: one line per item, columns separated by ▮, full values. For a table that is easy for a human to read, use airtable-base-list
# Fields: baseId▮name
# Usage:
# $ airtable-base-list-raw
# $ airtable-base-list-raw --limit 10
# $ airtable-base-list-raw --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/airtable-base-list-raw.js" "$@"
