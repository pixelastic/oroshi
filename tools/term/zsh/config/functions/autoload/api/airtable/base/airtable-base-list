# List the Airtable bases the token can access as a colored table, one row per base
# For machine consumption, use airtable-base-list-raw
# Usage:
# $ airtable-base-list
# $ airtable-base-list --limit 10
# $ airtable-base-list --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawBases="$($rawCommand "$@")"

# Nothing to display if there is no base
[[ "$rawBases" == "" ]] && return 1

local rows=()
for rawBase in ${(f)rawBases}; do
  local fields=("${(@ps/▮/)rawBase}")

  # Color the id. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[airtable-base-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
