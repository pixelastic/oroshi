# Read an Airtable record by its ID, and print it as JSON
# Usage:
# $ airtable-record-read recXXX --baseId appXXX --tableId Meetups
# $ airtable-record-read recXXX --baseId appXXX --tableId tblXXX
# $ airtable-record-read recXXX --baseId appXXX --tableId Meetups --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/airtable-record-read.js" "$@"
