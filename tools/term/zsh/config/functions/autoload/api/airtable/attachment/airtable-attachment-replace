# Replace every Attachment of a Field with one local file, and print the Record as JSON
# The file is uploaded first, so a failed upload keeps the old Attachments. The file must be 5 MB at most
# Usage:
# $ airtable-attachment-replace --baseId appXXX --tableId Meetups --recordId recXXX --field Logo --file ./logo.png
# $ airtable-attachment-replace --baseId appXXX --tableId Meetups --recordId recXXX --field Logo --file ./logo.png --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/airtable-attachment-replace.js" "$@"
