# Remove Attachments from a Field of type Attachment, by ID, and print the Record as JSON
# The other Attachments stay in the Field. Nothing changes if an ID is not in the Field
# Usage:
# $ airtable-attachment-remove --baseId appXXX --tableId Meetups --recordId recXXX --field Logo --attachmentId attXXX
# $ airtable-attachment-remove --baseId appXXX --tableId Meetups --recordId recXXX --field Logo --attachmentId attXXX --attachmentId attYYY
# $ airtable-attachment-remove --baseId appXXX --tableId Meetups --recordId recXXX --field Logo --all
# $ airtable-attachment-remove --baseId appXXX --tableId Meetups --recordId recXXX --field Logo --all --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/airtable-attachment-remove.js" "$@"
