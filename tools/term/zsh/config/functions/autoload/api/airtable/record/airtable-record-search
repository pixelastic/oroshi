# Search the Records of an Airtable table with a formula, and print them as JSON
# Without a formula, every Record matches
# Each element is {"id": "recXXX", "fields": {…}}
# Usage:
# $ airtable-record-search --baseId appXXX --tableId Meetups "{name}='Paris'"
# $ airtable-record-search --baseId appXXX --tableId tblXXX "SEARCH('paris', LOWER({name}))" --limit 10
# $ airtable-record-search --baseId appXXX --tableId Meetups --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/airtable-record-search.js" "$@"
