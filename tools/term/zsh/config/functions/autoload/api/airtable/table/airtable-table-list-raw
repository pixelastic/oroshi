# List the tables of an Airtable base, one per line
# For machines and agents: one line per item, columns separated by ▮, full values. For a table that is easy for a human to read, use airtable-table-list
# Fields: tableId▮name
# Usage:
# $ airtable-table-list-raw --baseId appXXX
# $ airtable-table-list-raw --baseId appXXX --limit 10
# $ airtable-table-list-raw --baseId appXXX --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/airtable-table-list-raw.js" "$@"
