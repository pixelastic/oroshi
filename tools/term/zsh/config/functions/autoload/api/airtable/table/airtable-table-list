# List the tables of an Airtable base as a colored table, one row per table
# Usage:
# $ airtable-table-list --baseId appXXX
# $ airtable-table-list --baseId appXXX --limit 10
# $ airtable-table-list --baseId appXXX --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawTables="$($rawCommand "$@")"

# Nothing to display if there is no table
[[ "$rawTables" == "" ]] && return 1

local rows=()
for rawTable in ${(f)rawTables}; do
  local fields=("${(@ps/▮/)rawTable}")

  # Color the id. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[airtable-table-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
