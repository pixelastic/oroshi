# List the Records of an Airtable table as a colored table, one row per record
# For machine consumption, use airtable-record-list-raw
# Usage:
# $ airtable-record-list --baseId appXXX --tableId Meetups
# $ airtable-record-list --baseId appXXX --tableId Meetups "{Name}='Paris'"
# $ airtable-record-list --baseId appXXX --tableId tblXXX --limit 10
# $ airtable-record-list --baseId appXXX --tableId Meetups --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawRecords="$($rawCommand "$@")"

# Nothing to display if there is no record
[[ "$rawRecords" == "" ]] && return 1

local rows=()
for rawRecord in ${(f)rawRecords}; do
  local fields=("${(@ps/▮/)rawRecord}")

  # Color the id. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[airtable-record-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
