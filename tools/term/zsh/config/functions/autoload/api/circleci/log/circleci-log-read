# Read the log of a CircleCI run by its id, and print it as JSON
# Prints the id, the project and the start of the run, and one entry per step of
# every job: job name and number, step name, status, duration in seconds and the
# output, without ANSI codes. Jobs without a number (approvals) have no step
# --job keeps the steps of the job of this name
# --status keeps the steps of this status (success, failed...). It applies
# before the download, so a filtered step costs no request
# Usage:
# $ circleci-log-read 1bd4f068-b2f0-4769-8574-609c4e00ae6c
# $ circleci-log-read 1bd4f068-b2f0-4769-8574-609c4e00ae6c --status failed
# $ circleci-log-read 1bd4f068-b2f0-4769-8574-609c4e00ae6c --job ci
# $ circleci-log-read 1bd4f068-b2f0-4769-8574-609c4e00ae6c --job ci --status failed
# $ circleci-log-read 1bd4f068-b2f0-4769-8574-609c4e00ae6c --account perso
setopt local_options err_return

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/circleci-log-read.js" "$@"
