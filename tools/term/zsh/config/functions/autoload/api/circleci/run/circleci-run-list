# List the runs of a CircleCI project as a colored table, one row per run
# For machine consumption, use circleci-run-list-raw
# --project is required, and has no default. --branch keeps one branch
# --limit is the number of runs read
# --status keeps the runs of one status (success, failed, running...). CircleCI
# has no status filter, so it applies after --limit: the table can hold fewer
# runs than --limit, and a short table is not a complete one
# Usage:
# $ circleci-run-list --project gh/pixelastic/firost
# $ circleci-run-list --project gh/pixelastic/firost --branch renovate/tooling
# $ circleci-run-list --project gh/pixelastic/firost --status failed
# $ circleci-run-list --project gh/pixelastic/firost --limit 50
# $ circleci-run-list --project gh/pixelastic/firost --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawRuns="$($rawCommand "$@")"

# Nothing to display if there is no run
[[ "$rawRuns" == "" ]] && return 1

local rows=()
for rawRun in ${(f)rawRuns}; do
  local fields=("${(@ps/▮/)rawRun}")

  # Color the id. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[circleci-run-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
