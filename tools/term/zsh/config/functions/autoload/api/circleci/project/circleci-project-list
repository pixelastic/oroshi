# List the CircleCI projects that the account follows as a colored table, one row per project
# For machine consumption, use circleci-project-list-raw
# CircleCI only lists the projects that the account follows
# Usage:
# $ circleci-project-list
# $ circleci-project-list firost
# $ circleci-project-list firost --limit 10
# $ circleci-project-list firost --account perso
setopt local_options err_return

colors-load-definitions

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawProjects="$($rawCommand "$@")"

# Nothing to display if there is no project
[[ "$rawProjects" == "" ]] && return 1

local rows=()
for rawProject in ${(f)rawProjects}; do
  local fields=("${(@ps/▮/)rawProject}")

  # Color the slug. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[circleci-project-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
