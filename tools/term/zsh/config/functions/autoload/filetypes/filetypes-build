# Build dist/filetypes.json and dist/filetypes.zsh from src/filetypes.jsonc
# Reads dist/colors.json and dist/icons.json to resolve color/icon keys.
# Usage:
#   $ filetypes-build
# Output:
#   dist/filetypes.json — {"key":{"color":{name,ansi,hex},"icon":{name,glyph},"bold":bool,...}}
#   dist/filetypes.zsh  — FILETYPES[key:attr]=value
setopt local_options err_return

local themingRoot="$OROSHI_ROOT/tools/term/zsh/config/theming"
local srcJsonc="$themingRoot/src/filetypes.jsonc"
local srcJson="$(jsonc2json "$srcJsonc")"
local distDir="$themingRoot/dist"
local distJson="$distDir/filetypes.json"
local distZsh="$distDir/filetypes.zsh"

mkdir -p "$distDir"

# Generate dist/filetypes.json — resolved color/icon objects, keys sorted {{{
function generateDistJson() {
  jq -n \
    --argjson src "$srcJson" \
    --argjson colors "$(cat "$distDir/colors.json")" \
    --argjson icons "$(cat "$distDir/icons.json")" \
  '
    [$src | to_entries[]
      | .key as $name
      | .value as $group
      | ($group.color) as $gColor
      | ($group.icon) as $gIcon
      | (if $group.bold then true else false end) as $gBold
      | # Group entry
      {
        key: $name,
        value: {
          color: { name: $gColor, ansi: $colors[$gColor].ansi, hex: $colors[$gColor].hex },
          icon: { name: $gIcon, glyph: $icons[$gIcon] },
          bold: $gBold
        }
      },

      # Pattern entries
      ($group.patterns[]
        | if type == "string" then
          {
            key: (. | ascii_downcase | gsub("[.]";"_")),
            value: {
              color: { name: $gColor, ansi: $colors[$gColor].ansi, hex: $colors[$gColor].hex },
              icon: { name: $gIcon, glyph: $icons[$gIcon] },
              bold: $gBold,
              pattern: ("*." + .),
              group: $name
            }
          }
        elif .filename then
          (.color // $gColor) as $c
          | (.icon // $gIcon) as $i
          | (if .bold == null then $gBold elif .bold then true else false end) as $b
          | {
            key: (.filename | ascii_downcase | gsub("[.]";"_")),
            value: {
              color: { name: $c, ansi: $colors[$c].ansi, hex: $colors[$c].hex },
              icon: { name: $i, glyph: $icons[$i] },
              bold: $b,
              pattern: .filename,
              group: $name
            }
          }
        elif .extension then
          (.color // $gColor) as $c
          | (.icon // $gIcon) as $i
          | (if .bold == null then $gBold elif .bold then true else false end) as $b
          | {
            key: (.extension | ascii_downcase | gsub("[.]";"_")),
            value: {
              color: { name: $c, ansi: $colors[$c].ansi, hex: $colors[$c].hex },
              icon: { name: $i, glyph: $icons[$i] },
              bold: $b,
              pattern: ("*." + .extension),
              group: $name
            }
          }
        end
      )
    ] | sort_by(.key) | from_entries
  ' | jq --sort-keys '.' >"$distJson"
}
# }}}

# Generate dist/filetypes.zsh from dist/filetypes.json {{{
function generateDistZsh() {
  {
    echo "# zsh-lint disable-file=commandTooLong"
    echo "typeset -gA FILETYPES"
    jq -r '
      to_entries[]
      | .key as $key
      | .value
      | "FILETYPES[\($key):color]=\(.color.ansi)",
        "FILETYPES[\($key):icon]=\"\(.icon.glyph)\"",
        "FILETYPES[\($key):bold]=\(if .bold then 1 else 0 end)",
        (if .pattern then "FILETYPES[\($key):pattern]=\(.pattern)" else empty end),
        (if .group then "FILETYPES[\($key):group]=\(.group)" else empty end)
    ' "$distJson"
  } >"$distZsh"
}
# }}}

generateDistJson
generateDistZsh
