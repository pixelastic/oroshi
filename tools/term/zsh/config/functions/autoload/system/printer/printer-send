# Print files on the printer of the current wifi network
# Usage:
# $ printer-send ./file.pdf              # Print on the printer matching the active SSID
# $ printer-send ./a.pdf ./b.pdf         # Print several files in one job
# Sends nothing and fails when no file is given or when any file is missing.
setopt local_options err_return

# Printer queue to use for each known wifi network
local -A PRINTER_BY_SSID=(
  Waterfront HLL2375DW
  algolia Ricoh-IM-C300
)

local files=("$@")

# Stop when no file is given
if [[ ${#files} -eq 0 ]]; then
  echoerr "Usage: printer-send file [file ...]"
  return 1
fi

# Stop before any send when a file is missing
local file
for file in "${files[@]}"; do
  if [[ ! -e "$file" ]]; then
    echoerr "printer-send: file not found: $file"
    return 1
  fi
done

local ssid="$(
  nmcli \
    --terse \
    --fields active,ssid \
    dev wifi \
    | grep \
      --max-count=1 \
      '^yes:'
)"
ssid="${ssid#yes:}"

# Stop when no wifi is active
if [[ "$ssid" == "" ]]; then
  echoerr "printer-send: no active wifi"
  return 1
fi

# Stop when the active network has no known printer
if [[ "$PRINTER_BY_SSID[$ssid]" == "" ]]; then
  echoerr "printer-send: no printer for wifi"
  return 1
fi

lp -d "$PRINTER_BY_SSID[$ssid]" "${files[@]}"
