# Print a file on the printer of the current wifi network
# Usage:
# $ printer-send ./file.pdf    # Print on the printer matching the active SSID
setopt local_options err_return

# Printer queue to use for each known wifi network
local -A PRINTER_BY_SSID=(
  Waterfront HLL2375DW
  algolia Ricoh-IM-C300
)

local file="$1"

local ssid="$(
  nmcli \
    --terse \
    --fields active,ssid \
    dev wifi \
    | grep \
      --max-count=1 \
      '^yes:'
)"
ssid="${ssid#yes:}"

local knownSsids="${(kj:, :)PRINTER_BY_SSID}"

# Stop when no wifi is active
if [[ "$ssid" == "" ]]; then
  echoerr "printer-send: no active wifi. Known networks: $knownSsids"
  return 1
fi

# Stop when the active network has no known printer
if [[ "$PRINTER_BY_SSID[$ssid]" == "" ]]; then
  echoerr "printer-send: no printer for wifi '$ssid'. Known networks: $knownSsids"
  return 1
fi

lp -d "$PRINTER_BY_SSID[$ssid]" "$file"
