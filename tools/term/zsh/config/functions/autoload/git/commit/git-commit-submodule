# Commit the content of a specific submodule with a chore() message
# Usage:
# $ git-commit-submodule ./scripts/bin/img           # Relative to CWD
# $ git-commit-submodule /repo/scripts/bin/img       # Absolute path
setopt local_options err_return

local submodulePath="$1"
local submoduleName="${submodulePath:t}"

local gitRoot
if [[ "$submodulePath" == /* ]]; then
  # Absolute path: derive git root from the submodule's parent repo
  gitRoot="$(git-directory-root --force "$submodulePath")"
  submodulePath="${submodulePath#"$gitRoot"/}"
else
  gitRoot="$(git-directory-root --force)"
fi

# Use submodule latest commit as body for root commit
local subjectLine="$(git -C "$gitRoot/$submodulePath" log -1 --format=%s)"
local message="chore(${submoduleName}): Update $submodulePath submodule"
[[ "$subjectLine" != "" ]] && message+=$'\n\n'"$subjectLine"

# Commit the submodule changes to the root repository
git -C "$gitRoot" add $submodulePath
git -C "$gitRoot" commit --message "$message"
