# Boolean: does the current context have an associated plan in the external store?
# Usage:
# $ git-worktree-has-plan            # checks current context
# $ git-worktree-has-plan /path/dir  # checks given path
setopt local_options err_return

local planDir="$(plan-directory "$@" 2>/dev/null)"
[[ "$planDir" == "" ]] && return 1
[[ -f "$planDir/state.json" ]]
