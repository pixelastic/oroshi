# Verify Git Repo Main's submodules are clean and synced with remote
# Checks submodules whose pointer differs between the Worktree and Git Repo Main
# Usage:
# $ git-worktree-submodule-preflight            # current directory
# $ git-worktree-submodule-preflight /path/to   # given worktree path
setopt local_options err_return

local worktreePath="${1:-$PWD}"

# Stop if not in a worktree
git-directory-is-worktree "$worktreePath" || return 1

# Stop if no submodules
local mainPath="$(git-worktree-main "$worktreePath")"
local submoduleList="$(git-submodule-list-raw "$mainPath")"
[[ "$submoduleList" == "" ]] && return 0

# Load theming for colorized error messages
colors-load-definitions
icons-load-definitions
projects-load-definitions

# Resolve project name and display as a badge for error messages
local repoName="$(git-directory-name "$mainPath")"
local projectDisplay=""
if [[ "$PROJECTS[$repoName:foreground:ansi]" != "" ]]; then
  local _fg="$PROJECTS[$repoName:foreground:ansi]"
  local _bg="$PROJECTS[$repoName:background:ansi]"
  local _sep="$ICONS[badge-separator]"
  projectDisplay="$(colorize " $PROJECTS[$repoName:icon]$repoName " "$_fg" "$_bg")$(colorize "$_sep" "$_bg")"
else
  projectDisplay="$(colorize "$repoName" "$COLORS[directory]")"
fi
local colorizedError="$(colorize "✘" "$COLORS[error]")"

local hasFailure=0
for rawLine in ${(f)submoduleList}; do
  local fields=(${(@ps/▮/)rawLine})
  local submoduleName=$fields[1]

  # Skip if submodule pointer is same in worktree and main
  git-worktree-submodule-pointer-differs "$submoduleName" "$worktreePath" || continue

  local colorizedIcon="$(colorize "$ICONS[git-submodule]" "$COLORS[git-submodule]")"
  local colorizedName="$(colorize "$submoduleName" "$COLORS[directory]")"

  # Failure if main's submodule has uncommitted changes
  local dirtyCount="$(git-directory-dirty-count "$mainPath/$submoduleName")"
  if [[ "$dirtyCount" != "0" ]]; then
    local prefix="$colorizedError $colorizedIcon $colorizedName"
    local location="in $projectDisplay repo"
    echo "$prefix $location has uncommitted changes. Commit them first."
    hasFailure=1
    continue
  fi

  # Fetch latest from remote
  git -C "$mainPath/$submoduleName" fetch --quiet

  # Failure if main's submodule has unpushed commits
  local remoteDistance="$(git-branch-remote-distance-raw --repo "$mainPath/$submoduleName" 2>/dev/null)"
  local distanceFields=(${(@ps/▮/)remoteDistance})
  if [[ $distanceFields[1] -gt 0 ]]; then
    local prefix="$colorizedError $colorizedIcon $colorizedName"
    local location="in $projectDisplay repo"
    echo "$prefix $location has unpushed commits. Push them first."
    hasFailure=1
    continue
  fi
done

return $hasFailure
