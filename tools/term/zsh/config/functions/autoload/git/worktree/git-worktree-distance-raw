# Ahead/behind commit count between a branch and main, machine-readable
# Usage:
# $ git-worktree-distance-raw                          # auto-detects repo and branch
# $ git-worktree-distance-raw /path/to/repo            # auto-detects branch
# $ git-worktree-distance-raw --branch fix/bug         # explicit branch in PWD
# $ git-worktree-distance-raw /path/to/repo --branch fix/bug
setopt local_options err_return

zparseopts -E -D \
  -branch:=flagBranch

local repo="${1:-$PWD}"
local branch=${flagBranch[2]}
[[ "$branch" == "" ]] && branch="$(git-branch-current "$repo")"

# Not in a git repo or detached HEAD
[[ "$branch" == "" || "$branch" == "HEAD" ]] && return 1

local rawDistance="$(git -C "$repo" rev-list --left-right --count "${branch}...main" 2>/dev/null)"

# Branch unknown or main missing
[[ "$rawDistance" == "" ]] && return 1

local ahead
local behind
read -r ahead behind <<<"$rawDistance"

echo "${ahead:-0}▮${behind:-0}"
