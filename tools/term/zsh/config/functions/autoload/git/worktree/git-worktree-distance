# Ahead/behind commit count between current worktree branch and main
# Usage:
# $ git-worktree-distance                    # current worktree
# $ git-worktree-distance /path/to/worktree
setopt local_options err_return

local repo="${1:-$PWD}"

local branch="$(git-branch-current "$repo")"

# Not in a git repo or detached HEAD
[[ "$branch" == "" || "$branch" == "HEAD" ]] && return 1

# Ahead/behind vs main via git-worktree-distance-raw
local rawDistance="$(git-worktree-distance-raw "$repo" --branch "$branch" 2>/dev/null)"

# Failed (e.g. main doesn't exist)
[[ "$rawDistance" == "" ]] && return 1

local -a parts=(${(@ps/▮/)rawDistance})
local ahead=${parts[1]:-0}
local behind=${parts[2]:-0}

echo "ahead $ahead, behind $behind"
