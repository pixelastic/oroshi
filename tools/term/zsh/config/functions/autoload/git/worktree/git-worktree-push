# Push current worktree into main and sync dependencies
# Runs submodule preflight, pushes changed submodules, then merges
# Usage:
# $ git-worktree-push
setopt local_options err_return

local currentBranch="$(git-branch-current)"
local mainPath="$(git-worktree-main)"

# Abort if submodules in Git Repo Main are not clean/synced
echo "Checking submodules..."
git-worktree-submodule-preflight

# Push submodules whose pointer differs between Worktree and Git Repo Main
local submoduleList="$(git-submodule-list-raw "$mainPath")"
for rawLine in ${(f)submoduleList}; do
  local fields=(${(@ps/▮/)rawLine})
  local submoduleName=$fields[1]

  # If the submodule is at the same pointer in the worktree and in main, skip it
  git-worktree-submodule-pointer-differs "$submoduleName" || continue

  # Push the submodule to its remote
  echo "Pushing $submoduleName..."
  git-branch-push-pretty --repo "$PWD/$submoduleName"
done

# Push the worktree to main
echo "Merging into main..."
local previousCommit="$(git -C "$mainPath" rev-parse HEAD)"
git -C "$mainPath" merge --ff-only "$currentBranch"

# Update dependencies if needed
echo "Updating dependencies..."
git-dependencies-update --repo "$mainPath" "$previousCommit" --async

# Stop here if not an oroshi worktree
git-worktree-is-oroshi || return 0

# Reload colors if any color source files changed
if git-file-has-changed \
  tools/term/kitty/config/colors.conf \
  tools/term/zsh/config/theming/src/colors.jsonc \
  tools/term/zsh/config/theming/src/icons.jsonc \
  tools/term/zsh/config/theming/src/filetypes.jsonc \
  tools/term/zsh/config/theming/src/projects.jsonc \
  tools/cli/bat/config/src/oroshi.xml \
  tools/cli/rg/config/src/rgrc.conf \
  tools/git/git/config/src/gitconfig \
  tools/git/hunk/config/src/config.toml \
  tools/ai/claude/config/themes/src/oroshi.json \
  tools/vim/nvim/config/lua/oroshi/colorscheme/syntax.lua \
  --from "$previousCommit" \
  --repo "$mainPath";
then
  echo "Updating colors..."
  OROSHI_ROOT="$mainPath" colors-reload
fi

# Deploy skills if any skill beacon files changed
if git-file-has-changed \
  tools/ai/claude/config/claude.json \
  tools/ai/claude/config/skills/ \
  private/config/ai/claude/skills/ \
  --from "$previousCommit" \
  --repo "$mainPath";
then
  echo "Deploying skills..."
  "$mainPath/tools/ai/claude/deploy"
fi

# Rebuild prose (Vale packages) if any prose source files changed
if git-file-has-changed \
  tools/prose/vale/src/ \
  --from "$previousCommit" \
  --repo "$mainPath";
then
  echo "Building prose..."
  OROSHI_ROOT="$mainPath" prose-build
fi
