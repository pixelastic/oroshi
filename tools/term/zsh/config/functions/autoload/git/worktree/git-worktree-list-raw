# List all linked worktrees: branch▮path▮dirtyCount▮ahead▮behind▮relativeDate▮message
# Excludes the Git Repo Main
# Usage:
# $ git-worktree-list-raw          # fix/bug▮/path▮0▮2▮0▮3mn▮fix typo
# $ git-worktree-list-raw --reply  # write to $REPLY, no echo

setopt local_options err_return

local flagReply=()
zparseopts -E -D \
  -reply=flagReply

local porcelain="$(git worktree list --porcelain 2>/dev/null)"
[[ "$porcelain" == "" ]] && return 1

# First pass: collect branch▮path pairs from porcelain output
local worktreeData=()
local worktreePath=""
local branch=""
local isFirst=true
for line in "${(@f)porcelain}"; do
  if [[ "$line" == worktree\ * ]]; then
    worktreePath="${line#worktree }"
    branch=""
    continue
  fi

  if [[ "$line" == branch\ * ]]; then
    branch="${line#branch refs/heads/}"
    continue
  fi

  # Detached HEAD: use branch from active rebase, or fall back to "HEAD"
  if [[ "$line" == "detached" ]]; then
    local rawInfo="$(git-rebase-info-raw "$worktreePath" 2>/dev/null)"
    if [[ "$rawInfo" != "" ]]; then
      local headName="${${(@s/▮/)rawInfo}[3]}"
      branch="${headName:11}"
    else
      branch="HEAD"
    fi
    continue
  fi

  # Non-empty line that's not worktree/branch/detached (e.g. HEAD sha) — skip
  [[ "$line" != "" ]] && continue

  # Blank line = end of block; skip the Git Repo Main (first block)
  if [[ "$isFirst" == true ]]; then
    isFirst=false
    branch=""
    continue
  fi

  worktreeData+=("$branch▮$worktreePath")
  branch=""
done

# Flush last block (no trailing blank line after $() strips newlines)
[[ "$isFirst" == false && "$branch" != "" ]] && worktreeData+=("$branch▮$worktreePath")

# Second pass: enrich each entry with distance, date, message
local -a resultLines=()
for entry in "${worktreeData[@]}"; do
  local entryBranch="${entry%%▮*}"
  local entryPath="${entry#*▮}"

  # Dirty file count for this worktree
  git-directory-dirty-count --reply "$entryPath"
  local dirtyCount="$REPLY"

  # Ahead/behind vs main via git-worktree-distance-raw
  local rawDistance="$(git-worktree-distance-raw --branch "$entryBranch" 2>/dev/null)"
  local ahead="${rawDistance%%▮*}"
  local behind="${rawDistance##*▮}"
  [[ "$ahead" == "" ]] && ahead=0
  [[ "$behind" == "" ]] && behind=0

  # Relative date and commit message
  local logInfo="$(git log -1 --format="%ar▮%s" "$entryBranch" 2>/dev/null)"
  local relativeDate="${logInfo%%▮*}"
  local message="${logInfo#*▮}"

  resultLines+=("$entryBranch▮$entryPath▮$dirtyCount▮$ahead▮$behind▮$relativeDate▮$message")
done

if [[ ${#flagReply} == "1" ]]; then
  REPLY="${(F)resultLines}"
else
  for resultLine in "${resultLines[@]}"; do
    echo "$resultLine"
  done
fi
