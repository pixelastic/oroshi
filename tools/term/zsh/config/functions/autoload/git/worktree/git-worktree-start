# Commit where this worktree's branch leaves main (merge-base with main)
# It follows a rebase onto main. Once the branch is merged into main, it fails
# Usage:
# $ git-worktree-start           # → a3c72604
# $ git-worktree-start /path/to/worktree
setopt local_options err_return

local worktreePath="${1:-$PWD}"
local branch="$(git-branch-current "$worktreePath")"

# Not in a git repo or detached HEAD
[[ "$branch" == "" || "$branch" == "HEAD" ]] && return 1

# Last commit shared with main
local forkPoint="$(git -C "$worktreePath" merge-base main "$branch")"
[[ "$forkPoint" == "" ]] && return 1

# No commits ahead of main
local distance="$(git -C "$worktreePath" rev-list --count "${forkPoint}..${branch}")"
[[ "$distance" == "0" ]] && return 1

echo "$forkPoint"
