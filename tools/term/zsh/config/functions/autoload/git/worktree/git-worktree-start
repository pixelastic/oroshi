# Commit where this worktree's branch was created (from the branch reflog)
# Works before and after merge into main
# Usage:
# $ git-worktree-start           # → a3c72604
# $ git-worktree-start /path/to/worktree
setopt local_options err_return

local worktreePath="${1:-$PWD}"
local branch="$(git-branch-current "$worktreePath")"

# Not in a git repo or detached HEAD
[[ "$branch" == "" || "$branch" == "HEAD" ]] && return 1

# Oldest reflog entry = commit the branch pointed to when created
local forkPoint="$(git -C "$worktreePath" reflog show "$branch" --format='%H' | tail -1)"

# No commits since branch creation
local distance="$(git -C "$worktreePath" rev-list --count "${forkPoint}..${branch}")"
[[ "$distance" == "0" ]] && return 1

echo "$forkPoint"
