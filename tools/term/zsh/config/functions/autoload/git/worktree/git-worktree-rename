# Rename a linked worktree's branch, directory, and external plan dir
# Usage:
# $ git-worktree-rename <new>           # rename current linked worktree
# $ git-worktree-rename <old> <new>     # rename named linked worktree
setopt local_options err_return

local oldBranch="$1"
local newBranch="$2"

# Stop if no arg
[[ $oldBranch == "" && $newBranch == "" ]] && return 1

# If only one branch given, we rename from the current one
if [[ $newBranch == "" ]]; then
  # Stop if not in a worktree
  ! git-directory-is-worktree && return 1

  oldBranch="$(git-branch-current)"
  newBranch="$1"
fi

local mainPath="$(git-worktree-main)"
local repoName="$(git-github-project-name)"
[[ "$repoName" == "" ]] && repoName="${${mainPath:t}##.#}"

local oldDir="$(git-worktree-path "$oldBranch")"
local newSlug="$(git-branch-slug "$newBranch")"
local newDir="${OROSHI_WORKTREES_DIR}/${repoName}--${newSlug}"

local oldPlanDir="$(plan-directory --project "$repoName" --branch "$oldBranch")"
local newPlanDir="$(plan-directory --project "$repoName" --branch "$newBranch")"

# Stop if oldBranch is not a worktree
[[ "$oldDir" == "" ]] && return 1

# Stop if newBranch already exists
git-branch-exists "$newBranch" && return 1

# Stop if newDir already exists
[[ -d "$newDir" ]] && return 1

# Stop if renaming the plan would overwrite an existing dir
[[ -d "$oldPlanDir" && -d "$newPlanDir" ]] && return 1

# Rename branch
git-branch-rename "$oldBranch" "$newBranch"

# Rename external plan dir
if [[ -d "$oldPlanDir" ]]; then
  mv "$oldPlanDir" "$newPlanDir"
fi

# Snapshot submodule paths before the move breaks cross-references
local submoduleLines=""
if git-directory-has-submodules "$oldDir"; then
  submoduleLines="$(git-submodule-list-raw "$oldDir")"
fi

# Move directory and update all git tracking
mv "$oldDir" "$newDir"
print "$newDir/.git" > "$mainPath/.git/worktrees/${oldDir:t}/gitdir"

# Fix submodule cross-references broken by the directory move
if [[ "$submoduleLines" != "" ]]; then
  local trackingDir="$mainPath/.git/worktrees/${oldDir:t}"

  local rawLine
  for rawLine in ${(f)submoduleLines}; do
    local -a rawParts=(${(@ps/▮/)rawLine})
    local subPath="$rawParts[1]"

    # Update submodule .git file to point to renamed worktree dir
    [[ -f "$newDir/$subPath/.git" ]] && \
      sed --in-place "s/${oldDir:t}/${newDir:t}/g" "$newDir/$subPath/.git"

    # Update module tracking config to point to renamed worktree dir
    [[ -f "$trackingDir/modules/$subPath/config" ]] && \
      sed --in-place "s/${oldDir:t}/${newDir:t}/g" "$trackingDir/modules/$subPath/config"
  done
fi

mv "$mainPath/.git/worktrees/${oldDir:t}" "$mainPath/.git/worktrees/${newDir:t}"
print "gitdir: $mainPath/.git/worktrees/${newDir:t}" > "$newDir/.git"
git -C "$mainPath" worktree prune

# Navigate to new directory if currently inside the old worktree
if [[ "$PWD" == "$oldDir"* ]]; then
  # If the shell loaded its functions from the old worktree, reload from the
  # new path before cd, so chpwd hooks can resolve autoloaded functions
  if [[ "$OROSHI_ROOT" == "$oldDir"* ]]; then
    export OROSHI_ROOT="$newDir"
    oroshi-reload-fpath "$OROSHI_ROOT"
    oroshi-reload-path "$OROSHI_ROOT"
  fi
  cd "$newDir"
fi
