# Remove a config value
# Usage:
# $ git-config-remove branch.main.remote  # Remove the value
setopt local_options err_return
local configName="$1"

if [[ "$configName" == '' ]]; then
  echo "✘ You must pass a config name"
  return 1
fi

# Only unset if already defined
if git-config-exists "$configName"; then
  git config --unset "$configName"
fi

