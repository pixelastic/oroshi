# Display the list of submodules
# Usage:
# $ git-submodule-list
setopt local_options err_return

local rawList="$(git-submodule-list-raw)"

# Nothing to display
[[ "$rawList" == "" ]] && return 0

local output=""
local rawLine
for rawLine in ${(f)rawList}; do
  local fields=(${(@ps/▮/)rawLine})
  local name=$fields[1]
  local hash=$fields[2]
  local branch=$fields[3]

  local row=""

  # Name
  row+="$(git-submodule-colorize "$name" --with-icon)▮"

  # Branch
  row+="$(git-branch-colorize "$branch" --with-icon)▮"

  # Commit
  row+="$(git-commit-colorize "$hash" --with-icon)▮"

  output+="$row\n"
done

# Output as columns
table $output
