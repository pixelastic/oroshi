# Machine-readable list of submodules: name▮hash▮branch
# Usage:
# $ git-submodule-list-raw            # current repo
# $ git-submodule-list-raw /path/to   # given repo
setopt local_options err_return

local targetDir="${1:-.}"

local rawList="$(git -C "$targetDir" submodule status)"
local gitRoot="$(git-directory-root "$targetDir")"

# No submodules
[[ "$rawList" == "" ]] && return 0

typeset -A submoduleData

local rawLine
local name
for rawLine in ${(f)rawList}; do
  local parts=(${(@s/ /)rawLine})
  local hash=${parts[1]:0:8}

  name=${parts[2]}
  name="$(path-relative ${gitRoot}/${name} $gitRoot)"

  local branch=${parts[3]}
  branch=${branch[2,-2]}

  submoduleData[$name]="${hash}▮${branch}"
done

local sortedNames="$(sort-filepaths ${(k)submoduleData})"

for name in ${(f)sortedNames}; do
  local data=$submoduleData[$name]
  local fields=(${(@ps/▮/)data})
  echo "${name}▮${fields[1]}▮${fields[2]}"
done
