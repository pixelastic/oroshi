# Delete an issue or pull request comment, and print its ID as JSON
# REST finds the comment without the ID of its issue or pull request. Stops with
# an error if the comment does not exist, or if GitHub refuses the deletion
# Usage:
# $ git-comment-delete 987654                         # Comment of the current repo
# $ git-comment-delete 987654 --repo pixelastic/imoen # Comment of another repo
# {"id"}
setopt local_options err_return pipe_fail

zparseopts -E -D \
  -repo:=flagRepo

local id="$1"
local repo="${flagRepo[2]}"

# Stop if no comment is targeted
if [[ "$id" == "" ]]; then
  print -u 2 "Give a comment ID"
  return 1
fi

# Stop if not in a GitHub repo, unless --repo targets another one
if [[ "$repo" == "" ]]; then
  git-directory-is-github || return 1
fi

# gh fills the placeholders from the current repo
local repoPath='repos/{owner}/{repo}'
[[ "$repo" != "" ]] && repoPath="repos/$repo"

# GitHub answers with no content, so gh prints nothing
gh api "$repoPath/issues/comments/$id" \
  --method DELETE

jq \
  --null-input \
  --argjson id "$id" \
  '{id: $id}'
