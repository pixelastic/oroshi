# Close an issue, and print its id and state as JSON
# The issue is closed as completed, unless --not-planned is given
# Usage:
# $ git-issue-close 42                 # Close as completed
# $ git-issue-close 42 --not-planned   # Close as not planned
# $ git-issue-close 42 --repo pixelastic/imoen
# {"id","state"}
setopt local_options err_return pipe_fail

zparseopts -E -D \
  -not-planned=flagNotPlanned \
  -repo:=flagRepo

local id="$1"
local repo="${flagRepo[2]}"

# Stop if not in a GitHub repo, unless --repo targets another one
if [[ "$repo" == "" ]]; then
  git-directory-is-github || return 1
fi

local ghArgs=()
[[ "$repo" != "" ]] && ghArgs+=(--repo "$repo")

local reason="completed"
(( ${#flagNotPlanned} > 0 )) && reason="not planned"

gh issue close "$id" \
  --reason "$reason" \
  "${ghArgs[@]}" \
  > /dev/null

gh issue view "$id" \
  --json number,state \
  "${ghArgs[@]}" \
  | jq '{id: .number, state: (.state | ascii_downcase)}'
