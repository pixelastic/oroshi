# Count how many open issues the current repo has
# Usage:
# $ git-issue-count
setopt local_options err_return

# Stop if not in a GitHub repo
git-directory-is-github || return 1

local project="$(git-github-project)"

gh api "search/issues?q=repo:${project}+type:issue+state:open&per_page=1" \
  --jq '.total_count'
