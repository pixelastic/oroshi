# Reopen a closed issue, and print its id and state as JSON
# Usage:
# $ git-issue-reopen 42
# $ git-issue-reopen 42 --repo pixelastic/imoen
# {"id","state"}
setopt local_options err_return pipe_fail

zparseopts -E -D \
  -repo:=flagRepo

local id="$1"
local repo="${flagRepo[2]}"

# Stop if not in a GitHub repo, unless --repo targets another one
if [[ "$repo" == "" ]]; then
  git-directory-is-github || return 1
fi

local ghArgs=()
[[ "$repo" != "" ]] && ghArgs+=(--repo "$repo")

gh issue reopen "$id" \
  "${ghArgs[@]}" \
  > /dev/null

gh issue view "$id" \
  --json number,state \
  "${ghArgs[@]}" \
  | jq '{id: .number, state: (.state | ascii_downcase)}'
