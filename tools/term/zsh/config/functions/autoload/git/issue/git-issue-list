# List the issues of a repo as a colored table, one row per issue
# For machine consumption, use git-issue-list-raw
# Takes the same flags as git-issue-list-raw
# Without --repo, it also refreshes the shared cache of the issue count
# Usage:
# $ git-issue-list                          # Open issues of the current repo
# $ git-issue-list "login bug"              # Free-text query
# $ git-issue-list --state closed           # open (default), closed or all
# $ git-issue-list --author renovate --label bug --limit 10
# $ git-issue-list --date-min 2026-01-01 --date-max 2026-02-01
# $ git-issue-list --repo pixelastic/imoen  # Another repo
setopt local_options err_return

colors-load-definitions

# Read --repo without consuming it, because the raw command needs it too
zparseopts -E -repo:=flagRepo
local repo="${flagRepo[2]}"

# Stop if not in a GitHub repo, unless --repo targets another one
if [[ "$repo" == "" ]]; then
  git-directory-is-github || return 1
fi

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawIssues="$($rawCommand "$@")"

# Update shared cache of issue count. It is per current project, so a
# different repo must not touch it
if [[ "$repo" == "" ]]; then
  local projectName="$(git-github-project)"
  local cacheDirectory="${OROSHI_FOLDER_STATE}/github/${projectName}"
  mkdir -p "$cacheDirectory"
  git-issue-count > "${cacheDirectory}/issues"
fi

# Nothing to display if there is no issue
[[ "$rawIssues" == "" ]] && return 1

local rows=()
for rawIssue in ${(f)rawIssues}; do
  local fields=("${(@ps/▮/)rawIssue}")

  # Color the number. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[git-issue-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
