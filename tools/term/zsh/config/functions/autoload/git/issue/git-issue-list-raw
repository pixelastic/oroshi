# List the issues of a repo, one per line, for machine consumption
# For human consumption, use git-issue-list
# Fields: number▮title▮state▮date▮author▮url▮labels
# state is open or closed. date is the creation date, in ISO 8601
# labels are joined with ▯, and the field is empty when there is no label
# Takes the same flags as git-issue-search, and prints nothing when nothing
# matches. It has no side effect: it does not refresh the count cache
# Usage:
# $ git-issue-list-raw                          # Open issues of the current repo
# $ git-issue-list-raw "login bug"              # Free-text query
# $ git-issue-list-raw --state closed           # open (default), closed or all
# $ git-issue-list-raw --author renovate --label bug --limit 10
# $ git-issue-list-raw --date-min 2026-01-01 --date-max 2026-02-01
# $ git-issue-list-raw --repo pixelastic/imoen  # Another repo
setopt local_options err_return

git-issue-search "$@" \
  | jq \
  --raw-output \
'
    .[]
    | [
        .number,
        .title,
        .state,
        .date,
        .author,
        .url,
        (.labels | join("▯"))
      ]
    | map(tostring)
    | join("▮")
  '
