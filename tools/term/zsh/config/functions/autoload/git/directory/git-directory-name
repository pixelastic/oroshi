# Returns the best human-readable name for a git repository
# Fallback chain: project-name → git-github-project-name → directory basename
# Usage:
# $ git-directory-name            # Name of current repo
# $ git-directory-name /path/to   # Name of repo at path
setopt local_options err_return extendedglob

local targetPath="${1:-$PWD}"
local repoRoot="$(git-worktree-main "$targetPath")"
local projectName="$(project-name "$targetPath")"

# Directory isn't a git repo, so the name is the project key
# Note: if no project key, then it returns an empty string, and it's ok
if [[ "$repoRoot" == "" ]]; then
  echo "$projectName"
  return 0
fi

# If it's a known project, and its path matches the git repo root, then return
# the project name
if [[ "$projectName" != "" ]]; then
  local projectPath="$(project-path "$projectName")"
  if [[ "${projectPath}" == "${repoRoot}" ]]; then
    echo "$projectName"
    return 0
  fi
  # If the project path is not the same as the git repo root, it's probably
  # because we are in a catch-all project, like / or ~, so we move to the next
  # fallback
fi

# GitHub remote name
local githubName="$(git-github-project-name "$targetPath")"
if [[ "$githubName" != "" ]]; then
  echo "$githubName"
  return 0
fi

# Directory basename with leading dots stripped (main repo, not worktree)
local basename="${repoRoot:t}"
echo "${basename##.#}"
