# Check if a directory is dirty, ie. contains at least one modified,
# deleted or new file.
# Usage:
# $ git-directory-is-dirty         # Current directory
# $ git-directory-is-dirty /path   # Given path
setopt local_options err_return

local targetPath="${1:-.}"

git -C "$targetPath" status \
  --porcelain \
  --short \
  -unormal \
  | is-empty \
  && return 1 \
  || return 0
