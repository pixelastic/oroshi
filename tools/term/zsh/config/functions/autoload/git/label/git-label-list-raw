# List the labels of a repo, one per line, for machine consumption
# For human consumption, use git-label-list
# Fields: name▮color▮description
# color is a #rrggbb hex. description is empty when the label has none
# The internal label ID is not printed. Prints nothing when there is no label
# Usage:
# $ git-label-list-raw                          # Labels of the current repo
# $ git-label-list-raw --repo pixelastic/imoen  # Another repo
setopt local_options err_return pipe_fail

zparseopts -E -D \
  -repo:=flagRepo

local repo="${flagRepo[2]}"

# Stop if not in a GitHub repo, unless --repo targets another one
if [[ "$repo" == "" ]]; then
  git-directory-is-github || return 1
fi

local ghArgs=()
[[ "$repo" != "" ]] && ghArgs+=(--repo "$repo")

gh label list \
  --json name,color,description \
  --limit 1000 \
  "${ghArgs[@]}" \
  | jq \
  --raw-output \
'
    .[]
    | [
        .name,
        "#" + .color,
        .description
      ]
    | join("▮")
  '
