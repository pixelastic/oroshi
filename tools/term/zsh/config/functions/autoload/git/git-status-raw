# Normalize git status --porcelain into filepath▮STATUS format
# Usage:
# $ git-status-raw          # current repo
# $ git-status-raw /path    # repo at given path
setopt local_options err_return

local targetPath="${1:-$(git-directory-root)}"
local rawOutput="$(git -C "${targetPath}" -c core.quotePath=false status --porcelain --short)"

# Nothing to report if clean
[[ "$rawOutput" == "" ]] && return 0

for line in ${(f)rawOutput}; do
  local stagedStatus="${line[1]}"
  local workTreeStatus="${line[2]}"
  local filePath="${line:3}"

  # Strip quotes git adds around paths with spaces
  filePath="${filePath#\"}"
  filePath="${filePath%\"}"

  # ?? means untracked — normalize to staged=" " worktree="A"
  [[ "$stagedStatus" == "?" ]] && stagedStatus=" "
  [[ "$workTreeStatus" == "?" ]] && workTreeStatus="A"

  # Prefer work-tree status (more recent) over index status
  local gitStatus="$workTreeStatus"
  [[ "$gitStatus" == " " ]] && gitStatus="$stagedStatus"

  # Renames: git outputs "old -> new" — output new-path▮R▮old-path
  if [[ "$filePath" == *" -> "* ]]; then
    local oldPath="${filePath%% -> *}"
    local newPath="${filePath##* -> }"
    echo "${newPath}▮${gitStatus}▮${oldPath}"
    continue
  fi

  echo "${filePath}▮${gitStatus}"
done
