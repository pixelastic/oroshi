# Return the string color of a specific remote
# Usage:
# $ git-remote-color             # (current remote) blue
# $ git-remote-color upstream    # blue
setopt local_options err_return

colors-load-definitions

# Remote name
local remoteName="$1"
if [[ $remoteName == '' ]]; then
  remoteName="$(git-remote-current)"
fi

# Known remote color, or default
local remoteColor=$COLORS[git-remote-${remoteName}]
if [[ $remoteColor != '' ]]; then
  echo $remoteColor
  return
fi
echo $COLORS[git-remote]
