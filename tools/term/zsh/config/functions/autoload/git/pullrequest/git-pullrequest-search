# Search the pull requests of a repo and print them as a JSON array
# Usage:
# $ git-pullrequest-search                          # Open pull requests of the current repo
# $ git-pullrequest-search "login bug"              # Free-text query
# $ git-pullrequest-search --state merged           # open (default), draft, closed, merged or all
# $ git-pullrequest-search --author renovate --label bug --limit 10  # 25 by default
# $ git-pullrequest-search --date-min 2026-01-01 --date-max 2026-02-01
# $ git-pullrequest-search --repo pixelastic/imoen  # Another repo
# [{"id","title","state","date","author","url","labels","body","head","base","checks"}]
# state is draft, open, closed or merged. checks is success, failure, pending or empty.
setopt local_options err_return pipe_fail

DEFAULT_LIMIT=25

source "${functions_source[$0]:A:h:h}/github/__lib/search-args.zsh"

zparseopts -E -D \
  -state:=flagState \
  -author:=flagAuthor \
  -label:=flagLabel \
  -date-min:=flagDateMin \
  -date-max:=flagDateMax \
  -limit:=flagLimit \
  -repo:=flagRepo

local state="${flagState[2]}"
local author="${flagAuthor[2]}"
local label="${flagLabel[2]}"
local dateMin="${flagDateMin[2]}"
local dateMax="${flagDateMax[2]}"
local limit="${flagLimit[2]:-$DEFAULT_LIMIT}"
local repo="${flagRepo[2]}"
local query="$1"

# Stop if not in a GitHub repo, unless --repo targets another one
if [[ "$repo" == "" ]]; then
  git-directory-is-github || return 1
fi

# gh has no draft state, it is an open pull request with the --draft flag
local isDraftSearch=false
if [[ "$state" == "draft" ]]; then
  isDraftSearch=true
  state="open"
fi

# An open pull request is not a draft, GitHub search tells them apart
[[ "$isDraftSearch" == false && ("$state" == "open" || "$state" == "") ]] && query="${query:+$query }draft:false"

git-github-search-args \
  --state "$state" \
  --date-min "$dateMin" \
  --date-max "$dateMax" \
  --repo "$repo" \
  --query "$query"

local ghArgs=("${reply[@]}" --limit "$limit")
[[ "$author" != "" ]] && ghArgs+=(--author "$author")
[[ "$label" != "" ]] && ghArgs+=(--label "$label")
[[ "$isDraftSearch" == true ]] && ghArgs+=(--draft)

local fields=(
  number title state isDraft createdAt author url labels body
  headRefName baseRefName statusCheckRollup
)

gh pr list \
  --json "${(j:,:)fields}" \
  "${ghArgs[@]}" \
| jq '
    # A check run has status and conclusion, a status context has a state
    def verdict:
      if (.state // "") != "" then
        if .state == "SUCCESS" then "success"
        elif (.state == "PENDING" or .state == "EXPECTED") then "pending"
        else "failure"
        end
      elif (.status // "COMPLETED") != "COMPLETED" then "pending"
      elif (.conclusion | IN("SUCCESS", "NEUTRAL", "SKIPPED")) then "success"
      else "failure"
      end;

    def rollup:
      map(verdict) as $verdicts
      | if ($verdicts | length) == 0 then ""
        elif ($verdicts | index("failure")) != null then "failure"
        elif ($verdicts | index("pending")) != null then "pending"
        else "success"
        end;

    map({
      id: .number,
      title,
      state: (if .isDraft then "draft" else (.state | ascii_downcase) end),
      date: .createdAt,
      author: .author.login,
      url,
      labels: [.labels[].name],
      body,
      head: .headRefName,
      base: .baseRefName,
      checks: ((.statusCheckRollup // []) | rollup)
    })
  '
