# Close a pull request without merging it, and print its id and state as JSON
# Usage:
# $ git-pullrequest-close 42
# $ git-pullrequest-close 42 --repo pixelastic/imoen
# {"id","state"}
setopt local_options err_return pipe_fail

zparseopts -E -D \
  -repo:=flagRepo

local id="$1"
local repo="${flagRepo[2]}"

# Stop if not in a GitHub repo, unless --repo targets another one
if [[ "$repo" == "" ]]; then
  git-directory-is-github || return 1
fi

local ghArgs=()
[[ "$repo" != "" ]] && ghArgs+=(--repo "$repo")

gh pr close "$id" \
  "${ghArgs[@]}" \
  > /dev/null

gh pr view "$id" \
  --json number,state \
  "${ghArgs[@]}" \
  | jq '{id: .number, state: (.state | ascii_downcase)}'
