# Open PRs in the browser
# Usage:
# $ git-pullrequest-open                              # Opens PR page
# $ git-pullrequest-open 42                           # Opens PR 42
# $ git-pullrequest-open 42 --repo pixelastic/imoen   # Opens PR 42 of another repo
setopt local_options err_return

zparseopts -E -D \
  -repo:=flagRepo

local id="$1"
local repo="${flagRepo[2]}"
local openedUrl

# Stop if not in a GitHub repo, unless --repo targets another one
if [[ "$repo" == "" ]]; then
  git-directory-is-github || return 1
  openedUrl="$(git-directory-url)"
else
  openedUrl="https://github.com/${repo}"
fi

# Open a specific PR or the full list
if [[ $id != "" ]]; then
  openedUrl="${openedUrl}/pull/${id}"
else
  openedUrl="${openedUrl}/pulls"
fi

$BROWSER "$openedUrl" &>/dev/null
