# List all pull requests of current repo
# Usage:
# $ git-pullrequest-list
setopt local_options err_return

# Stop if not in a GitHub repo
git-directory-is-github || return 1

gh pr list

# Update shared cache of PR count
local projectName="$(git-github-project)"
local cacheDirectory="${OROSHI_TMP_FOLDER}/github/${projectName}"
mkdir -p "$cacheDirectory"
git-pullrequest-count > "${cacheDirectory}/pullrequests"
