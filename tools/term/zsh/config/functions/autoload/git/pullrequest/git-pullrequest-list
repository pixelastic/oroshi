# List the pull requests of a repo as a colored table, one row per pull request
# For machine consumption, use git-pullrequest-list-raw
# Takes the same flags as git-pullrequest-list-raw
# Without --repo, it also refreshes the shared cache of the pull request count
# Usage:
# $ git-pullrequest-list                          # Open pull requests of the current repo
# $ git-pullrequest-list "login bug"              # Free-text query
# $ git-pullrequest-list --state merged           # open (default), draft, closed, merged or all
# $ git-pullrequest-list --author renovate --label bug --limit 10
# $ git-pullrequest-list --date-min 2026-01-01 --date-max 2026-02-01
# $ git-pullrequest-list --repo pixelastic/imoen  # Another repo
setopt local_options err_return

# Read --repo without consuming it, because the raw command needs it too
zparseopts -E -repo:=flagRepo
local repo="${flagRepo[2]}"

colors-load-definitions

# Stop if not in a GitHub repo, unless --repo targets another one
if [[ "$repo" == "" ]]; then
  git-directory-is-github || return 1
fi

# The raw command is named like this wrapper, with a -raw suffix
local rawCommand="${0}-raw"

local rawPullrequests="$($rawCommand "$@")"

# Update shared cache of pull request count. It is per current project, so a
# different repo must not touch it
if [[ "$repo" == "" ]]; then
  local projectName="$(git-github-project)"
  local cacheDirectory="${OROSHI_FOLDER_STATE}/github/${projectName}"
  mkdir -p "$cacheDirectory"
  git-pullrequest-count > "${cacheDirectory}/pullrequests"
fi

# Nothing to display if there is no pull request
[[ "$rawPullrequests" == "" ]] && return 1

local rows=()
for rawPullrequest in ${(f)rawPullrequests}; do
  local fields=("${(@ps/▮/)rawPullrequest}")

  # Color the id. Keep the other columns as they are, and
  # show their multi-values with commas
  local columns=("$(colorize "${fields[1]}" $COLORS[git-pullrequest-id])")
  columns+=("${(@)fields[2,-1]//▯/, }")

  rows+=("${(j:▮:)columns}")
done

# One row per line, separated by real newlines. `table` splits the columns on ▮
table "${(F)rows}"
