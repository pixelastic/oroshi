# Print the subject line of the last commit on a branch
# Usage:
# $ git-branch-last-subject              # current branch
# $ git-branch-last-subject main         # named branch
# $ git-branch-last-subject --repo /path # current branch in given repo
# $ git-branch-last-subject main --repo /path
# $ git-branch-last-subject --reply main # write to $REPLY, no echo
setopt local_options err_return

local flagReply=()
zparseopts -E -D \
  -repo:=flagRepo \
  -reply=flagReply

local branch="$1"
local repoPath="${flagRepo[2]}"

local repoArgs=()
if [[ "$repoPath" != "" ]]; then
  repoArgs=("-C" "$repoPath")
fi

[[ "$branch" == "" ]] && branch="HEAD"

# Not in a git repo
git-directory-is-repository "${repoPath:-.}" || return 1

local result="$(git "${repoArgs[@]}" log -1 --format="%s" "$branch" 2>/dev/null)"

if [[ ${#flagReply} == "1" ]]; then
  REPLY="$result"
  return
fi
echo "$result"
