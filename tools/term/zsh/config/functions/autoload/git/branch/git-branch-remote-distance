# Count how many commits the branch is ahead/behind of its remote counterpart
# Usage:
# $ git-branch-remote-distance             # current branch in current repo
# $ git-branch-remote-distance main        # specified branch in current repo
# $ git-branch-remote-distance --repo /p   # current branch in specified repo
# $ git-branch-remote-distance --repo /p main
# Output: "ahead N, behind M"
setopt local_options err_return

local rawDistance="$(git-branch-remote-distance-raw "$@")"
local fields=(${(@ps/▮/)rawDistance})

echo "ahead ${fields[1]}, behind ${fields[2]}"
