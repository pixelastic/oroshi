# Push a branch
# Usage:
# $ git-branch-push                  # Pushes current branch to current remote
# $ git-branch-push main             # Pushes branch main
# $ git-branch-push main origin      # Pushes branch main to remote origin
# $ git-branch-push --force          # Also pass in flags
# $ git-branch-push --repo /path     # Pushes from given repo
setopt local_options err_return

zparseopts -E -D \
  -repo:=flagRepo

local repoPath="${flagRepo[2]}"

# Filter positional arguments and flags
local positionalArgs=()
local -A flagArgs=()
for arg in $argv; do
  [[ "$arg" =~ "^-" ]] && flagArgs[$arg]=1 || positionalArgs+=("$arg")
done

# Default to current branch if none is passed
local branchName="$positionalArgs[1]"
[[ "$branchName" == "" ]] && branchName="$(git-branch-current "$repoPath")"

# Default to current remote if none is passed
local remoteName="$positionalArgs[2]"
[[ "$remoteName" == "" ]] && remoteName="$(git-remote-current "$repoPath")"

# Target a specific repo if --repo was passed
local repoArgs=()
[[ "$repoPath" != "" ]] && repoArgs=("-C" "$repoPath")

git ${repoArgs[@]} push \
  --set-upstream "$remoteName" \
  "$branchName" \
  ${(k)flagArgs}
