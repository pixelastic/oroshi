# Update ruby dependencies if they changed since the specified commit
# Usage:
# $ git-dependencies-update-ruby d34db33f
# $ git-dependencies-update-ruby d34db33f --repo /path/to/repo
# $ git-dependencies-update-ruby --repo /path/to/repo
setopt local_options err_return

zparseopts -E -D \
  -repo:=flagRepo \
  -async=flagAsync

# Default to current repo when --repo is not provided
local repoPath="${flagRepo[2]:-$(git-directory-root)}"
local originCommit="$1"

local gitRoot="$(git-directory-root "$repoPath")"
local beaconPatterns=("${gitRoot}/Gemfile" "${gitRoot}/*.gemspec")
local lockfilePath="$(git-dependencies-in-progress-lockfile ruby --repo "$repoPath")"
local updateCommand="cd ${gitRoot} && bundle install"

# Resolve glob patterns to existing beacon files
local beaconFilepaths=()
for beaconPattern in $beaconPatterns; do
  for match in $(glob $beaconPattern); do
    [[ -f "$match" ]] && beaconFilepaths+=("$match")
  done
done

# No beacon files in this repo
[[ ${#beaconFilepaths} -eq 0 ]] && return 0

# When a reference commit is provided, skip if no beacon file changed
if [[ "$originCommit" != "" ]]; then
  # Stop if no file changed
  ! git-file-has-changed "${beaconFilepaths[@]}" \
    --from "$originCommit" \
    --repo "$repoPath" \
    && return 0
fi

# Either update deps right now, or in the background
if [[ "$flagAsync" != "" ]]; then
  # Update dependencies and write a lockfile while doing it
  fork "$updateCommand" "$lockfilePath"
  return
fi

eval "$updateCommand"
