# Update project dependencies if changed since specified commit
# Should be run when switching branches
#
# Usage:
# $ git-dependencies-update d34db33f
# $ git-dependencies-update d34db33f --repo /path/to/repo
# $ git-dependencies-update --repo /path/to/repo
setopt local_options err_return

zparseopts -E -D \
  -repo:=flagRepo

# Default to current repo when --repo is not provided
local repoPath="${flagRepo[2]:-$(git-directory-root)}"
local originCommit="$1"

git-submodule-update-all "$repoPath"

git-dependencies-update-node "$originCommit" --repo "$repoPath"
git-dependencies-update-ruby "$originCommit" --repo "$repoPath"

return 0
