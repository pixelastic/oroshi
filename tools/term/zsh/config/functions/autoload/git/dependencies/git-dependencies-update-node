# Update node dependencies if they changed since the specified commit
# Usage:
# $ git-dependencies-update-node d34db33f
# $ git-dependencies-update-node d34db33f --repo /path/to/repo
# $ git-dependencies-update-node --repo /path/to/repo
setopt local_options err_return

zparseopts -E -D \
  -repo:=flagRepo \
  -async=flagAsync

# Default to current repo when --repo is not provided
local repoPath="${flagRepo[2]:-$(git-directory-root)}"
local originCommit="$1"

local gitRoot="$(git-directory-root "$repoPath")"
local beaconFilepath="${gitRoot}/yarn.lock"
local lockfilePath="$(git-dependencies-in-progress-lockfile node --repo "$repoPath")"
local updateCommand="cd ${gitRoot} && yarn install"

# No beacon file in this repo
[[ ! -f "$beaconFilepath" ]] && return 0

# Beacon file didn't change since the commit
if [[ "$originCommit" != "" ]] && ! git-file-has-changed "$beaconFilepath" "$originCommit" --repo "$repoPath"; then
  return 0
fi

# Either update deps right now, or in the background
if [[ "$flagAsync" != "" ]]; then
  # Update dependencies and write a lockfile while doing it
  fork "$updateCommand" "$lockfilePath"
else
  eval "$updateCommand"
fi
