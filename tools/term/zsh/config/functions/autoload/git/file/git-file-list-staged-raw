# List all staged files
# Output format: filepath▮STATUS
# STATUS can be: M (Modified), A (Added), D (Deleted)
# Usage:
# $ git-file-list-staged-raw
setopt local_options err_return

local rawOutput="$(git-status-raw)"

# Nothing to report if clean
[[ "$rawOutput" == "" ]] && return 0

for line in ${(f)rawOutput}; do
  local fields=(${(@ps/▮/)line})
  local filePath=$fields[1]
  local stagedStatus=$fields[2]

  # Skip untracked and unstaged-only files
  [[ "$stagedStatus" == " " ]] && continue

  echo "${filePath}▮${stagedStatus}"
done
