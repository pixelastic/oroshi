# List all dirty files (modified, added, or deleted since last commit)
# Output format: filepath▮STATUS (renames: filepath▮STATUS▮oldpath)
# STATUS can be: M (Modified), A (Added), D (Deleted), R (Renamed)
# Usage:
# $ git-file-list-dirty-raw                        # current directory
# $ git-file-list-dirty-raw /path                  # from given path
# $ git-file-list-dirty-raw --include-submodules   # include submodule dirty files
setopt local_options err_return

zparseopts -E -D \
  -include-submodules=flagIncludeSubmodules

local includeSubmodules=${#flagIncludeSubmodules}
local targetPath="${1:-.}"
local gitRoot="$(git-directory-root "$targetPath")"

local rawOutput="$(git-status-raw "$targetPath")"

# Collect dirty files from submodules, prefixed with submodule relative path
if [[ $includeSubmodules == 1 ]]; then
  local submoduleList="$(git-submodule-list-raw "$targetPath" 2>/dev/null)"

  for submoduleLine in ${(f)submoduleList}; do
    local submoduleParts=(${(@ps/▮/)submoduleLine})
    local submodulePath=$submoduleParts[1]

    local submoduleDirtyFiles="$(git-file-list-dirty-raw "${gitRoot}/${submodulePath}" 2>/dev/null)"
    for submoduleDirtyLine in ${(f)submoduleDirtyFiles}; do
      local submoduleFields=(${(@ps/▮/)submoduleDirtyLine})
      local prefixedPath="${submodulePath}/${submoduleFields[1]}"
      local submoduleStatus=$submoduleFields[2]

      local submoduleOutput="${prefixedPath}▮${submoduleStatus}"
      # Append prefixed old path for renames
      [[ "$submoduleFields[3]" != "" ]] && submoduleOutput+="▮${submodulePath}/${submoduleFields[3]}"
      echo "$submoduleOutput"
    done
  done
fi

# Nothing to report if clean
[[ "$rawOutput" == "" ]] && return 0

for line in ${(f)rawOutput}; do
  local fields=(${(@ps/▮/)line})
  local filePath=$fields[1]
  local stagedStatus=$fields[2]
  local workTreeStatus=$fields[3]

  # Prefer work-tree status (more recent) over index status
  local gitStatus="$workTreeStatus"
  [[ "$gitStatus" == " " ]] && gitStatus="$stagedStatus"

  # Renames: 4th field is old path
  if [[ "$fields[4]" != "" ]]; then
    echo "${filePath}▮${gitStatus}▮${fields[4]}"
    continue
  fi

  echo "${filePath}▮${gitStatus}"
done
