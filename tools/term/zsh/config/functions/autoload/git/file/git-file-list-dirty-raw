# List all dirty files (modified, added, or deleted since last commit)
# Output format: filepath▮STATUS (renames: filepath▮STATUS▮oldpath)
# STATUS can be: M (Modified), A (Added), D (Deleted), R (Renamed)
# Usage:
# $ git-file-list-dirty-raw           # current directory
# $ git-file-list-dirty-raw /path     # from given path
setopt local_options err_return

local rawOutput="$(git-status-raw "$@")"

# Nothing to report if clean
[[ "$rawOutput" == "" ]] && return 0

for line in ${(f)rawOutput}; do
  local fields=(${(@ps/▮/)line})
  local filePath=$fields[1]
  local stagedStatus=$fields[2]
  local workTreeStatus=$fields[3]

  # Prefer work-tree status (more recent) over index status
  local gitStatus="$workTreeStatus"
  [[ "$gitStatus" == " " ]] && gitStatus="$stagedStatus"

  # Renames: 4th field is old path
  if [[ "$fields[4]" != "" ]]; then
    echo "${filePath}▮${gitStatus}▮${fields[4]}"
    continue
  fi

  echo "${filePath}▮${gitStatus}"
done
