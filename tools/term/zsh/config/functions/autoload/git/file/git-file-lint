# Lint all dirty ZSH, BATS, JS, Python, Go, JSON and XML files in the working tree, grouped by type
# Usage:
# $ git-file-lint
setopt local_options err_return

local gitRoot="$(git-directory-root)"
local rawFiles="$(git-file-list-dirty-raw)"

# Nothing to lint if working tree is clean
[[ "$rawFiles" == "" ]] && return 0

local -A results=(
  bats-files ""
  go-files ""
  js-files ""
  json-files ""
  python-files ""
  xml-files ""
  zsh-files ""
)
for rawLine in ${(f)rawFiles}; do
  local splitLine=(${(@ps/▮/)rawLine})
  local filepath=$splitLine[1]
  local gitStatus=$splitLine[2]
  local fullPath="${gitRoot}/${filepath}"

  # Skip deleted files
  [[ "$gitStatus" == "D" ]] && continue

  if is-zsh "$fullPath"; then
    results[zsh-files]+="${fullPath} "
    continue
  fi

  if is-bats "$fullPath"; then
    results[bats-files]+="${fullPath} "
    continue
  fi

  if is-js "$fullPath"; then
    results[js-files]+="${fullPath} "
    continue
  fi

  if is-python "$fullPath"; then
    results[python-files]+="${fullPath} "
    continue
  fi

  if is-go "$fullPath"; then
    results[go-files]+="${fullPath} "
    continue
  fi

  if is-json "$fullPath"; then
    results[json-files]+="${fullPath} "
    continue
  fi

  if is-xml "$fullPath"; then
    results[xml-files]+="${fullPath} "
    continue
  fi
done

local hasViolations="0"

# Display lint errors from JSON output (zsh-lint, bats-lint, go-lint)
function displayLintJson() {
  zparseopts -E -D -header:=flagHeader
  local header=$flagHeader[2]
  local output="$1"

  [[ "$output" == "[]" ]] && return 0

  hasViolations="1"
  echo "── ${header} ──"
  printf '%s\n' "$output" \
    | jq \
    --raw-output \
    --arg root "$gitRoot" \
    '.[] | "\(.file | ltrimstr($root + "/")):\(.line):\(.column): \(.code): \(.message)"'
}

# Display lint errors from plain text output (aberlaas, python-lint)
function displayLintText() {
  zparseopts -E -D -header:=flagHeader
  local header=$flagHeader[2]
  local output="$1"

  [[ "$output" == "" ]] && return 0

  hasViolations="1"
  echo "── ${header} ──"
  printf '%s\n' "$output"
}

if [[ "$results[zsh-files]" != "" ]]; then
  displayLintJson --header "ZSH" "$(zsh-lint --fix ${=results[zsh-files]})"
fi

if [[ "$results[bats-files]" != "" ]]; then
  displayLintJson --header "BATS" "$(bats-lint ${=results[bats-files]})"
fi

if [[ "$results[js-files]" != "" ]]; then
  displayLintText --header "JS" "$(yarn run lint:fix --js ${=results[js-files]})"
fi

if [[ "$results[python-files]" != "" ]]; then
  displayLintText --header "Python" "$(python-lint --fix ${=results[python-files]})"
fi

if [[ "$results[go-files]" != "" ]]; then
  displayLintText --header "Go" "$(go-lint --fix ${=results[go-files]})"
fi

if [[ "$results[json-files]" != "" ]]; then
  displayLintText --header "JSON" "$(json-lint --fix ${=results[json-files]})"
fi

if [[ "$results[xml-files]" != "" ]]; then
  displayLintText --header "XML" "$(xml-lint --fix ${=results[xml-files]})"
fi

# Exit non-zero if any group had violations
[[ $hasViolations == "1" ]] && return 1
return 0
