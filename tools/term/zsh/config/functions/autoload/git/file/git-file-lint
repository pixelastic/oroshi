# Lint all dirty ZSH, BATS, JS, Python, Go, JSON, SVG and XML files in the working tree, grouped by type
# Prints "✔ All files are clean" when no violations remain.
# Usage:
# $ git-file-lint
setopt local_options err_return

SUCCESS_MESSAGE="✔ All files are clean"

local gitRoot="$(git-directory-root)"
local rawFiles="$(git-file-list-dirty-raw)"

# Nothing to lint if working tree is clean
if [[ "$rawFiles" == "" ]]; then
  echo "$SUCCESS_MESSAGE"
  return 0
fi

local -A results=(
  bats-files ""
  go-files ""
  js-files ""
  json-files ""
  python-files ""
  svg-files ""
  toml-files ""
  xml-files ""
  zsh-files ""
)
for rawLine in ${(f)rawFiles}; do
  local splitLine=(${(@ps/▮/)rawLine})
  local filepath=$splitLine[1]
  local gitStatus=$splitLine[2]
  local fullPath="${gitRoot}/${filepath}"

  # Skip deleted files
  [[ "$gitStatus" == "D" ]] && continue

  if is-zsh "$fullPath"; then
    results[zsh-files]+="${fullPath} "
    continue
  fi

  if is-bats "$fullPath"; then
    results[bats-files]+="${fullPath} "
    continue
  fi

  if is-js "$fullPath"; then
    results[js-files]+="${fullPath} "
    continue
  fi

  if is-python "$fullPath"; then
    results[python-files]+="${fullPath} "
    continue
  fi

  if is-go "$fullPath"; then
    results[go-files]+="${fullPath} "
    continue
  fi

  if is-json "$fullPath"; then
    results[json-files]+="${fullPath} "
    continue
  fi

  if is-svg "$fullPath"; then
    results[svg-files]+="${fullPath} "
    continue
  fi

  if is-toml "$fullPath"; then
    results[toml-files]+="${fullPath} "
    continue
  fi

  if is-xml "$fullPath"; then
    results[xml-files]+="${fullPath} "
    continue
  fi
done

local hasViolations="0"

# Run a linter and display its plain text output under a header
# A zero exit code means clean, whatever the output.
# Sets hasViolations when the linter exits non-zero.
# Prints "linter failed (exit N)" when it exits non-zero with no output.
# Usage: displayLint --header "JSON" -- json-lint --fix file.json
function displayLint() {
  zparseopts -E -D -header:=flagHeader
  local header=$flagHeader[2]

  # zparseopts -E keeps the "--" before the linter command
  [[ "$1" == "--" ]] && shift

  # Assign after declaring: `local` would mask the linter exit code
  local output=""
  local exitCode=0
  output="$("$@")" || exitCode=$?

  # Nothing to display if the linter passed
  [[ $exitCode == 0 ]] && return 0

  hasViolations="1"
  echo "── ${header} ──"

  # Linter failed without reporting any violation
  if [[ "$output" == "" ]]; then
    echo "linter failed (exit ${exitCode})"
    return 0
  fi

  printf '%s\n' "$output"
}

if [[ "$results[zsh-files]" != "" ]]; then
  displayLint --header "ZSH" -- zsh-lint --fix ${=results[zsh-files]}
fi

if [[ "$results[bats-files]" != "" ]]; then
  displayLint --header "BATS" -- bats-lint ${=results[bats-files]}
fi

if [[ "$results[js-files]" != "" ]]; then
  displayLint --header "JS" -- yarn run lint:fix --js ${=results[js-files]}
fi

if [[ "$results[python-files]" != "" ]]; then
  displayLint --header "Python" -- python-lint --fix ${=results[python-files]}
fi

if [[ "$results[go-files]" != "" ]]; then
  displayLint --header "Go" -- go-lint --fix ${=results[go-files]}
fi

if [[ "$results[json-files]" != "" ]]; then
  displayLint --header "JSON" -- json-lint --fix ${=results[json-files]}
fi

if [[ "$results[svg-files]" != "" ]]; then
  displayLint --header "SVG" -- svg-lint --fix ${=results[svg-files]}
fi

if [[ "$results[toml-files]" != "" ]]; then
  displayLint --header "TOML" -- toml-lint --fix ${=results[toml-files]}
fi

if [[ "$results[xml-files]" != "" ]]; then
  displayLint --header "XML" -- xml-lint --fix ${=results[xml-files]}
fi

# Exit non-zero if any group had violations
[[ $hasViolations == "1" ]] && return 1
echo "$SUCCESS_MESSAGE"
return 0
