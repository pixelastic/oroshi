# Check if file(s) changed, relative to commits
# Usage:
# $ git-file-has-changed package.json                                  # Working dir against last commit
# $ git-file-has-changed package.json yarn.lock                        # Multiple paths, any changed
# $ git-file-has-changed package.json --from abcdef                    # Since specific commit
# $ git-file-has-changed package.json --from abcdef --to d34db33f      # Between two commits
# $ git-file-has-changed package.json --repo /path/to/repo             # In a different repo
setopt local_options err_return

zparseopts -E -D \
  -repo:=flagRepo \
  -from:=flagFrom \
  -to:=flagTo

local repoPath="${flagRepo[2]}"
local commitFrom="${flagFrom[2]}"
local commitTo="${flagTo[2]}"
local paths=("$@")

local gitCmd=(git)
[[ "$repoPath" != "" ]] && gitCmd=(git -C "$repoPath")

# Build commit range: empty (working dir), open-ended, or bounded
local range=""
[[ "$commitFrom" != "" && "$commitTo" == "" ]] && range="${commitFrom}.."
[[ "$commitFrom" != "" && "$commitTo" != "" ]] && range="${commitFrom}..${commitTo}"

local diffArgs=("${gitCmd[@]}" diff --name-only)
[[ "$range" != "" ]] && diffArgs+=("$range")
diffArgs+=(-- "${paths[@]}")

local changed="$("${diffArgs[@]}")"
[[ "$changed" != "" ]] && return 0
return 1
