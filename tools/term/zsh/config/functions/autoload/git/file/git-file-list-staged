# List all staged files
setopt local_options err_return
local rawFiles="$(git-file-list-staged-raw)"

for rawLine in ${(f)rawFiles}; do
  local splitLine=(${(@ps/▮/)rawLine})
  local filepath=$splitLine[1]
  local gitStatus=$splitLine[2]

  local displayedLine=""
  [[ $gitStatus == "D" ]] && displayedLine="$(colorize "$filepath" git-removed)"
  [[ $gitStatus == "M" ]] && displayedLine="$(colorize "$filepath" git-modified)"
  [[ $gitStatus == "A" ]] && displayedLine="$(colorize "$filepath" git-added)"

  echo "$displayedLine"
done
