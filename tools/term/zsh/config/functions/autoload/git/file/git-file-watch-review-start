# Output simplified JSON of review comments (without commitHash)
# Usage:
# $ git-file-watch-review-start
setopt local_options err_return

local slug="$(context-slug)"
local commentsFile="${OROSHI_TMP_FOLDER}/git-file-watch/${slug}.json"

# No file or empty file
if ! [[ -s "$commentsFile" ]]; then
  echo "[]"
  return 0
fi

jq -c '[.[] | {id, filepath, lineNumber, lineContent, review}]' "$commentsFile"
