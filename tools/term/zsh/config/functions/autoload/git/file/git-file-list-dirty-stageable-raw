# List all stageable files (that can be added to the staging area)
# Output format: filepath▮STATUS
# STATUS can be: M (Modified), A (Added), D (Deleted)
# Usage:
# $ git-file-list-dirty-stageable-raw
setopt local_options err_return

local rawOutput="$(git-status-raw)"

# Nothing to report if clean
[[ "$rawOutput" == "" ]] && return 0

for line in ${(f)rawOutput}; do
  local fields=(${(@ps/▮/)line})
  local filePath=$fields[1]
  local workTreeStatus=$fields[3]

  # Skip files with clean work-tree (only staged)
  [[ "$workTreeStatus" == " " ]] && continue

  echo "${filePath}▮${workTreeStatus}"
done
