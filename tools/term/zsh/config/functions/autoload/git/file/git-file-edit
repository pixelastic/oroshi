# Open all modified files in nvim
# Usage:
# $ git-file-edit-modified
setopt local_options err_return

local gitRoot="$(git-directory-root)"
local rawFiles="$(git-file-list-dirty-raw)"

# Nothing to open if working tree is clean
[[ "$rawFiles" == "" ]] && return 0

filetypes-load-definitions
local allowedGroups=(text script config)

local fileList=()
for rawLine in ${(f)rawFiles}; do
  local splitLine=(${(@ps/▮/)rawLine})
  local filepath=$splitLine[1]
  local gitStatus=$splitLine[2]

  # Skip deleted files (can't open them)
  [[ "$gitStatus" == "D" ]] && continue

  # Skip if file no longer exists on disk (safety net for unexpected statuses)
  [[ ! -f "${gitRoot}/${filepath}" ]] && continue

  # Skip plan artifacts
  [[ "$filepath" == plans/*/state.json ]] && continue
  [[ "$filepath" == plans/*/scaffold/* ]] && continue

  # Skip files whose group is not in the allowlist (empty group = accepted)
  filetypes-group --reply "$filepath"
  local group="$REPLY"
  [[ "$group" != "" && ${allowedGroups[(Ie)$group]} -eq 0 ]] && continue

  fileList+=("${gitRoot}/${filepath}")
done

[[ ${#fileList} -eq 0 ]] && return 0

# Sort source files before their test files
typeset -A companionMap
typeset -A consumed
for file in "${fileList[@]}"; do
  local testFile="$(test-path "$file" 2>/dev/null || true)"

  # Skip files with no test companion
  [[ "$testFile" == "" ]] && continue

  # Skip test files that resolve to themselves (not a source file)
  [[ "$testFile" == "$file" ]] && continue

  # Skip if test file is not in the dirty list
  [[ ${fileList[(Ie)$testFile]} -eq 0 ]] && continue

  # Skip if test file was already claimed by another source
  [[ "${consumed[$testFile]}" == "1" ]] && continue

  companionMap[$file]="$testFile"
  consumed[$testFile]=1
done

local sortedList=()
for file in "${fileList[@]}"; do
  # Skip test files that will be pulled in after their source
  [[ "${consumed[$file]}" == "1" ]] && continue
  sortedList+=("$file")
  [[ "${companionMap[$file]}" != "" ]] && sortedList+=("${companionMap[$file]}")
done

nvim -p $sortedList
