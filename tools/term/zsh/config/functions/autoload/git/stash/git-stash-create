# Stash current files with optional message
# Usage:
# $ git-stash-create            # Stash with default message
# $ git-stash-create "WIP fix"  # Stash with custom message
setopt local_options err_return

local message=$1

local args=(stash push --include-untracked)
[[ "$message" != "" ]] && args+=(--message "$message")

git "${args[@]}"
