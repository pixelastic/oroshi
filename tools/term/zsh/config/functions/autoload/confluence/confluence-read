# Read a Confluence page by its url or id, output Markdown
# Usage:
# $ confluence-read 123456                                                   # Page 123456, as Markdown
# $ confluence-read https://example.atlassian.net/wiki/spaces/X/pages/123456 # Same, from a page url
setopt local_options err_return extended_glob

local input=$1

# A bare id passes through, a page url yields the digits after /pages/
local id=""
[[ "$input" =~ '^[0-9]+$' ]] && id=$input
[[ "$input" =~ '/pages/([0-9]+)(/|\?|#|$)' ]] && id=$match[1]

# Neither an id nor a page url
if [[ "$id" == "" ]]; then
  echoerr "Usage: confluence-read <url|id>"
  return 1
fi

local page="$(confluence-api "wiki/api/v2/pages/${id}?body-format=storage")"

# The API helper already printed the error
[[ "$page" == "" ]] && return 1

local converter="$(go-tool-path confluence-md)"

# Raw markdown content
local markdown="$(print -r -- "$page" | jq --raw-output '.body.storage.value' | "$converter" html)"

# We remove some useless HTML comments
local noisyComments=(
  'Table of Contents'
  'Unsupported macro: panel'
  'Unsupported macro: toc'
)
for comment in $noisyComments; do
  markdown=${markdown//"<!-- $comment -->"$'\n\n'/}
  markdown=${markdown//"<!-- $comment -->"/}
done

# Inline comment markers carry a variable id, so they need a pattern
markdown=${markdown//'<!-- comment-ref: '[0-9a-f-]##' -->'/}

print -r -- "$markdown"
