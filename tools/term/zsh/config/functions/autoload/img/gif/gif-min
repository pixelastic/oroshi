# Compress GIF files in-place using gifsicle
# Usage:
# $ gif-min ./path/to/file.gif
# $ gif-min ./*.gif
setopt local_options err_return

for input in "$@"; do
  local filepath="${input:a}"
  local before="$(stat --format=%s "$filepath")"
  # Bail if stat failed
  [[ "$before" == "" ]] && return 1

  gifsicle \
    --batch \
    --optimize=3 \
    --colors 256 \
    "$filepath" \
    2>/dev/null

  local after="$(stat --format=%s "$filepath")"
  # Bail if stat failed
  [[ "$after" == "" ]] && return 1
  echo "${filepath:t}: ${before}B → ${after}B"
done
