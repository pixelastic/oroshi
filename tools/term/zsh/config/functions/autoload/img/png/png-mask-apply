# Apply a mask on an image, like a cookie cutter
# Usage:
# $ png-mask-apply ./image.png ./mask.png                       # → ./image.masked.png
# $ png-mask-apply --output ./out.png ./image.png ./mask.png    # → ./out.png
setopt local_options err_return

zparseopts -E -D \
  -output:=flagOutput

local output="${flagOutput[2]}"
local image="$1"
local mask="$2"

# Default output: image.masked.png
[[ "$output" == "" ]] && output="${image:a:r}.masked.png"

local dims="$(img-dimensions "$image")"
[[ "$dims" == "" ]] && return 1
local tmpMask="$(mktemp /tmp/png-mask-apply-XXXXXX.png)"
[[ "$tmpMask" == "" ]] && return 1
cp "$mask" "$tmpMask"

magick "$tmpMask" -resize "${dims}!" "$tmpMask"
magick "$image" "$tmpMask" -compose CopyOpacity -composite -trim "$output"

rm -f "$tmpMask"
