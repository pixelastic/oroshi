# Turn the name of a helper into the full path of its file
# Usage:
# $ helper-path slugify         # Path of an autoloaded function or a script
# $ helper-path --reply slugify # Write to $REPLY, no echo
# Exits non-zero and prints nothing when the name is unknown
setopt local_options err_return bare_glob_qual

local flagReply=()
zparseopts -E -D \
  -reply=flagReply

local isReply=${#flagReply}
local name="$1"

# A name is required
[[ "$name" == "" ]] && return 1

# Autoloaded function: look for it in the function path
# (functions_source points to the shell snapshot in Claude Code's Bash tool)
local candidates=(${^fpath}/$name(N-.))
local filepath="${candidates[1]}"

# Script: look for it in the executable path
[[ "$filepath" == "" ]] && filepath="$(whence -p "$name")"

# Unknown name
[[ "$filepath" == "" ]] && return 1

if [[ $isReply == "1" ]]; then
  REPLY="$filepath"
  return
fi
echo "$filepath"
