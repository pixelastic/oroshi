# Runs my oroshi image
# Usage:
# $ docker-oroshi-run
setopt local_options err_return

local oroshiTag="$(docker-oroshi-tag)"

local currentUser="$(id -u)"
local currentGroup="$(id -g)"

docker-run-interactive \
  --user "${currentUser}:${currentGroup}" \
  --workdir /home/tim \
  --hostname oroshi \
  oroshi:${oroshiTag}
