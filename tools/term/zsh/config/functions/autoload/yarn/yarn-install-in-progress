# Check if a yarn install is currently running
# Usage:
# $ yarn-install-in-progress && echo "installing..."
setopt local_options err_return

git-dependencies-in-progress-lockfile node --reply

# Lockfile held by a live process, install is still running
if lockfile-is-active "$REPLY"; then
  return 0
fi

# No live process, no install running
return 1
