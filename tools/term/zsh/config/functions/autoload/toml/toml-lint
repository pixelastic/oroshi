# Lint a TOML file
# Usage:
# $ toml-lint ./path/to/file.toml
setopt local_options err_return

# Input file
local inputFile="${1:a}"
if [[ ! -f "$inputFile" ]]; then
  echoerr "Error: File '$inputFile' not found"
  return 1
fi

taplo lint \
  --default-schema-catalogs \
  "$inputFile" 2>&1

fly-lint "$inputFile" 2>&1
