# Start a microphone, and paste the content as text
# Usage:
# $ mic2txt-raw --wav2txt wav2txt-openai   # Starts recording then...
#   mic2txt-raw --wav2txt wav2txt-openai   # ...stops and transcribes
setopt local_options err_return
zmodload zsh/datetime

# Parsing args {{{
zparseopts -E -D \
  -wav2txt:=flagWav2Txt

local wav2TxtName=${flagWav2Txt[2]}
# }}}

# Default values {{{
local functionDir="${functions_source[$0]:A:h}"
local wav2TxtBinary="${functionDir}/__lib/${wav2TxtName}"
local tmpFolder=${MOCK_MIC2TXT_TMP_FOLDER:-/dev/shm/oroshi/mic2txt}
local pidFile=${tmpFolder}/PID
local startTimeFile=${tmpFolder}/START_TIME
local recordFile=${tmpFolder}/record.wav
mkdir -p $tmpFolder
# }}}

# Start a recording
function startRecording() {
  rec \
    --rate 16000 \
    --channels 1 \
    $recordFile &

  # Save the pid
  echo $! >$pidFile

  # Save the start time for min-duration guard
  echo $EPOCHREALTIME >$startTimeFile

  # Not in a kitty window, we'll paste wherever the focus is, at the end
  if ! kitty-os-window-is-focused; then
    return 0
  fi

  # In a kitty window, we save where the focus is right now, so we can paste it
  # there at the end
  local windowId="$(kitty-window-id)"
  echo "$windowId" >${tmpFolder}/TARGET_WINDOW_ID
  kitty-window-highlight --window "$windowId" "#d69e2e"
}

# Stop the current recording
function stopRecording() {
  sleep 2

  process-kill "$(cat $pidFile)"
  rm $pidFile

  # We transcribe to text
  audio-play-oroshi mic2txt-before.mp3
  local transcription="$(${wav2TxtBinary} $recordFile)"

  # Apply autocorrect rules (case-insensitive, whole-word substitution)
  local autocorrectFile="${functionDir}/__data/autocorrect.conf"
  # Skip if no config file
  if [[ -f $autocorrectFile ]]; then
    local wrong
    local right
    for line in ${(f)"$(cat $autocorrectFile)"}; do
      [[ "$line" == "" || "$line" == "#"* ]] && continue
      wrong="${line%%=*}"
      right="${line#*=}"
      right="${right/ #*/}"
      right="${right%"${right##*[! ]}"}"
      # shellcheck disable=SC2001 - word-boundary with hyphen exclusion requires perl
      transcription="$(echo "$transcription" | perl -pe "s/(?<![a-zA-Z0-9-])\Q${wrong}\E(?![a-zA-Z0-9-])/${right}/gi")"
    done
  fi

  # Translate to english
  local language="$(mic2txt-language)"
  if [[ $language != "fr" ]]; then
    transcription="$(translate "$transcription" --language ${language})"
  fi

  # Rewrite as a slack message
  if mic2txt-slack-mode-is-enabled; then
    transcription="$(txt2slack "$transcription")"
  fi

  # Play a sound to indicate it's being pasted
  audio-play-oroshi mic2txt.mp3

  # Save transcription and paste it
  echo "$transcription" > "${tmpFolder}/transcription.txt"
  mic2txt-paste

  # Reset kitty highlight if a target window was captured
  local targetFile="${tmpFolder}/TARGET_WINDOW_ID"
  if [[ -f $targetFile ]]; then
    kitty-window-highlight-reset "$(cat "$targetFile")"
    rm "$targetFile"
  fi
}

# If a recording is not already in progress, we start a new one
if [[ ! -f $pidFile ]]; then
  startRecording
  return 0
fi

# Recording too short — cancel instead of transcribing
local startTime="$(cat $startTimeFile)"
local elapsed=$(( EPOCHREALTIME - startTime ))
if (( elapsed < 2 )); then
  mic2txt-cancel
  return 0
fi

# Otherwise, we stop the current recording
stopRecording
