# Return the Context Root for a path
# Worktree root if inside a linked worktree; project root otherwise
# Returns empty string if path belongs to no known project
# Usage:
# $ context-root /path/inside/worktree      # Returns worktree root
# $ context-root /path/inside/project       # Returns project root
# $ context-root --reply /path/to/project   # Writes to $REPLY instead of stdout
setopt local_options err_return

zparseopts -E -D \
  -reply=flagReply

local isReply=${#flagReply}
local targetPath="${1:-$PWD}"

REPLY=""
context-raw --reply "$targetPath"

# No root outside of a known project
[[ "$REPLY" == "" ]] && return 0

local fields=("${(@ps/▮/)REPLY}")
local root="${fields[3]}"

if [[ $isReply == 1 ]]; then
  REPLY="$root"
  return 0
fi

echo "$root"
