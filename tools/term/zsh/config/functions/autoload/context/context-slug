# Return a filesystem-safe identifier for a given context
# Example: oroshi--context-slug
# Usage:
# $ context-slug                                  # oroshi
# $ context-slug /some/path                       # oroshi--yarn-sync
# $ context-slug --project myapp                  # myapp--yarn-sync (in worktree)
# $ context-slug --branch feat/x                  # oroshi--feat_x
# $ context-slug --project myapp --branch feat/x  # myapp--feat_x
setopt local_options err_return

zparseopts -E -D \
  -project:=flagProject \
  -branch:=flagBranch

local projectOverride="${flagProject[2]}"
local branchOverride="${flagBranch[2]}"
local targetPath="${1:-$PWD}"

# Use context-raw for all info
local rawArgs=(--reply)
[[ "$projectOverride" != "" ]] && rawArgs+=(--project "$projectOverride")
[[ "$branchOverride" != "" ]] && rawArgs+=(--branch "$branchOverride")
rawArgs+=("$targetPath")

context-raw "${rawArgs[@]}"
local fields=("${(@ps/▮/)REPLY}")
local project="${fields[1]}"
local branch="${fields[2]}"

# No branch: return just project
if [[ "$branch" == "" ]]; then
  echo "$project"
  return 0
fi

# Slugify branch and append
local branchSlug="$(git-branch-slug "$branch")"
echo "${project}--${branchSlug}"
