# Lint prose with Vale and output a minimal JSON array of violations
# Usage:
# $ prose-lint file.md                  # Lint a file
# $ prose-lint "some text to check"     # Lint a string
# $ prose-lint --profile blog file.md   # Lint with blog profile
setopt local_options err_return

zparseopts -E -D \
  -profile:=flagProfile

local profile="${flagProfile[2]:-default}"
local VALE_CONFIG="$OROSHI_ROOT/tools/prose/vale/dist/$profile.ini"
# jq filter: flatten Vale's keyed-by-filename object into a flat array with 5 fields
local JQ_FILTER='[.[][]] | map({line: .Line, rule: .Check, severity: .Severity, match: .Match, message: .Message})'
# jq filter: append the burstiness verdict as a violation when it is not ok
# shellcheck disable=SC2016
local JQ_BURSTINESS_FILTER='if $burstiness.ok then . else . + [{line: 1, rule: "burstiness", severity: "error", match: ("variation " + ($burstiness.variation | tostring)), message: $burstiness.message}] end'

local valeOutput=""
local valeExit=0
local burstiness=""

# No arg, no error
if [[ $# -eq 0 ]]; then
  printf '[]\n'
  return 0
fi

# If arg is not a file, we assume it's the string to lint, so we put it in a
# file
local inputFile="$1"
local isStringInput=0
if [[ ! -f "$1" ]]; then
  isStringInput=1
  inputFile="$(mktemp)"
  printf '%s' "$1" > "$inputFile"
fi

valeOutput="$(vale --config "$VALE_CONFIG" --output=JSON "$inputFile")" || valeExit=$?

# Burstiness runs outside Vale, which cannot call scripts. It needs the file,
# so it runs before the temp file is removed
burstiness="$(prose-burstiness --file "$inputFile")" || true

# Clean up temp file for string input
[[ $isStringInput -eq 1 ]] && rm --force "$inputFile"

# Vale crashed
[[ $valeExit -ge 2 ]] && return 2

local result="$(printf '%s' "$valeOutput" | jq --compact-output "$JQ_FILTER")"

# Add the verdict of prose-burstiness: one error when the sentences are too uniform
result="$(printf '%s' "$result" | jq --compact-output \
  --argjson burstiness "$burstiness" \
  "$JQ_BURSTINESS_FILTER")"

printf '%s\n' "$result"
[[ "$(printf '%s' "$result" | jq 'length')" -gt 0 ]] && return 1
return 0
