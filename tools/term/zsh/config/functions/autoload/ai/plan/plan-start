# Ensure plan is created in a worktree, init plan dir in $OROSHI_PLANS_DIR
# Usage:
# $ plan-start [branchName]
setopt local_options err_return

local branch="$1"

# Branch required when not already in a worktree
if ! git-directory-is-worktree; then
  if [[ "$branch" == "" ]]; then
    print -u2 "plan-start: branch name required when not in a worktree"
    return 1
  fi
  git-worktree-create "$branch"
fi

local root="$(git-directory-root)"
local currentBranch="$(git-branch-current)"
local planDir="$(plan-directory)"

# Init plan repo if it doesn't exist yet
if [[ ! -d "$planDir/.git" ]]; then
  mkdir -p "$planDir"
  git -C "$planDir" init \
    --quiet
  git -C "$planDir" commit \
    --quiet \
    --allow-empty \
    --message "init"
fi

jo \
  worktreePath="$root" \
  branch="$currentBranch" \
  planDir="$planDir/"
