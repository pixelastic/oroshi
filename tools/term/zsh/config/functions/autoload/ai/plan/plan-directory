# Return absolute path to the external plans directory for the current context
# Usage:
# $ plan-directory                                  # from current worktree
# $ plan-directory /some/path                       # explicit path
# $ plan-directory --project myapp                  # override project
# $ plan-directory --branch feat/x                  # override branch
# $ plan-directory --project myapp --branch feat/x  # override both
setopt local_options err_return

local slug="$(context-slug "$@")"
[[ "$slug" == "" ]] && return 1

print "$OROSHI_PLANS_DIR/$slug"
