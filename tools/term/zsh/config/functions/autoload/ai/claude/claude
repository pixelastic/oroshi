# Wrapper around claude, patching its syntax colors first when needed
# Usage:
# $ claude
setopt local_options err_return

# Default stop sound to auto if not already set
if [[ "$OROSHI_CLAUDE_STOP_SOUND" == "" ]]; then
  export OROSHI_CLAUDE_STOP_SOUND="auto"
fi

# Patch the syntax colors when the binary lacks the marker
if ! claude-is-color-patched; then
  echo "Patching Claude Code syntax…"
  local generateSyntax="$OROSHI_ROOT/tools/ai/claude/config/patch/syntax/generate-syntax"
  # A failed patch must not block the launch
  $generateSyntax || echo "✘ Could not patch Claude Code syntax colors"
fi

# Binary may exit non-zero; continue to cleanup
$OROSHI_ROOT/node_modules/.bin/claude "$@" || true

# Remove any leftover notification marker
kitty-tab-notification-remove
