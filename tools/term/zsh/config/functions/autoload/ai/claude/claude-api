# Send a one-shot prompt to the Anthropic Messages API
# Usage:
# $ claude-api "What is 2+2?"                                  # Default sonnet model
# $ claude-api --model opus "Explain gravity"                   # Specify model alias
# $ claude-api --max-tokens 1024 "Short answer only"            # Custom token limit
# $ claude-api --system "Be concise" "Explain gravity"          # With system prompt
# $ echo "long content" | claude-api --system "Summarize this"  # Read from stdin
setopt local_options err_return

# Guard: API key must be set
if [[ "$OROSHI_ANTHROPIC_API_KEY" == "" ]]; then
  echoerr "OROSHI_ANTHROPIC_API_KEY is not set"
  return 1
fi

local -A modelAliases=(
  sonnet  claude-sonnet-4-6
  opus    claude-opus-4-6
  haiku   claude-haiku-4-5-20251001
)

zparseopts -E -D \
  -model:=flagModel \
  -max-tokens:=flagMaxTokens \
  -system:=flagSystem

local modelAlias=${flagModel[2]:-sonnet}
local model=${modelAliases[$modelAlias]:-$modelAlias}
local maxTokens=${flagMaxTokens[2]:-4096}
local systemPrompt=${flagSystem[2]}
local prompt="$1"

# Read from stdin when no positional argument and stdin is piped
if [[ "$prompt" == "" ]] && [[ ! -t 0 ]]; then
  prompt="$(cat)"
fi

local message=$(jo role=user content="$prompt")

# Build arguments
local joArgs=(model="$model" max_tokens="$maxTokens")
[[ "$systemPrompt" != "" ]] && joArgs+=(system="$systemPrompt")
joArgs+=(messages="$(jo -a "$message")")

local body=$(jo "${joArgs[@]}")

local rawResponse=$(curl \
    --silent \
    --write-out '▮%{http_code}' \
    --header "x-api-key: $OROSHI_ANTHROPIC_API_KEY" \
    --header "anthropic-version: 2023-06-01" \
    --header "content-type: application/json" \
    --data "$body" \
  https://api.anthropic.com/v1/messages)

local -a parts=("${(@s/▮/)rawResponse}")
local response=${parts[1]}
local httpCode=${parts[2]}

# Guard: HTTP error
if [[ "$httpCode" != 2* ]]; then
  echoerr "Anthropic API error (HTTP $httpCode)"
  return 1
fi

# Guard: empty response
if [[ "$response" == "" ]]; then
  echoerr "Empty response from Anthropic API"
  return 1
fi

printf '%s\n' "$response" | jq -r '.content[0].text'
