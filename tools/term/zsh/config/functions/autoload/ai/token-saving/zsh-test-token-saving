# Run zsh-test with output reduced to failures only
# Set OROSHI_DISABLE_TOKEN_SAVING=1 to run zsh-test unchanged
# Usage:
# $ zsh-test-token-saving ./misc/slugify   # Same arguments as zsh-test
setopt local_options err_return

# Token saving disabled: run the original command unchanged
if [[ "$OROSHI_DISABLE_TOKEN_SAVING" == "1" ]]; then
  zsh-test "$@"
  return $?
fi

zsh-test --token-saving "$@"
