# Run js-test with output reduced to failures only
# Set OROSHI_DISABLE_TOKEN_SAVING=1 to run js-test unchanged
# Usage:
# $ js-test-token-saving ./src/module.js   # Same arguments as js-test
setopt local_options err_return

# Token saving disabled: run the original command unchanged
if [[ "$OROSHI_DISABLE_TOKEN_SAVING" == "1" ]]; then
  js-test "$@"
  return $?
fi

js-test --token-saving "$@"
