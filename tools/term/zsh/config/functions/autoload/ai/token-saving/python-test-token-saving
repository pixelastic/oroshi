# Run python-test with output reduced to failures only
# Set OROSHI_DISABLE_TOKEN_SAVING=1 to run python-test unchanged
# Usage:
# $ python-test-token-saving tests/            # Same arguments as python-test
setopt local_options err_return

# Token saving disabled: run the original command unchanged
if [[ "$OROSHI_DISABLE_TOKEN_SAVING" == "1" ]]; then
  python-test "$@"
  return $?
fi

python-test --token-saving "$@"
