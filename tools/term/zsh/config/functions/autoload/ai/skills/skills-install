# Install a Claude Code skill globally
# Usage:
# $ skills-install <skill-name>
setopt local_options err_return
local skillName="$1"

# Skill name is required
if [[ "$skillName" == "" ]]; then
  echo "Usage: skills-install <skill-name>"
  return 1
fi

skills add "$skillName" \
  --global \
  --agent claude-code \
  --yes >/dev/null
echo "Skill ${skillName} installed"
