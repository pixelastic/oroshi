# Remove a globally installed Claude Code skill
# Usage:
# $ skills-remove <skill-name>
setopt local_options err_return
local skillName="$1"

# Skill name is required
if [[ "$skillName" == "" ]]; then
  echo "Usage: skills-remove <skill-name>"
  return 1
fi

skills remove "$skillName" \
  --global \
  --yes
