# Add a command to the Claude Code skills allowlist
# Usage:
# $ skills-allowlist-add "tree"
setopt local_options err_return
local allowedCommand="$1"
local allowlistFile=~/.oroshi/tools/ai/claude/config/hooks/allow-list.json

if [[ "$allowedCommand" == "" ]]; then
  echoerr "Error: Command required"
  echoerr "Usage: skills-allowlist-add <command>"
  return 1
fi

# Add new command and sort using json-array-sort (matching Neovim behavior)
local tmpFile="$(mktemp)"

jq \
  --arg newCommand "$allowedCommand" \
  '. + [$newCommand] | unique' \
  "$allowlistFile" \
  | json-array-sort >"$tmpFile"

/usr/bin/cat "$tmpFile" >"$allowlistFile"
rm "$tmpFile"
