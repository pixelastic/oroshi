# Add one or more commands to the Claude Code skills allowlist
# Usage:
# $ skills-allowlist-add "tree"
# $ skills-allowlist-add tree "apt list" jq
setopt local_options err_return
local allowlistFile=~/.oroshi/tools/ai/claude/config/hooks/allow-list.json

# At least one command is required
if [[ $# -eq 0 ]]; then
  echoerr "Error: Command required"
  echoerr "Usage: skills-allowlist-add <command>..."
  return 1
fi

local allowedCommand
for allowedCommand in "$@"; do
  json-array-add --input "$allowlistFile" --unique "$allowedCommand"
done

# Sort using json-array-sort (matching Neovim behavior)
# Empty stdin: json-array-sort reads a piped stdin over its file arg
local sortedJson="$(json-array-sort "$allowlistFile" </dev/null)"
print -r -- "$sortedJson" >"$allowlistFile"
