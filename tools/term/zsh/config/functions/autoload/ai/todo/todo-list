# List todo items as a colored, columnar display
# Usage:
# $ todo-list            # All items, with domain column
# $ todo-list Git        # Filter by domain, no domain column
setopt local_options err_return

local domain="$1"

local rawOutput="$(todo-list-raw "$domain")"

# Nothing to display
[[ "$rawOutput" == "" ]] && return 0

colors-load-definitions

local -A SIZE_ICONS=(1 "🅢" 2 "🅜" 3 "🅛")
local -A SIZE_COLORS=(1 todo-small 2 todo-medium 3 todo-large)

local output=""
for rawLine in ${(f)rawOutput}; do
  local fields=(${(@ps/▮/)rawLine})
  local itemDomain=$fields[1]
  local sizeRank=$fields[2]
  local description=$fields[4]
  local blocked=$fields[5]

  local icon="${SIZE_ICONS[$sizeRank]}"
  local sizeColor="${SIZE_COLORS[$sizeRank]}"

  # Blocked descriptions shown in red
  local descColor=todo-description
  [[ "$blocked" == "1" ]] && descColor=todo-blocked

  local coloredIcon="$(colorize "$icon" "$sizeColor")"
  local coloredDesc="$(colorize "$description" "$descColor")"

  # Domain column only when no filter
  if [[ "$domain" == "" ]]; then
    local coloredDomain="$(colorize "$itemDomain" todo-domain)"
    output+="${coloredDomain}▮${coloredIcon}  ${coloredDesc}\n"
  else
    output+="${coloredIcon}  ${coloredDesc}\n"
  fi
done

echo -n "$output" | grep . | table
