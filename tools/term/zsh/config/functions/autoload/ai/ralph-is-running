# Exit 0 if a ralph session is active for a plan directory, 1 if not.
# Usage:
#   ralph-is-running [planDir]   # planDir inferred from plan-directory if omitted
# Silent — no output, exit code only.
setopt local_options err_return

local planDir="$1"

# No arg: infer plan dir from external store
if [[ "$planDir" == "" ]]; then
  planDir="$(plan-directory 2>/dev/null)" || return 1
fi

# No ralph.json means no active session
[[ ! -f "$planDir/ralph.json" ]] && return 1
return 0
