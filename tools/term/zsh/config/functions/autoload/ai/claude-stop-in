# Stop all Claude Code processes whose CWD is inside a directory
# Always returns 0 — safe to call unconditionally
# Usage:
# $ claude-stop-in /path/to/worktree
setopt local_options err_return

local targetPath="${1:A}"

# Target path is required
[[ "$targetPath" == "" ]] && return 1

local pids=($(process-find claude))
[[ ${#pids} -eq 0 ]] && return 0

local pid
for pid in "${pids[@]}"; do
  local procCwd="$(process-cwd "$pid" 2>/dev/null)"
  [[ "$procCwd" == "" ]] && continue

  # Skip processes not rooted in target directory
  [[ "$procCwd" != "$targetPath"* ]] && continue

  process-kill "$pid" 2>/dev/null
done
