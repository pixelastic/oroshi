# Clear ralph session lock
# Usage:
# $ ralph-clear [dir]   # dir defaults to the worktree plan directory, then cwd
setopt local_options err_return

local rawArg="${1:-}"
# If already in a worktree with a plan, use it
if [[ "$rawArg" == "" ]]; then
  rawArg="$(plan-directory)" || rawArg="."
fi
local dir="${rawArg:a}"

rm -f "$dir/ralph.json"
