# Output the review range and PRD path of a plan as JSON for the ralph-review skill
# Usage:
# $ ralph-review-start [<dir>]   # dir defaults to ".", a plan dir or any path plan-directory resolves (e.g. a worktree)
setopt local_options err_return

local dir="${1:-.}"

# Not a plan dir (e.g. the worktree root): deduce the plan dir from it
[[ ! -f "$dir/state.json" ]] && dir="$(plan-directory "$dir" 2>/dev/null)"

# No plan dir resolved
if [[ "$dir" == "" ]]; then
  print "ralph-review-start: no plan directory found" >&2
  return 1
fi
# state.json must exist
if [[ ! -f "$dir/state.json" ]]; then
  print "ralph-review-start: state.json not found in $dir" >&2
  return 1
fi

# The review range starts where the worktree leaves main
local startCommit="$(git-worktree-start)"
if [[ "$startCommit" == "" ]]; then
  print "ralph-review-start: no commit ahead of main" >&2
  return 1
fi

local absoluteDirectory="${dir:A}"
jq -n \
  --arg startCommit "$startCommit" \
  --arg dir "$absoluteDirectory" \
'{
    status: "ready",
    ref: ($startCommit+"..HEAD"),
    spec: ($dir+"/PRD.md")
  }'
