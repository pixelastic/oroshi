# Signal end of ralph session
# In auto mode: queue the next command, then stop Claude.
# Usage:
# $ ralph-end <dir>
setopt local_options err_return

local dir="$1"
if [[ "$dir" == "" ]]; then
  print "ralph-end: <dir> required"
  return 1
fi

local mode="$(ralph-mode "$dir")"
ralph-log "ralph-end: called mode='${mode}' dir=${dir}"

# If single mode, let's stop here
[[ "$mode" == "single" ]] && return 0

# If auto mode, let's enqueue the next command, then stop Claude
local progress=(${(@ps/▮/)"$(plan-progress "$dir")"})
local doneCount=$progress[1]
local totalCount=$progress[2]

# If we have more issues to tackle, open a new ralph session
local nextCommand="ralph --auto ${(q)dir}"

# If this was the last issue, let's review everything we did so far instead
if [[ "$doneCount" == "$totalCount" ]]; then
  local branchedAt="$(jq --raw-output '.branchedAt' "$dir/state.json")"
  local reviewPrompt="/review ref:${branchedAt}..HEAD spec:${dir}/PRD.md"
  nextCommand="claude ${(qq)reviewPrompt}"
fi

# Add the next command to the zsh queue
# The group traces its life in the ralph log: its start, a signal that kills it,
# a failed step, and its end. The EXIT trap does not fire on the final exec, so
# a missing "done" line means the shell died inside the group
local group="{ ralph-log 'queued group: start';"
group+=" trap 'ralph-log \"queued group: EXIT status=\$?\"' EXIT;"
group+=" trap 'ralph-log \"queued group: got HUP\"; exit 129' HUP;"
group+=" trap 'ralph-log \"queued group: got TERM\"; exit 143' TERM;"
group+=" git-commit-create-all-auto && ${nextCommand}"
group+=" || ralph-log \"queued group: step failed status=\$?\";"
group+=" ralph-log 'queued group: done'; }; exec zsh"
ralph-log "ralph-end: queueing next='${nextCommand}' progress=${doneCount}/${totalCount}"
zsh-queue-write "exec zsh -ic ${(qq)group}"

# now, stop Claude, so zsh takes over
ralph-log "ralph-end: stopping claude"
claude-stop
ralph-log "ralph-end: claude-stop returned status=$?"
