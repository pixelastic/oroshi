# Signal end of ralph session
# In auto mode: queue the next command, then stop Claude.
# Usage:
# $ ralph-end <planDirectory>
setopt local_options err_return

local planDirectory="$1"
if [[ "$planDirectory" == "" ]]; then
  print "ralph-end: <planDirectory> required"
  return 1
fi

local mode="$(ralph-mode "$planDirectory")"

# If single mode, let's stop here
[[ "$mode" == "single" ]] && return 0

# If auto mode, let's enqueue the next command, then stop Claude
local worktree="$(plan-worktree "$planDirectory")"

# Add the next command to the zsh queue
zsh-queue-write "ralph-auto-next ${(q)worktree}"

# now, stop Claude, so zsh takes over
claude-stop
