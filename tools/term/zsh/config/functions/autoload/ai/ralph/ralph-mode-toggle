# Flip the ralph session mode between single and auto
# Usage:
# $ ralph-mode-toggle [dir]   # dir defaults to the worktree plan directory, then cwd
setopt local_options err_return

local rawArg="${1:-}"
# If already in a worktree with a plan, use it
if [[ "$rawArg" == "" ]]; then
  rawArg="$(plan-directory)" || rawArg="."
fi
local directory="${rawArg:a}"

# No session running, nothing to toggle
[[ ! -f "$directory/ralph.json" ]] && return 0

# Write to a temp file then rename, so readers never see a partial file
local tmpFile="$(mktemp "$directory/ralph.json.XXXXXX")"
local filter='.mode = (if .mode == "auto" then "single" else "auto" end)'
if ! jq "$filter" "$directory/ralph.json" > "$tmpFile"; then
  rm --force "$tmpFile"
  return 1
fi
mv --force "$tmpFile" "$directory/ralph.json"
