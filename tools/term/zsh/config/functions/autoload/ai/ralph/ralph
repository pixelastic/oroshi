# Run a ralph session on the plan of a worktree
#
# Usage:
# $ ralph [--auto] [worktree]   # worktree defaults to the current directory
setopt local_options err_return

local autoFlag
zparseopts -D -E -- -auto=autoFlag

local mode="single"
[[ "$autoFlag" != "" ]] && mode="auto"

local worktree="${1:-.}"
local dir="$(plan-directory "${worktree:a}")"

# The worktree must have a plan
if [[ "$dir" == "" ]]; then
  print "ralph: ❌ no plan directory for ${worktree:a}"
  return 1
fi

# Refuse if any session is already running
if ralph-is-running "$dir"; then
  print "ralph: ❌ session already in progress"
  return 1
fi

# A finished plan has nothing left to run, whatever the mode
local progress=(${(@ps/▮/)"$(plan-progress "$dir")"})
local doneCount=$progress[1]
local totalCount=$progress[2]
if [[ "$doneCount" != "" && "$doneCount" == "$totalCount" ]]; then
  print "ralph: ✅ no remaining issue"
  return 0
fi

# Initialize the lock
jq -n --arg mode "$mode" '{"mode":$mode}' >"$dir/ralph.json"

# Navigate to git root
cd "$(git-directory-root)"

# Launch Claude in foreground; capture exit code
local permissionMode="acceptEdits"
[[ "$mode" == "auto" ]] && permissionMode="auto"
local claudeExit=0
claude --permission-mode "$permissionMode" "/ralph $dir" || claudeExit=$?

# Always clear the lock, even on failure
ralph-clear "$dir"

return $claudeExit
