# Run ralph in single-shot mode
# Usage:
# $ ralph <dir>
setopt local_options err_return

local scriptDir="${functions_source[$0]:A:h}"
source "$scriptDir/__lib/ralph-single.zsh"

local rawArg="${1:-}"
# If already in a worktree with a plan, use it
if [[ "$rawArg" == "" ]]; then
  rawArg="$(plan-directory)" || rawArg="."
fi
local dir="${rawArg:a}"

ralph-single "$dir"
