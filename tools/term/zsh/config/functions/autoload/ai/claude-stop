# Terminate the calling Claude Code main session
# Walks up the process tree to find the first "claude" ancestor and SIGTERMs it
# Usage:
# $ claude-stop
setopt local_options err_return

# Not in Claude — nothing to stop
is-claude || return 0

# Subagents must not kill the main session
is-claude-subagent && return 0

local ancestors="$(process-tree-raw $$)"
local claudeLine="$(echo "$ancestors" | grep "▮claude$" | head -1)"

if [[ "$claudeLine" == "" ]]; then
  echoerr "claude process not found in ancestor chain"
  return 1
fi

local -a parts=(${(@ps/▮/)claudeLine})
kill -TERM "$parts[1]"
