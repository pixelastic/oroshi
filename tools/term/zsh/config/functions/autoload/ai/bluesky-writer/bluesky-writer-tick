# Copy a bluesky-writer draft file to clipboard
# Usage:
# $ bluesky-writer-tick /path/to/draft.md
setopt local_options err_return

local draftPath="$1"

# Draft file is required
if [[ "$draftPath" == "" ]]; then
  echoerr "Usage: bluesky-writer-tick <draft-path>"
  return 1
fi

# Draft file must exist
if [[ ! -f "$draftPath" ]]; then
  echoerr "Draft file not found: $draftPath"
  return 1
fi

clipboard-write "$(cat "$draftPath")"
