# Convert an RSS feed to a Lunii pack using studio-pack-generator
# Usage:
# $ rss2lunii <url>             # Convert feed with defaults
# $ rss2lunii <url> --force-img # Regenerate images
# $ rss2lunii <url> --force-tts # Regenerate TTS audio
setopt local_options err_return

zparseopts -E -D \
  -force-img=flagForceImg \
  -force-tts=flagForceTts

local isForceImg=${#flagForceImg}
local isForceTts=${#flagForceTts}

local url="$1"

if [[ "$url" == "" ]]; then
  echoerr "Usage: rss2lunii <url> [--force-img] [--force-tts]"
  return 1
fi

# Source helper functions
local libDir="${functions_source[$0]:A:h}/__lib"
source "$libDir/deleteCachedImages.zsh"
source "$libDir/deleteCachedTts.zsh"
source "$libDir/downloadAndProcessRss.zsh"
source "$libDir/generateEpisodeImages.zsh"
source "$libDir/getRssTitle.zsh"
source "$libDir/repackAsZip.zsh"
source "$libDir/resizeThumbnail.zsh"

local packTitle="$(getRssTitle "$url")"
local packDir="./${packTitle}"

[[ $isForceImg -eq 1 ]] && deleteCachedImages "$packDir"
[[ $isForceTts -eq 1 ]] && deleteCachedTts "$packDir"

downloadAndProcessRss "$url"
generateEpisodeImages "$packDir"
resizeThumbnail "$packDir"
repackAsZip "$packDir"
