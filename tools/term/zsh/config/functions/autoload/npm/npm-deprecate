# Deprecate an npm package with a message
# Usage:
# $ npm-deprecate my-package "Use other-package instead"
# $ npm-deprecate my-package "Use other-package instead" --otp 123456
setopt local_options err_return

zparseopts -E -D \
  -otp:=flagOtp

local otp=${flagOtp[2]}
local packageName=$1
local message=$2

# Empty message would un-deprecate the package
[[ "$message" == "" ]] && return 1

# Must be logged in to deprecate
if ! npm-is-logged-in; then
  echo "You must be logged in to npm first. Run npm-login"
  return 1
fi

local -a otpArgs=()
[[ "$otp" != "" ]] && otpArgs=(--otp "$otp")

npm deprecate "$packageName" "$message" "${otpArgs[@]}"
