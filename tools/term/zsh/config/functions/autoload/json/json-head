# Return the top elements of a JSON array file
# Usage:
# $ json-head file.json 10  # Output the first 10 elements
setopt local_options err_return

local inputFile="${1:a}"
local headLimit="$2"

if [[ $headLimit == "" ]]; then
  echo "✘ You must pass the number of elements to return"
  return 1
fi

jq \
  ".[:${headLimit}]" \
  $inputFile
