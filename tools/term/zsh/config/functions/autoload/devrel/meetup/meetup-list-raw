# List the DevRel meetups, one per line, most recent first
# Fields: recordId▮date▮status▮name▮URL
# The status is its label: pending, confirmed or cancelled
# An empty Field leaves an empty column
# --status keeps only the meetups with that status
# --upcoming keeps only the meetups of today or later
# --limit keeps only the first meetups, once the other filters are applied (default: all)
# One API call is made, so at most 100 meetups are listed
# Usage:
# $ meetup-list-raw
# $ meetup-list-raw --status pending
# $ meetup-list-raw --upcoming
# $ meetup-list-raw --limit 10
setopt local_options err_return

zparseopts -E -D \
  -status:=flagStatus \
  -upcoming=flagUpcoming \
  -limit:=flagLimit

local statusFilter=${flagStatus[2]}
local isUpcoming=${#flagUpcoming}
local limit=${flagLimit[2]}

# Only the statuses stored in Airtable can filter
if [[ "$statusFilter" != "" && ! "$statusFilter" =~ ^(pending|confirmed|cancelled)$ ]]; then
  echoerr "Unknown status: $statusFilter (pending, confirmed or cancelled)"
  return 1
fi

# The DevRel Base ID lives in the private environment
if [[ "$AIRTABLE_BASE_DEVREL" == "" ]]; then
  echoerr "AIRTABLE_BASE_DEVREL is not set"
  return 1
fi

local rawRecords="$(airtable-record-list-raw \
  --base "$AIRTABLE_BASE_DEVREL" \
  --table Meetups \
  --fields date,status,name,URL \
  --sort -date)"

local today="$(date +%Y-%m-%d)"

local printedCount=0
for rawRecord in ${(f)rawRecords}; do
  # Stop once the limit is reached
  [[ "$limit" != "" && $printedCount -ge $limit ]] && break

  local fields=("${(@ps/▮/)rawRecord}")

  # Skip the meetups already past (ISO dates sort like text)
  [[ $isUpcoming == 1 && "${fields[2]}" < "$today" ]] && continue

  # Airtable stores a label such as "⏳️ Pending": the last word, in lowercase, is the status
  local label="${${(L)fields[3]}##* }"

  # Skip the meetups of another status
  [[ "$statusFilter" != "" && "$label" != "$statusFilter" ]] && continue

  fields[3]="$label"
  echo "${(j/▮/)fields}"
  (( ++printedCount ))
done
