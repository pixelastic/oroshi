# List the upcoming DevRel meetups (today or later), one per line, closest first
# Fields: recordId▮date▮status▮name▮URL
# The status is its label: pending, confirmed or cancelled
# An empty Field leaves an empty column
# --status keeps only the meetups with that status
# --date-min starts the list at a date, inclusive (default: today)
# --date-max stops the list at a date, inclusive (default: none)
# A date is YYYY, YYYY-MM or YYYY-MM-DD: a partial date is its first day as a minimum, its last day as a maximum
# An invalid date, or a minimum later than the maximum, exits with code 1 before any request
# --limit keeps only the first meetups, once the other filters are applied (default: 25)
# A date flag removes the default limit: every match is listed. An explicit --limit always wins
# When the default limit hides meetups, stderr gets "More meetups exist, raise --limit"
# At most 1000 meetups are listed
# Usage:
# $ meetup-list-raw
# $ meetup-list-raw --status pending
# $ meetup-list-raw --limit 10
# $ meetup-list-raw --date-min 2024-11 --date-max 2024-11
setopt local_options err_return

zparseopts -E -D \
  -status:=flagStatus \
  -date-min:=flagDateMin \
  -date-max:=flagDateMax \
  -limit:=flagLimit

local statusFilter=${flagStatus[2]}
local dateMin=${flagDateMin[2]}
local dateMax=${flagDateMax[2]}
local limit=${flagLimit[2]}

# Without --limit or a date flag, the list is capped and warns if more meetups match
local isDefaultLimit=0
if [[ "$limit" == "" && "$dateMin" == "" && "$dateMax" == "" ]]; then
  limit=25
  isDefaultLimit=1
fi

# Only the statuses stored in Airtable can filter
if [[ "$statusFilter" != "" && ! "$statusFilter" =~ ^(pending|confirmed|cancelled)$ ]]; then
  echoerr "Unknown status: $statusFilter (pending, confirmed or cancelled)"
  return 1
fi

# A date must exist before any request
if [[ "$dateMin" != "" ]] && ! date-is-valid "$dateMin"; then
  echoerr "Invalid --date-min: $dateMin (YYYY, YYYY-MM or YYYY-MM-DD)"
  return 1
fi
if [[ "$dateMax" != "" ]] && ! date-is-valid "$dateMax"; then
  echoerr "Invalid --date-max: $dateMax (YYYY, YYYY-MM or YYYY-MM-DD)"
  return 1
fi

# A period cannot end before it starts
if [[ "$dateMin" != "" && "$dateMax" != "" && "$(date-expand "$dateMin")" > "$(date-expand --last "$dateMax")" ]]; then
  echoerr "--date-min $dateMin is later than --date-max $dateMax"
  return 1
fi

# The DevRel Base ID lives in the private environment
if [[ "$AIRTABLE_BASE_DEVREL" == "" ]]; then
  echoerr "AIRTABLE_BASE_DEVREL is not set"
  return 1
fi

# The API cannot sort: each line holds the Fields as JSON, sorted here by date
local rawRecords="$(airtable-record-list-raw \
  --baseId "$AIRTABLE_BASE_DEVREL" \
  --tableId Meetups \
  --limit 1000)"

# An empty Field leaves an empty column
rawRecords="$(jq \
  --raw-input \
  --raw-output \
  --slurp \
'
  split("\n")
  | map(select(. != "") | split("▮") | {id: .[0], fields: (.[1] | fromjson)})
  | sort_by(.fields.date // "")
  | .[]
  | [.id, (.fields.date // ""), (.fields.status // ""), (.fields.name // ""), (.fields.URL // "")]
  | join("▮")
' <<< "$rawRecords")"

# The period starts today unless --date-min says otherwise
local firstDate="$(date +%Y-%m-%d)"
[[ "$dateMin" != "" ]] && firstDate="$(date-expand "$dateMin")"

# The period has no end unless --date-max says otherwise
local lastDate=""
[[ "$dateMax" != "" ]] && lastDate="$(date-expand --last "$dateMax")"

local printedCount=0
for rawRecord in ${(f)rawRecords}; do
  local fields=("${(@ps/▮/)rawRecord}")

  # Skip the meetups before the period (ISO dates sort like text)
  [[ "${fields[2]}" < "$firstDate" ]] && continue

  # Skip the meetups after the period
  [[ "$lastDate" != "" && "${fields[2]}" > "$lastDate" ]] && continue

  # Airtable stores a label such as "⏳️ Pending": the last word, in lowercase, is the status
  local label="${${(L)fields[3]}##* }"

  # Skip the meetups of another status
  [[ "$statusFilter" != "" && "$label" != "$statusFilter" ]] && continue

  # Stop at the first match past the limit, and say so if the limit was the default
  if [[ "$limit" != "" && $printedCount -ge $limit ]]; then
    [[ $isDefaultLimit == 1 ]] && echoerr "More meetups exist, raise --limit"
    break
  fi

  fields[3]="$label"
  echo "${(j/▮/)fields}"
  (( ++printedCount ))
done
