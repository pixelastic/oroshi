# Read a single DevRel meetup by Record ID, and print its Fields as flat JSON
# The JSON holds every non-empty Field, including the Attachment IDs, but not the Record ID
# Usage:
# $ meetup-read recXXX
setopt local_options err_return

local recordId="$1"

# Nothing to read without a Record ID
if [[ "$recordId" == "" ]]; then
  echoerr "Usage: meetup-read <recordId>"
  return 1
fi

# The DevRel Base ID lives in the private environment
if [[ "$AIRTABLE_BASE_DEVREL" == "" ]]; then
  echoerr "AIRTABLE_BASE_DEVREL is not set"
  return 1
fi

local record="$(airtable-record-read \
  "$recordId" \
  --baseId "$AIRTABLE_BASE_DEVREL" \
  --tableId Meetups)"

# The read failed and printed its error: there is no Record to print
[[ "$record" == "" ]] && return 1

jq '.fields' <<< "$record"
