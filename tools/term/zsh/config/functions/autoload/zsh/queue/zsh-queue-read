# Print the command queued for the current Kitty window
# Usage:
# $ zsh-queue-read   # Print queued command, return 1 if none
setopt local_options err_return

# Not in a Kitty window, nothing can be queued
[[ "$KITTY_WINDOW_ID" == "" ]] && return 1

local queueFile="${OROSHI_FOLDER_STATE}/zsh-queue/${KITTY_WINDOW_ID}"

# Nothing queued
[[ ! -f "$queueFile" ]] && return 1

cat "$queueFile"
