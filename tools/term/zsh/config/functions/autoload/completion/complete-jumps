# List merged marks + projects for completion
# Projects win on name collision
# Usage:
# $ complete-jumps
setopt local_options err_return

typeset -A entries

# Collect marks
local rawMarks="$(mark-list-raw)"
for line in ${(f)rawMarks}; do
  local fields=(${(@ps/▮/)line})
  local name=$fields[1]
  local target=$fields[2]
  entries[$name]="$target"
done

# Merge projects — overwrite marks on collision
projects-load-definitions
for key in ${(k)PROJECTS}; do
  [[ "$key" != *:path ]] && continue
  local name="${key%:path}"
  entries[$name]="${PROJECTS[$key]}"
done

# Format output
for name in ${(ko)entries}; do
  local description=""
  local icon="${PROJECTS[$name:icon]}"

  [[ "$icon" != "" ]] && description="${icon}${name}"
  [[ "$description" == "" ]] && description="${entries[$name]/$HOME\//}"

  echo "${name}:${description}"
done
