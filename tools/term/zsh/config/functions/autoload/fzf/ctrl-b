# Search available commands, aliases, and functions with fzf
# Usage:
# $ ctrl-b                    # Interactive command search
# $ ctrl-b --source           # Print available commands (one per line)
# $ ctrl-b --options          # Print FZF options (one per line)
# $ ctrl-b --preview <name>    # Show type and location of a command
# $ ctrl-b --postprocess      # Read raw selection from stdin, print command name
setopt local_options err_return
local __lib="${functions_source[$0]:A:h}/__lib"
source "$__lib/init.zsh"
source "$__lib/fzf-options-prompt-label.zsh"

function fzf-source() {
  print -l -- ${(k)commands} ${(k)aliases} ${(k)functions} | sort --unique
}

function fzf-preview() {
  local name="$1"
  local typeOutput="$(whence -w "$name" 2>/dev/null)"
  [[ "$typeOutput" == "" ]] && return 0

  # Type: strip "name: " prefix
  local type="${typeOutput##*: }"
  colors-load-definitions

  # For external commands, show colored path instead of type label
  if [[ "$type" == "command" ]]; then
    local cmdPath="$(whence -p "$name" 2>/dev/null)"
    [[ "$cmdPath" == "" ]] && return 0

    # Colored path: directory in green, filename in yellow
    local dirPart="${cmdPath:h}"
    local filePart="${cmdPath:t}"
    colorize --reply " ${dirPart}/" directory
    local coloredDir="$REPLY"
    colorize --reply "$filePart" executable
    echo "${coloredDir}${REPLY}"

    # For non-oroshi commands, show --help
    [[ "$cmdPath" == "$OROSHI_ROOT"/* ]] && return 0
    [[ "$cmdPath" == "$OROSHI_WORKTREES_DIR"/oroshi--* ]] && return 0

    echo ""
    local helpOutput="$("$name" --help 2>&1 | sed 's/^/ /')"
    colorize "$helpOutput" comment
    return 0
  fi

  echo " $type"
  echo ""

  # Which output
  which "$name" 2>/dev/null || true
}

function fzf-options() {
  echo "--prompt=$(fzf-options-prompt-label fzf-commands Commands yellow amber-dark)"
  echo "--preview=bin-zsh ctrl-b --preview {}"
  echo "--ansi"
}

function fzf-postprocess() {
  local input="$(cat)"
  [[ "$input" == "" ]] && return 0
  print -- "$input"
}

fzf-dispatch
