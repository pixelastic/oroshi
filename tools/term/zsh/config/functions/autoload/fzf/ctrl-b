# Search available commands, aliases, and functions with fzf
# Usage:
# $ ctrl-b                    # Interactive command search
# $ ctrl-b --source           # Print available commands (one per line)
# $ ctrl-b --options          # Print FZF options (one per line)
# $ ctrl-b --preview <name>    # Show type and location of a command
# $ ctrl-b --postprocess      # Read raw selection from stdin, print command name
setopt local_options err_return
local __lib="${functions_source[$0]:A:h}/__lib"
source "$__lib/init.zsh"
source "$__lib/fzf-options-prompt-label.zsh"

function fzf-source() {
  # Filter out commands that point to directories
  local -a cmds
  local k
  for k in ${(k)commands}; do
    [[ ! -d "$commands[$k]" ]] && cmds+=("$k")
  done

  print -l -- \
    "${cmds[@]}" ${(k)aliases} ${(k)galiases} ${(k)functions} \
    | grep -Ev '^(_|TRAP|-)' \
    | sort --unique
}

function fzf-preview-function-header() {
  local name="$1"
  local typeLabel="$2"
  colorize " $name" executable
  echo ""
  if [[ "$typeLabel" != "" ]]; then
    colorize " $typeLabel" comment
    echo ""
  fi
  echo ""
}

function fzf-preview-comment-block() {
  local filePath="$1"
  local fileContent="$(<"$filePath")"
  local line
  local started=0
  local commentBlock=""
  for line in "${(@f)fileContent}"; do
    # Skip shebang and #autoload directives
    [[ "$line" == "#!"* ]] && continue
    [[ "$line" == "#autoload"* ]] && continue
    # Skip empty lines and bare comment lines before content starts
    if [[ $started == 0 ]]; then
      [[ "$line" == "#" ]] && continue
      [[ "$line" == "" ]] && continue
    fi
    # Stop at first non-comment line
    [[ "$line" != "#"* ]] && break
    started=1
    # Strip leading "# " or "#" prefix
    line="${line#\#\# }"
    line="${line#\# }"
    line="${line#\#}"
    commentBlock+=" ${line}\n"
  done

  # Word-wrap and colorize
  local wrapWidth=$((${FZF_PREVIEW_COLUMNS:-60} - 2))
  local wrappedBlock="$(print -- "$commentBlock" | fold -s -w "$wrapWidth")"
  colorize "$wrappedBlock" comment
}

function fzf-preview() {
  local name="$1"
  local typeOutput="$(whence -w "$name" 2>/dev/null)"
  [[ "$typeOutput" == "" ]] && return 0

  # Type: strip "name: " prefix
  local type="${typeOutput##*: }"

  # Aliases aren't loaded in non-interactive shells; source them if needed
  if [[ "$type" == "none" ]]; then
    source "$OROSHI_ROOT/tools/term/zsh/config/aliases/index.zsh" 2>/dev/null
    typeOutput="$(whence -w "$name" 2>/dev/null)" || true
    type="${typeOutput##*: }"
  fi

  # Still unresolved: search fpath for the file
  if [[ "$type" == "none" ]]; then
    local funcSource=""
    local dir
    for dir in $fpath; do
      if [[ -f "$dir/$name" ]]; then
        funcSource="$dir/$name"
        break
      fi
    done

    colors-load-definitions

    # ZSH system fpath functions
    if [[ "$funcSource" == /usr/share/zsh/* ]]; then
      fzf-preview-function-header "$name" "zsh system function"
      fzf-preview-comment-block "$funcSource"
      return 0
    fi

    # No file found: show name + description if available
    fzf-preview-function-header "$name" ""
    local descOutput="$(binary-describe "$name")"
    if [[ "$descOutput" == "" ]]; then
      colorize " no description available" comment
      echo ""
    else
      local wrapWidth=$((${FZF_PREVIEW_COLUMNS:-60} - 2))
      local wrappedDesc="$(print -- "$descOutput" | fold -s -w "$wrapWidth" | sed 's/^/ /')"
      colorize "$wrappedDesc" comment
    fi
    return 0
  fi

  colors-load-definitions

  # Aliases: header + expansion
  if [[ "$type" == "alias" ]] || [[ "$type" == "global alias" ]]; then
    fzf-preview-function-header "$name" "$type"
    local expansion="$(whence "$name" 2>/dev/null)"
    colorize --reply " → " comment
    local coloredArrow="$REPLY"
    colorize --reply "$expansion" string
    echo "${coloredArrow}${REPLY}"
    return 0
  fi

  # For external commands, show colored path instead of type label
  if [[ "$type" == "command" ]]; then
    local cmdPath="$(whence -p "$name" 2>/dev/null)"
    [[ "$cmdPath" == "" ]] && return 0

    # Oroshi commands: header + file content
    if [[ "$cmdPath" == "$OROSHI_ROOT"/* ]] || [[ "$cmdPath" == "$OROSHI_WORKTREES_DIR"/oroshi--* ]]; then
      fzf-preview-function-header "$name" "oroshi command"
      bat \
        --paging=never \
        --style=numbers \
        --color=always \
        "$cmdPath"
      return 0
    fi

    # System commands: colored path + type label
    local dirPart="${cmdPath:h}"
    local filePart="${cmdPath:t}"
    colorize --reply " ${dirPart}/" directory
    local coloredDir="$REPLY"
    colorize --reply "$filePart" executable
    echo "${coloredDir}${REPLY}"
    colorize " system command" comment
    echo ""

    local descOutput="$(binary-describe "$name")"
    echo ""
    if [[ "$descOutput" == "" ]]; then
      colorize " no description available" comment
      echo ""
      return 0
    fi
    local wrapWidth=$((${FZF_PREVIEW_COLUMNS:-60} - 2))
    local wrappedDesc="$(print -- "$descOutput" | fold -s -w "$wrapWidth" | sed 's/^/ /')"
    colorize "$wrappedDesc" comment
    return 0
  fi

  # For oroshi autoloaded functions, show file content preview
  if [[ "$type" == "function" ]]; then
    local funcSource="${functions_source[$name]}"

    # For unloaded autoloaded functions, search fpath
    if [[ "$funcSource" == "" ]]; then
      local dir
      for dir in $fpath; do
        if [[ -f "$dir/$name" ]]; then
          funcSource="$dir/$name"
          break
        fi
      done
    fi

    # Oroshi autoloaded functions: header + file content
    if [[ "$funcSource" == "$OROSHI_ROOT"/* ]] || [[ "$funcSource" == "$OROSHI_WORKTREES_DIR"/oroshi--* ]]; then
      fzf-preview-function-header "$name" "autoloaded function"
      bat \
        --paging=never \
        --style=numbers \
        --color=always \
        "$funcSource"
      return 0
    fi

    # ZSH system functions: header + comment block
    if [[ "$funcSource" == /usr/share/zsh/* ]]; then
      fzf-preview-function-header "$name" "zsh system function"
      fzf-preview-comment-block "$funcSource"
      return 0
    fi
  fi

  # Builtins: header + description
  if [[ "$type" == "builtin" ]]; then
    fzf-preview-function-header "$name" "shell builtin"
    local descOutput="$(binary-describe "$name")"
    if [[ "$descOutput" == "" ]]; then
      colorize " no description available" comment
      echo ""
    else
      local wrapWidth=$((${FZF_PREVIEW_COLUMNS:-60} - 2))
      local wrappedDesc="$(print -- "$descOutput" | fold -s -w "$wrapWidth" | sed 's/^/ /')"
      colorize "$wrappedDesc" comment
    fi
    return 0
  fi

  # Fallback
  fzf-preview-function-header "$name" "$type"
}

function fzf-options() {
  echo "--prompt=$(fzf-options-prompt-label fzf-commands Commands yellow amber-dark)"
  echo "--preview=bin-zsh ctrl-b --preview {}"
  echo "--ansi"
}

function fzf-postprocess() {
  local input="$(cat)"
  [[ "$input" == "" ]] && return 0
  print -- "$input"
}

fzf-dispatch
