# Fuzzy pick a JS test file
# Usage:
# $ fzf-js-test                  # Interactive search
# $ fzf-js-test --source         # Print test files
# $ fzf-js-test --options        # Print FZF options (one per line)
# $ fzf-js-test --postprocess    # Read selection from stdin, print filepath
setopt local_options err_return
source "$OROSHI_ROOT/scripts/bin/fzf/__lib/init.zsh"
source "$OROSHI_ROOT/scripts/bin/fzf/__lib/fzf-colorize-path.zsh"
source "$OROSHI_ROOT/scripts/bin/fzf/__lib/fzf-options-files.zsh"
source "$OROSHI_ROOT/scripts/bin/fzf/__lib/fzf-fs-preview.zsh"

SEARCH_PATH="$(git-directory-root)"

function fzf-source() {
  local items="$(fd \
    --type file \
    --extension js \
    --full-path '/__tests__/' \
    --base-directory "$SEARCH_PATH" \
    | sort-filepaths)"
  [[ "$items" == "" ]] && return 0

  local item
  for item in ${(f)items}; do
    fzf-colorize-path "$item" "${SEARCH_PATH}/${item}"
    echo "${SEARCH_PATH}/${item}▮${REPLY}"
  done
}

function fzf-options() {
  fzf-options-files "bin-zsh fzf-js-test" "$SEARCH_PATH"
}

fzf-dispatch
