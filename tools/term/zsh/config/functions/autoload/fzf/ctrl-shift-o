# Search directories in current directory with fzf
# Usage:
# $ ctrl-shift-o                  # Interactive directory search
# $ ctrl-shift-o --source         # Print dirs as: absolute_path▮relative_path
# $ ctrl-shift-o --options        # Print FZF options (one per line)
# $ ctrl-shift-o --postprocess    # Read raw selection from stdin, print absolute path
setopt local_options err_return
source "${functions_source[$0]:A:h}/__lib/init.zsh"
source "${functions_source[$0]:A:h}/__lib/fzf-source-directories.zsh"
source "${functions_source[$0]:A:h}/__lib/fzf-options-prompt-directory.zsh"
source "${functions_source[$0]:A:h}/__lib/fzf-fs-preview.zsh"

function fzf-source() {
  fzf-source-directories "$PWD"
}

function fzf-options() {
  echo "--with-nth=2"
  echo "--scheme=path"
  echo "--tiebreak=pathname,chunk"
  echo "--preview=bin-zsh ctrl-shift-o --preview {1}"
  local prompt="$(fzf-options-prompt-directory "$PWD")"
  echo "--prompt=${prompt}"
}

fzf-dispatch
