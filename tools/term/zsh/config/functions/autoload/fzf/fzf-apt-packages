# Fuzzy search apt packages
# Usage:
# $ fzf-apt-packages                          # Interactive package search (all packages)
# $ fzf-apt-packages --installed              # Interactive search (installed only)
# $ fzf-apt-packages --source                 # Print all packages (one per line)
# $ fzf-apt-packages --source --installed     # Print installed packages (one per line)
# $ fzf-apt-packages --options                # Print FZF options (one per line)
# $ fzf-apt-packages --postprocess            # Read raw selection from stdin, print package name
setopt local_options err_return
source "${functions_source[$0]:A:h}/__lib/init.zsh"
source "${functions_source[$0]:A:h}/__lib/fzf-options-prompt-label.zsh"

# Custom flags beyond the standard 4
zparseopts -D -E \
  -installed=flagInstalled

local isInstalled=${#flagInstalled}

function fzf-preview() {
  local packageName="$1"
  local rawDetails="$(apt-cache show "$packageName" 2>/dev/null)"
  [[ "$rawDetails" == "" ]] && return 0

  colors-load-definitions

  # Parse version and description from apt-cache output
  local packageVersion=""
  local packageDescription=()
  local isInDescription="0"
  for line in ${(f)rawDetails}; do
    # Keep adding to the description
    if [[ $isInDescription == "1" ]]; then
      # All descriptions start with a space; otherwise we're past it
      if [[ $line[1] != " " ]]; then
        isInDescription="0"
        continue
      fi
      packageDescription+=($line)
      continue
    fi

    # Get the version
    if [[ $line == Version:* ]]; then
      packageVersion=${${=line}[2]}
      continue
    fi

    # Start the description
    if [[ $line == Description* ]]; then
      local split=(${(@s/:/)line})
      packageDescription+=(${split[@]:1})
      isInDescription="1"
      continue
    fi
  done

  # Header: name + version
  echo "$(colorize " $packageName" $COLORS[function]) v${packageVersion}"

  # Installed indicator
  if apt-is-installed "$packageName"; then
    colorize " ✔ Installed" $COLORS[success]
  fi

  echo ""

  # Description
  local packageDescriptionText="${(F)packageDescription}"
  [[ "$packageDescriptionText" != "" ]] && colorize "${packageDescriptionText}" $COLORS[comment]
}

function fzf-cache-file() {
  local path="${OROSHI_TMP_FOLDER}/fzf/packages-apt"
  [[ $isInstalled == "1" ]] && path="${OROSHI_TMP_FOLDER}/fzf/packages-apt-installed"
  echo "$path"
}

function fzf-source() {
  local cacheFile="$(fzf-cache-file)"

  # Generate cache if missing
  if [[ ! -r $cacheFile ]]; then
    apt-packages-cache-generate
  fi

  cat "$cacheFile"
}

function fzf-options() {
  icons-load-definitions
  colors-load-definitions

  echo "--with-nth=2"

  # Prompt: f5 hint badge + Packages label
  local f5Badge="$(colorize " $ICONS[fzf-refresh] f5 " $COLORS[white] $COLORS[keybinding])"
  local prompt="${f5Badge}$(fzf-options-prompt-label package Packages yellow yellow-dark)"
  echo "--prompt=${prompt}"

  echo "--preview=bin-zsh fzf-apt-packages --preview {1}"

  # Show loading header while cache is being built (cleared when items finish loading)
  local cacheFile="$(fzf-cache-file)"
  if [[ ! -r $cacheFile ]]; then
    echo "--header=Building package cache, please wait…"
  fi
  echo "--bind=load:change-header()"

  # f5: delete cache, rebuild, reload
  local sourceArgs=""
  [[ $isInstalled == "1" ]] && sourceArgs=" --installed"
  local reloadCmd="rm -f ${cacheFile}; apt-packages-cache-generate >/dev/null 2>&1; bin-zsh fzf-apt-packages --source${sourceArgs}"
  local refreshIcon="$ICONS[fzf-refresh]"
  local bindAction="transform-header(echo ' $refreshIcon Rebuilding package cache, please wait…')"
  bindAction+="+reload($reloadCmd)"
  echo "--bind=f5:${bindAction}"
}

fzf-dispatch
