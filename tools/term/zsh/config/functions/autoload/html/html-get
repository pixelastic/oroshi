# Extract content from an HTML file using CSS selectors
# Usage:
# $ html-get source.html ".litem_name a"           # Output JSON structure
# $ html-get source.html ".litem_name a" href       # Output attributes as list
# $ cat source.html | html-get ".litem_name a"      # Pipe input
setopt local_options err_return

if [[ $# == 0 ]]; then
  echo 'Usage:'
  echo '  html-get source.html {css_selector} [{json_path}]'
  echo '  cat source.html | html-get {css_selector} [{json_path}]'
  return 1
fi

local input="$1"
local selector="$2"
local jsonPath="$3"

# If first argument is not a file, we assume we're piping content
if [[ ! -f $input ]]; then
  input="-"
  selector="$1"
  jsonPath="$2"
fi

local asJson=$(cat $input | pup "${selector} json{}")

if [[ $jsonPath ]]; then
  echo $asJson | jq -r ".[].\"${jsonPath}\""
else
  echo $asJson
fi
