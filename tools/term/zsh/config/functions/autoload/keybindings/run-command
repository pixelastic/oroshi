# Run a command from a keybinding as if it was typed and submitted, so it enters the history and its output can be retrieved
# Usage (inside a zle widget):
# $ run-command vcaa   # Submit it, the typed line comes back at the next prompt
setopt local_options err_return

# Nothing to run without a command
[[ "$1" == "" ]] && return 1

# Stash the typed line, it comes back at the next prompt
zle push-input
BUFFER="$*"
zle accept-line
