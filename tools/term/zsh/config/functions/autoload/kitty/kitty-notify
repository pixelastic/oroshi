# Add a Notification Marker (if tab not focused) and play a sound
# Usage:
# $ kitty-notify                          # Marker + default sound
# $ kitty-notify --sound claude-stop.mp3  # Marker + custom sound
# $ kitty-notify --sound no               # Marker only, no sound
setopt local_options err_return

zparseopts -E -D \
  -sound:=flagSound

local sound=${flagSound[2]:-notification.mp3}

# Add Notification Marker only when tab is not focused
function _notify-marker() {
  local tabId="$(kitty-window-tab-id)"
  kitty-tab-focused "$tabId" && return

  kitty-tab-notification-add "$tabId"
}

# Play sound unless disabled
function _notify-sound() {
  [[ "$sound" == "no" ]] && return

  audio-play-oroshi "$sound"
}

_notify-marker || true
_notify-sound || true

return 0
