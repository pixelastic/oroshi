# Save the current kitty session to disk, silently and atomically
# Usage:
# $ kitty-session-save            # Silent save, no confirmation
# $ kitty-session-save --flash    # Save with a green flash confirmation
setopt local_options err_return

zparseopts -E -D \
  -flash=flagFlash

local isFlash=${#flagFlash}

# Nothing to save if no live Kitty answers remote control
kitty-is-running || return 0

local dumpDir="$OROSHI_FOLDER_STATE/kitty"
local dumpPath="$dumpDir/session.kitty-session"
mkdir -p "$dumpDir"
local tmpPath="$(mktemp "$dumpDir/session.kitty-session.XXXXXX")"

# Flash all windows green with --flash
if [[ $isFlash == 1 ]]; then
  colors-load-definitions
  kitty-remote set-colors \
    --all \
    background="$COLORS[green-0:hex]"
fi

# Atomic save
kitty-remote action save_as_session \
  --save-only "$tmpPath"
mv "$tmpPath" "$dumpPath"

# Reset colors
if [[ $isFlash == 1 ]]; then
  kitty-remote set-colors \
    --all \
    --reset
fi

return 0
