# Prompt for one command and add it to the Claude Code skills allowlist
# Meant to run inside a Kitty popup (see alt+s in keybindings.conf)
# Usage:
# $ popup-skala    # Type a command; Enter adds it, Escape/Ctrl-C/Ctrl-D cancels
setopt local_options err_return

local prompt="Add to allowlist: "
local typed=""
local key

while true; do
  printf '\r\e[K%s%s' "$prompt" "$typed"

  # Input closed (Ctrl-D, end of input): cancel
  # -u0 reads stdin; plain -k insists on a terminal
  read -rsk1 -u0 key || return 0

  # Escape, Ctrl-C and Ctrl-D cancel without running anything
  [[ "$key" == $'\e' || "$key" == $'\x03' || "$key" == $'\x04' ]] && return 0

  # Enter validates
  [[ "$key" == $'\n' || "$key" == $'\r' ]] && break

  # Backspace removes the last character
  if [[ "$key" == $'\x7f' || "$key" == $'\b' ]]; then
    typed="${typed%?}"
    continue
  fi

  typed+="$key"
done
printf '\n'

# Nothing to add
[[ "$typed" == "" ]] && return 0

# skala is an alias of skills-allowlist-add, and aliases do not exist in a popup process
if ! skills-allowlist-add "$typed"; then
  echoerr "Could not add to allowlist: $typed"
  echoerr "Press any key to close"
  read -rsk1 -u0 || true
  return 1
fi
