# Given a path to a Python source file, return the absolute path to its pytest test file
# Usage:
# $ python-test-path ./path/to/module.py                 # → /abs/path/to/__tests__/test_module.py
# $ python-test-path ./path/to/__tests__/test_module.py  # Test file, returned as-is (absolute)
setopt local_options err_return

# No argument provided
[[ "$1" == "" ]] && return 1

local filePath="${1:a}"

# If the file is already a pytest test file, return it directly
if [[ "${filePath:h:t}" == "__tests__" && "${filePath:t}" == test_*.py ]]; then
  [[ ! -f "$filePath" ]] && return 1
  echo "$filePath"
  return 0
fi

local testFile="${filePath:h}/__tests__/test_${filePath:t:r}.py"

# No matching test file
[[ ! -f "$testFile" ]] && return 1

echo "$testFile"
