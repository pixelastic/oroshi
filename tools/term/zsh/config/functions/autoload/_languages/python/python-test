# Run pytest on the test files of the given files or directories
# Usage:
# $ python-test ./path/to/test_file.py              # Run a single test file
# $ python-test ./path/to/module.py                 # Source file → resolved via python-test-path
# $ python-test ./path/to/tests/                    # Run all tests in a directory
# $ python-test module.py __tests__/test_module.py  # Mixed inputs (deduplicated)
# $ python-test --fail-fast ./path/to/tests/        # Stop at the first failing test
setopt local_options err_return

zparseopts -E -D -fail-fast=flagFailFast

local isFailFast=${#flagFailFast}

# Expand directories, filter to Python files, map to test files
local expanded="$(file-expand --filter is-python --map python-test-path "$@")"

# No testable files found
[[ "$expanded" == "" ]] && return 0

# Deduplicate: a source file and its test file resolve to the same test
local -aU testFiles=("${(@f)expanded}")

local pytestArgs=(--spec --no-header)
[[ $isFailFast == 1 ]] && pytestArgs+=(--exitfirst)

pytest \
  "${pytestArgs[@]}" \
  "${testFiles[@]}" 2>&1
