# Fix Python files by formatting them and applying ruff autofixes
# Usage:
# $ python-fix ./path/to/file.py                          # Fix file in place
# $ python-fix file1.py file2.py                          # Fix multiple files in place
# $ python-fix ./pkg/                                     # Expand directory, fix all Python files
# $ python-fix --stdout ./path/to/file.py                 # Output fixed code to stdout
# $ python-fix --original-path /real/path.py /tmp/file.py # Resolve config from real path
# $ python-fix --original-path /real/path.py --stdout /tmp/file.py # Same, output to stdout
setopt local_options err_return

zparseopts -E -D \
  -stdout=flagStdout \
  -original-path:=flagOriginalPath
local isStdout=${#flagStdout}
local originalPath="${flagOriginalPath[2]}"

# --stdout and --original-path only work with a single file
if [[ ($isStdout -eq 1 || "$originalPath" != "") && ($# -ne 1 || -d "$1") ]]; then
  echoerr "Error: --stdout and --original-path require a single file argument"
  return 1
fi

# Expand directories, resolve file list
local expanded="$(file-expand --filter is-python "$@")"

# Nothing to fix
[[ "$expanded" == "" ]] && return 0
local -a files=("${(@f)expanded}")

# In-place mode: ruff resolves the config from each file
# Autofixes run first, so the formatter normalizes what they leave behind
if [[ $isStdout -eq 0 && "$originalPath" == "" ]]; then
  # Remaining violations are reported by python-lint, not here
  ruff check \
    --fix \
    --exit-zero \
    --quiet \
    "${files[@]}" >/dev/null || return 1
  ruff format "${files[@]}" >/dev/null || return 1
  return 0
fi

# Single file mode: pipe the code through ruff so the config is resolved
# from the original path
local file="${files[1]}"
[[ "$originalPath" == "" ]] && originalPath="${file:a}"
local fixed
local formatted
fixed="$(ruff check \
  --fix \
  --exit-zero \
  --quiet \
  --stdin-filename "$originalPath" \
  <"$file")" || return 1
formatted="$(printf '%s\n' "$fixed" | ruff format --stdin-filename "$originalPath")" || return 1

# Stdout mode: print the fixed code, leave the file untouched
if [[ $isStdout -eq 1 ]]; then
  printf '%s\n' "$formatted"
  return 0
fi

printf '%s\n' "$formatted" >"$file"
