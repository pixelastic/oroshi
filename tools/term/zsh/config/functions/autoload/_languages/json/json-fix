# Fix JSON files via prettier→eslint→prettier chain
# Usage:
# $ json-fix ./path/to/file.json                          # Fix file in place
# $ json-fix file1.json file2.json                        # Fix multiple files in place
# $ json-fix ./src/                                       # Expand directory, fix all JSON files
# $ json-fix --stdout ./path/to/file.json                 # Output fixed code to stdout
# $ json-fix --original-path /real/path.json /tmp/file.json # Resolve config from real path
setopt local_options err_return

local scriptDirectory="${functions_source[$0]:A:h}"
source "$scriptDirectory/../javascript/__lib/prettier-fix.zsh"
source "$scriptDirectory/../javascript/__lib/eslint-fix.zsh"

zparseopts -E -D \
  -stdout=flagStdout \
  -original-path:=flagOriginalPath
local isStdout=${#flagStdout}
local originalPath="${flagOriginalPath[2]}"

local hasOriginalPath=0
[[ "$originalPath" != "" ]] && hasOriginalPath=1
local isSingleFileOnly=$(( isStdout == 1 || hasOriginalPath == 1 ))
local hasMultipleInputs=$(( $# != 1 ))
local isDirectory=0
[[ -d "$1" ]] && isDirectory=1

# --stdout and --original-path only work with a single file, not directories
[[ $isSingleFileOnly -eq 1 && $hasMultipleInputs -eq 1 ]] && return 1
[[ $isSingleFileOnly -eq 1 && $isDirectory -eq 1 ]] && return 1

# Expand directories, resolve file list
local expanded="$(file-expand --filter is-json "$@")"
local -a files=("${(@f)expanded}")

# Stdout mode: swap the file for a temp copy
local temporaryFile=""
if [[ $isStdout -eq 1 ]]; then
  temporaryFile="$(mktemp)"
  cp "${files[1]}" "$temporaryFile"
  files=("$temporaryFile")
fi

# Build --original-path args if set
local -a originalPathArgs=()
[[ $hasOriginalPath -eq 1 ]] && originalPathArgs=(--original-path "$originalPath")

# If inputs contain package.json files, they need to be handled specifically:
local -a packageFiles=(${(M)files:#(*/|)package.json})
[[ "${originalPath:t}" == "package.json" ]] && packageFiles=("${files[@]}")
local -a otherFiles=(${files:|packageFiles})

# If input is mixed, we need to call json-fix recursively again on each group
if [[ ${#packageFiles} -gt 0 && ${#otherFiles} -gt 0 ]]; then
  json-fix "${packageFiles[@]}"
  json-fix "${otherFiles[@]}"
  return 0
fi

# Yarn rewrites package.json using JSON.stringify on each `yarn install` or
# `yarn add` command, so we need to consider this as the "right" formatting.
# Every other file will use prettier `json` formatter
local parser=json
[[ ${#packageFiles} -gt 0 ]] && parser=json-stringify

# Step 1: Format with prettier
prettier-fix --parser "$parser" "${originalPathArgs[@]}" "${files[@]}"

# Step 2: Fix the content with ESLint
eslint-fix "${originalPathArgs[@]}" "${files[@]}"

# Step 3: Format with prettier again, to normalize what ESLint changed
prettier-fix --parser "$parser" "${originalPathArgs[@]}" "${files[@]}"

# Stdout mode: output and cleanup
if [[ "$temporaryFile" != "" ]]; then
  cat "$temporaryFile"
  rm -f "$temporaryFile"
fi
