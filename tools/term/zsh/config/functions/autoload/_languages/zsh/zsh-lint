# Lint one or more ZSH files or directories
# Orchestrator: merges zsh-lint-shellcheck, zsh-lint-syntax and zsh-lint-custom
# Default output is stylish format (violations grouped by file)
# Usage:
# $ zsh-lint file.zsh                  # Stylish output (default)
# $ zsh-lint --json file.zsh           # Unified JSON output
# $ zsh-lint --fix file.zsh            # Auto-format via zsh-fix, then lint
# $ zsh-lint src/                      # Expand directory, lint all ZSH files
# $ zsh-lint file.zsh other-file.zsh   # Multiple files
#
# Shellcheck does not support zsh by default, but many of the warning triggered
# on bash also apply on zsh, so we simply silence the ones that are not relevant.
setopt local_options err_return

local scriptDir="${functions_source[$0]:A:h}"

source "$scriptDir/__lib/zsh-lint-shellcheck.zsh"
source "$scriptDir/__lib/zsh-lint-syntax.zsh"
source "$scriptDir/__lib/zsh-lint-custom.zsh"

zparseopts -E -D \
  -fix=flagFix \
  -json=flagJson
local isFix=${#flagFix}
local isJson=${#flagJson}

# No inputs provided
if [[ $# -eq 0 ]]; then
  echoerr "Error: No files provided"
  return 1
fi

# Expand directories and filter to ZSH files
local expanded="$(file-expand --filter is-zsh "$@")"
if [[ "$expanded" == "" ]]; then
  [[ $isJson == 1 ]] && printf '[]\n'
  return 0
fi
local -a files=("${(@f)expanded}")

# Fix mode: format first, then fall through to lint
if [[ $isFix == 1 ]]; then
  zsh-fix "${files[@]}"
fi

# Merge sub-linters output into one JSON array
local result="$(jq --compact-output --slurp 'add // []' \
  <(zsh-lint-shellcheck "${files[@]}") \
  <(zsh-lint-syntax "${files[@]}") \
  <(zsh-lint-custom "${files[@]}"))"

# JSON mode: output raw JSON
if [[ $isJson == 1 ]]; then
  printf '%s\n' "$result"
  [[ "$result" != "[]" ]] && return 1
  return 0
fi

# Stylish mode (default), paths relative to git root (or $PWD outside a repo)
local projectRoot="$(git-directory-root)"
printf '%s' "$result" | json2stylish --root "$projectRoot/"
