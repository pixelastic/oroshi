# Run BATS tests for the given ZSH files, BATS files or directories
# Usage:
# $ zsh-test ./misc/slugify                  # Run misc/__tests__/slugify.bats
# $ zsh-test ./misc/__tests__/slugify.bats   # Run the test file directly
# $ zsh-test file1.zsh file2.zsh             # Multiple files (deduplicated)
# $ zsh-test ./misc/                         # Expand directory, run all its tests
# $ zsh-test --fail-fast ./misc/             # Stop at the first failing test
# $ zsh-test --token-saving ./misc/          # Show only failures, or "All tests passed."
setopt local_options err_return

zparseopts -E -D -- -fail-fast=flagFailFast -token-saving=flagTokenSaving

local isFailFast=${#flagFailFast}
local isTokenSaving=${#flagTokenSaving}

# No arguments: nothing to test
[[ $# -eq 0 ]] && return 0

# Expand directories, map ZSH sources and BATS files to their test files
local -aU testFiles=(
  ${(f)"$(file-expand --filter is-zsh --map zsh-test-path "$@")"}
  ${(f)"$(file-expand --filter is-bats --map zsh-test-path "$@")"}
)

# No test files found
[[ ${#testFiles[@]} -eq 0 ]] && return 0

# bats --jobs needs GNU parallel (installed by tools/basics/parallel/install)
if ! command -v parallel >/dev/null; then
  print -u2 "zsh-test: GNU parallel is required, run tools/basics/parallel/install"
  return 1
fi

local batsArgs=(--jobs "$(nproc)")
# --abort only stops at the first failure when the tests of a file run in series
[[ $isFailFast == 1 ]] && batsArgs+=(--abort --no-parallelize-within-files)

# Full bats output, exit code is bats's
if [[ $isTokenSaving -eq 0 ]]; then
  bats "${batsArgs[@]}" "${testFiles[@]}"
  return $?
fi

# Token saving: run bats in TAP format, keep failures only
local exitCode=0
local tapOutput=""
tapOutput="$(bats --tap "${batsArgs[@]}" "${testFiles[@]}")" || exitCode=$?
local failureLines=(${${(f)tapOutput}:#(ok *|1..*)})

# Everything passed
if [[ $exitCode -eq 0 ]]; then
  print "All tests passed."
  return 0
fi

# Failed without any TAP failure line (e.g. bats crashed): show it all
[[ ${#failureLines[@]} -eq 0 ]] && failureLines=(${(f)tapOutput})

print -l -- "${failureLines[@]}"
return $exitCode
