# Fix ZSH files by applying beautysh formatting
# Usage:
# $ zsh-fix ./path/to/file.zsh                                 # Fix file in place
# $ zsh-fix file1.zsh file2.zsh                                # Fix multiple files in place
# $ zsh-fix ./functions/                                       # Expand directory, fix all ZSH files
# $ zsh-fix --stdout ./path/to/file.zsh                        # Output fixed code to stdout
# $ zsh-fix --original-path /real/my-func .conform.123.my-func # Detect ZSH from real path
setopt local_options err_return

zparseopts -E -D \
  -stdout=flagStdout \
  -original-path:=flagOriginalPath
local isStdout=${#flagStdout}
local originalPath="${flagOriginalPath[2]}"

# --stdout and --original-path only work with a single file
local isSingleFileMode=0
[[ $isStdout -eq 1 || "$originalPath" != "" ]] && isSingleFileMode=1
[[ $isSingleFileMode -eq 1 && ( $# -ne 1 || -d "$1" ) ]] && return 1

# Expand directories, keep only ZSH files
local expanded="$(file-expand --filter is-zsh "$@")"
# Temp copies (e.g. .conform.123.my-func) can hide the language: trust the real path
if [[ "$originalPath" != "" ]] && is-zsh "$originalPath"; then
  expanded="${1:a}"
fi

# No ZSH files to fix
[[ "$expanded" == "" ]] && return 0
local -a files=("${(@f)expanded}")

# In-place mode: format the files directly
if [[ $isStdout -eq 0 ]]; then
  beautysh \
    --indent-size 2 \
    --force-function-style fnpar \
    "${files[@]}"
  return 0
fi

# Stdout mode: format a temp copy, output it, remove it
local temporaryFile="$(mktemp)"
cp "${files[1]}" "$temporaryFile"
# beautysh failed: remove the temp copy before failing
if ! beautysh \
  --indent-size 2 \
  --force-function-style fnpar \
  "$temporaryFile"; then
  rm -f "$temporaryFile"
  return 1
fi
cat "$temporaryFile"
rm -f "$temporaryFile"
