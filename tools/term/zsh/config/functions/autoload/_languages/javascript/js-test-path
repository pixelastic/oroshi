# Given a path to a JS source file, return the path to its test file
# Usage:
# $ js-test-path ./path/to/module.js           # → ./path/to/__tests__/module.js
# $ js-test-path ./path/to/__tests__/module.js # Test file, returned as-is
setopt local_options err_return

local filePath="$1"

# No argument provided
[[ "$filePath" == "" ]] && return 1

local parentDir="${filePath:h:t}"

# Not a JS file
is-js "$filePath" || return 1

# If the file is already a test (in __tests__), return it directly
if [[ "$parentDir" == "__tests__" ]]; then
  [[ ! -f "$filePath" ]] && return 1
  echo "$filePath"
  return
fi

local testFile="${filePath:h}/__tests__/${filePath:t}"

# No matching test file
[[ ! -f "$testFile" ]] && return 1

echo "$testFile"
