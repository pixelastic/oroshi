# Run custom rules on Lua files, output violations in file▮code▮level▮line▮message format
# Usage:
# $ lua-lint-custom file.lua
setopt local_options err_return

local dir="${functions_source[$0]:A:h}"
source "$dir/__rules/rule-no-vim-deepcopy.zsh"

local -a _RULES=(
  luaLintRule_noVimDeepcopy
)

export _SEP=$'\u25ae'

local -a violations=()
local out
local rule
for rule in $_RULES; do
  out="$($rule "$1")"
  [[ "$out" != "" ]] && violations+=("${(@f)out}")
done

for v in "${violations[@]}"; do
  printf '%s\n' "$v"
done

[[ ${#violations} -gt 0 ]] && return 1
return 0
