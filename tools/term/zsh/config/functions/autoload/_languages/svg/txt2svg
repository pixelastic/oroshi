# Generate an SVG illustration from a text description using Claude
# Usage:
# $ txt2svg "A colored butterfly next to a rose"          # → a-colored-butterfly-next-to-a-rose.svg
# $ txt2svg --output butterfly.svg "A butterfly"           # → butterfly.svg
setopt local_options err_return

zparseopts -E -D -output:=flagOutput

local prompt="$1"

if [[ "$prompt" == "" ]]; then
  echoerr "Usage: txt2svg [--output <file>] <prompt>"
  return 1
fi

local systemPrompt="Generate an SVG illustration. Output only valid SVG markup, no explanation."

echoerr "txt2svg: calling Claude API..."
local svgContent
if ! svgContent=$(claude-api --system "$systemPrompt" "$prompt"); then
  echoerr "txt2svg: claude-api failed"
  return 1
fi

# Guard: empty response
if [[ "$svgContent" == "" ]]; then
  echoerr "txt2svg: claude-api returned empty response"
  return 1
fi

# Strip markdown fences Claude may wrap around the SVG
echoerr "txt2svg: stripping markdown fences..."
svgContent=$(echo "$svgContent" | sed '/^```/d')

local tmpFile=$(mktemp --suffix=.svg)
echo "$svgContent" > "$tmpFile"

local maxAttempts=3
local attempt=0
while (( attempt < maxAttempts )); do
  attempt=$((attempt + 1))

  # Fix (may fail on broken XML) then lint
  echoerr "txt2svg: fixing SVG..."
  svg-fix "$tmpFile" 2>/dev/null || true
  echoerr "txt2svg: linting SVG..."
  local lintOutput=$(svg-lint --json "$tmpFile" 2>/dev/null)
  local issueCount=$(echo "$lintOutput" | jq 'length')

  # Clean SVG — done
  [[ "$issueCount" == "0" ]] && break

  # Max retries reached — fail with lint details
  if (( attempt >= maxAttempts )); then
    echoerr "txt2svg: still $issueCount lint issues after $maxAttempts attempts:"
    echoerr "$lintOutput"
    rm -f "$tmpFile"
    return 1
  fi

  # Ask Claude to fix the lint issues
  echoerr "txt2svg: $issueCount lint issues, asking Claude to fix" \
    "(attempt $attempt/$maxAttempts)..."
  local currentSvg=$(cat "$tmpFile")
  local fixPrompt="Fix these XML/SVG lint errors. Output only the corrected SVG, no explanation.

Errors:
$lintOutput

SVG:
$currentSvg"

  local fixedSvg
  if ! fixedSvg=$(claude-api --system "$systemPrompt" "$fixPrompt"); then
    echoerr "txt2svg: claude-api fix attempt failed"
    rm -f "$tmpFile"
    return 1
  fi

  # Strip fences and write back
  fixedSvg=$(echo "$fixedSvg" | sed '/^```/d')
  echo "$fixedSvg" > "$tmpFile"
done

# Determine output path
local outputPath="${flagOutput[2]}"
if [[ "$outputPath" == "" ]]; then
  # Slugify first 5 words of prompt to generate filename
  outputPath=$(echo "$prompt" | awk '{for(i=1;i<=5&&i<=NF;i++) printf "%s ", $i}' | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//')
  outputPath="${outputPath}.svg"
fi

mv "$tmpFile" "$outputPath"
echoerr "txt2svg: saved to $outputPath"
echo "$outputPath"
