# Convert a Markdown file to a Google Docs document
# Usage:
# $ md2gdoc file.md
# $ md2gdoc --title "Custom Title" file.md
# $ md2gdoc --no-open file.md
setopt local_options err_return

local libDir="${functions_source[$0]:A:h}/__lib"
local referenceDoc="${libDir:h:h:h}/api/google/gdoc/__config/reference.docx"
OROSHI_MD2GDOC_REFERENCE_DOC="$referenceDoc" node "${libDir}/bin/md2gdoc.js" "$@"
