# Lint one or more BATS files
# Orchestrator: merges bats-lint-shellcheck and bats-lint-custom
# Default output is stylish format (violations grouped by file)
# Usage:
# $ bats-lint file.bats              # Stylish output (default)
# $ bats-lint --json file.bats       # Unified JSON output
# $ bats-lint file.bats other.bats   # Multiple files
setopt local_options err_return

local scriptDir="${functions_source[$0]:A:h}"

source "$scriptDir/__lib/bats-lint-shellcheck.zsh"
source "$scriptDir/__lib/bats-lint-custom.zsh"

zparseopts -E -D \
  -json=flagJson
local isJson=${#flagJson}

# Keep only valid bats files
local -a valid=()
local -a invalid=()
for item in "$@"; do
  # Skip directories
  [[ -d $item ]] && continue
  # Keep track of non-bats files
  if ! is-bats "$item"; then
    invalid+=("$item")
    continue
  fi

  valid+=("$item")
done

# No files
if [[ ${#valid[@]} -eq 0 && ${#invalid[@]} -eq 0 ]]; then
  [[ $isJson == 1 ]] && printf '[]\n'
  return 0
fi

# Generate notBats violations for non-bats files
local invalid_json='[]'
if [[ ${#invalid[@]} -gt 0 ]]; then
  invalid_json="$(
    for file in "${invalid[@]}"; do
      jq -n --arg f "$file" '{
        file:$f, code:"notBats", level:"error",
        line:1, endLine:1, column:1, endColumn:1,
        message:"Not a bats file"
      }'
    done | jq -cs '.'
  )"
fi

# Run sub-linters on valid bats files
local valid_json='[]'
if [[ ${#valid[@]} -gt 0 ]]; then
  valid_json="$(jq -cs 'add // []' \
    <(bats-lint-shellcheck "${valid[@]}") \
    <(bats-lint-custom "${valid[@]}"))"
fi

# Merge sub-linters output into one JSON array
local merged="$(jq -cs 'add // []' <(printf '%s' "$invalid_json") <(printf '%s' "$valid_json"))"

# JSON mode: output raw JSON
if [[ $isJson == 1 ]]; then
  printf '%s\n' "$merged"
  [[ "$merged" != "[]" ]] && return 1
  return 0
fi

# Stylish mode (default), paths relative to git root (or $PWD outside a repo)
local projectRoot="$(git-directory-root)"
printf '%s' "$merged" | json2stylish --root "$projectRoot/"
