# Lint one or more Go files or directories via golangci-lint
# Default output is stylish format (violations grouped by file)
# Usage:
# $ go-lint ./path/to/file.go          # Stylish output (default)
# $ go-lint --json ./path/to/file.go   # Unified JSON output
# $ go-lint --fix ./path/to/file.go    # Auto-fix then report remaining
# $ go-lint ./path/to/dir/             # Expand directory to Go files
# $ go-lint file1.go file2.go          # Multiple files
setopt local_options err_return

zparseopts -E -D \
  -fix=flagFix \
  -json=flagJson
local isFix=${#flagFix}
local isJson=${#flagJson}

# No inputs provided
if [[ $# -eq 0 ]]; then
  echoerr "Error: No files provided"
  return 1
fi

# Expand directories and filter to Go files
local expanded="$(file-expand --filter is-go "$@")"
if [[ "$expanded" == "" ]]; then
  [[ $isJson == 1 ]] && printf '[]\n'
  return 0
fi
local -a inputs=("${(@f)expanded}")

# Resolve inputs to absolute paths and validate
for i in {1..${#inputs}}; do
  inputs[$i]="${inputs[$i]:a}"
  if [[ ! -e "${inputs[$i]}" ]]; then
    echoerr "Error: '${inputs[$i]}' not found"
    return 1
  fi
done

# Go linter works per-directory, not per-file
# Deduplicated directories to pass to golangci-lint
local -aU packageDirs=()
for input in "${inputs[@]}"; do
  if [[ -d "$input" ]]; then
    packageDirs+=("$input")
    continue
  fi
  packageDirs+=("${input:h}")
done

# Resolve the linter binary and the target module
local lintBin="$(go-tool-path golangci-lint)"
local moduleRoot="$(go-module-root "${packageDirs[1]}")"

# Run golangci-lint from the module root with extra args
function _runLint() {
  pushd "$moduleRoot" >/dev/null
  "$lintBin" run "$@" "${packageDirs[@]}" 2>/dev/null
  popd >/dev/null
}

# Build output filter prefixes from inputs relative to module root
# golangci-lint outputs paths relative to module root, so we match the same way
# - File inputs become "main.go:" (colon = exact file match)
# - Dir inputs become "pkg/" (slash = everything under that dir)
# - Module root dir becomes "" (empty = matches everything)
local allowedPrefixes=()
for input in "${inputs[@]}"; do
  local relativePath="${input#"$moduleRoot"}"
  relativePath="${relativePath#/}"
  if [[ -d "$input" ]]; then
    [[ "$relativePath" != "" ]] && relativePath="${relativePath}/"
  else
    relativePath="${relativePath}:"
  fi
  allowedPrefixes+=("$relativePath")
done

# --fix: auto-fix first, then fall through to report
if [[ $isFix == "1" ]]; then
  _runLint --fix || true
fi

# Get golangci-lint JSON output (\grep bypasses rg alias, extracts the JSON line)
local jsonOutput="$(_runLint --output.json.path stdout --output.text.path /dev/null | \grep '^{')"
local prefixesJson="$(json-array "${allowedPrefixes[@]}")"

# Filter to keep only violations from the initially requested files/directories,
# then reshape from golangci-lint format to our unified lint format
# (same as zsh-lint and bats-lint)
local result="$(printf '%s' "$jsonOutput" | jq \
  --argjson prefixes "$prefixesJson" \
  --arg root "$moduleRoot/" \
'[.Issues // [] | .[]
    | select(.Pos.Filename + ":" | . as $f | $prefixes | any(. as $p | $f | startswith($p)))
    | {
      file: ($root + .Pos.Filename),
      code: (if (.Text | test("^[A-Za-z0-9_-]+: "))
        then (.Text | capture("^(?<c>[A-Za-z0-9_-]+): ") | .c)
        else .FromLinter end),
      level: (.Severity
        | if . == "" then "error"
          elif . == "warning" then "warn"
          else . end),
      line: .Pos.Line,
      column: .Pos.Column,
      message: (if (.Text | test("^[A-Za-z0-9_-]+: "))
        then (.Text | sub("^[A-Za-z0-9_-]+: "; ""))
        else .Text end)
    }]')"

# JSON mode: output raw JSON
if [[ $isJson == 1 ]]; then
  printf '%s\n' "$result"
  [[ "$result" != "[]" ]] && return 1
  return 0
fi

# Stylish mode (default): format as grouped violations
# No violations → no output
[[ "$result" == "[]" ]] && return 0

local stylish="$(printf '%s' "$result" | jq -r --arg root "$moduleRoot/" '
  group_by(.file)
  | map(
      (map("\(.line):\(.column)" | length) | max) as $lcw
    | (map(.level | length) | max) as $lw
    | (.[0].file | ltrimstr($root)) + "\n" +
      (map(
        "  " +
        ("\(.line):\(.column)" | . + (" " * ($lcw - length))) +
        "  " +
        (.level + (" " * ($lw - (.level | length)))) +
        "  " +
        .message +
        "  " +
        .code
      ) | join("\n"))
    )
  | join("\n\n")')"

printf '%s\n' "$stylish"
return 1
