# Select one line out of a multi-line text and return it
# Usage:
# $ text-line-get $myText $myLine
# $ echo $myText | text-line-get $myLine
setopt local_options err_return

local text="$1"
local index="$2"

# Read from pipe
if [[ -p /dev/stdin ]]; then
  text="$(/usr/bin/cat -)"
  index="$1"
fi

echo "$text" | sed -n "${index}p"
