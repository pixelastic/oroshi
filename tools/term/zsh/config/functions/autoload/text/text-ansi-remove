# Remove ANSI escape sequences from text
# Usage:
# $ text-ansi-remove "Hello [33mWorld[0m"          # "Hello World"
# $ echo "Hello [33mWorld[0m" | text-ansi-remove   # "Hello World"
# $ text-ansi-remove --reply "colored text"        # Write to $REPLY, no echo
setopt local_options err_return extendedglob

zparseopts -E -D \
  -reply=flagReply

local input="$1"
# Read from pipe
[[ -p /dev/stdin ]] && input="$(/usr/bin/cat -)"

local result="${input//$'\033'\[[0-9;]#[A-Za-z]/}"

if [[ ${#flagReply} == "1" ]]; then
  REPLY="$result"
  return
fi
echo "$result"
