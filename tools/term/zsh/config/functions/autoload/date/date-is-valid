# Exit 0 if the argument is a real YYYY, YYYY-MM or YYYY-MM-DD date, 1 otherwise
# Usage:
# $ date-is-valid 2024-02-29   # exit 0: leap year
# $ date-is-valid 2023-02-29   # exit 1: no 29th of February
# $ date-is-valid 2024-13      # exit 1: no 13th month
setopt local_options err_return

local date="$1"

# The shape must be right before the calendar is checked
[[ ! "$date" =~ ^[0-9]{4}(-[0-9]{2}){0,2}$ ]] && return 1

local parts=("${(@s/-/)date}")
local month=$(( 10#${parts[2]:-1} ))
local day=$(( 10#${parts[3]:-1} ))

(( month < 1 || month > 12 )) && return 1
(( day >= 1 && day <= $(date-month-length "$(printf "%s-%02d" "${parts[1]}" "$month")") ))
