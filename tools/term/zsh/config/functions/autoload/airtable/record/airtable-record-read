# Read a single Airtable record by ID, with optional field selection
# Usage:
# $ airtable-record-read --base DevRel --table Meetups --record recXXX
# $ airtable-record-read --base appXXX --table Meetups --record recXXX --fields name,date
setopt local_options err_return

zparseopts -E -D \
  -base:=flagBase \
  -table:=flagTable \
  -record:=flagRecord \
  -fields:=flagFields

local base=${flagBase[2]}
local table=${flagTable[2]}
local recordId=${flagRecord[2]}
local fieldList=${flagFields[2]}

local libDir="${functions_source[$0]:A:h:h}/__lib"
node "${libDir}/bin/airtable-record-read.js" "$base" "$table" "$recordId" "$fieldList"
