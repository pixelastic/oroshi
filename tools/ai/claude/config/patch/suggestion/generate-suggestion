#!/usr/bin/env zsh
# Patch the Claude Code binary so Down, instead of Right, accepts the
# prompt suggestion.
# Must be re-run after each Claude Code update.
# Usage:
# $ tools/ai/claude/config/patch/suggestion/generate-suggestion
set -e

local currentDir=${0:a:h}
local binaryPath="${OROSHI_ROOT}/node_modules/.bin/claude"

# Nothing to patch if claude is not installed
if [[ ! -e "$binaryPath" ]]; then
  echo "✘ No Claude Code binary at $binaryPath"
  exit 1
fi

# Patch the real file, not the yarn symlink
node \
  "$currentDir/src/main.js" \
  --binary "${binaryPath:A}"
