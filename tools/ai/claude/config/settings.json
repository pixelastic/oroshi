{
  "syncClaudeAiSkills": false,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75"
  },
  "permissions": {
    "allow": [
      "BashOutput",
      "Fetch",
      "Glob",
      "Grep",
      "LS",
      "Read",
      "Search",
      "Skill",
      "SlashCommand",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "mcp__context7"
    ],
    "deny": ["AskUserQuestion"],
    "defaultMode": "acceptEdits"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tim/.oroshi/tools/ai/claude/config/hooks/preToolUse-Bash"
          }
        ]
      },
      {
        "matcher": "Create|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tim/.oroshi/tools/ai/claude/config/hooks/preToolUse-Write"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tim/.oroshi/tools/ai/claude/config/hooks/postToolUse-Bash"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tim/.oroshi/tools/ai/claude/config/hooks/postToolUse-Bash"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tim/.oroshi/tools/ai/claude/config/hooks/notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/tim/.oroshi/tools/ai/claude/config/hooks/stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/tim/.oroshi/tools/ai/claude/config/statusline"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "/home/tim/.oroshi/tools/ai/claude/config/statusline-subagent"
  },
  "outputStyle": "terse",
  "effortLevel": "high",
  "tui": "default",
  "autoMemoryEnabled": false,
  "theme": "custom:oroshi",
  "preferredNotifChannel": "notifications_disabled",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
