#!/usr/bin/env zsh
# Triggered when Claude think it need to notify the user
set -e

local stdinData="$(cat)"

# Do nothing if not one of the following types (each fires after ~6s idle)
# permission_prompt: Approve a tool
# elicitation_dialog: Pick a file, enter a value
# elicitation_url_dialog: About to open an URL
local notificationType="$(printf '%s\n' "$stdinData" | jq -r '.notification_type // empty')"
case "$notificationType" in
  permission_prompt | elicitation_dialog | elicitation_url_dialog) ;;
  *) exit 0 ;;
esac

# Mark the tab, and play a sound
kitty-notify --sound claude-notification.mp3
exit 2
