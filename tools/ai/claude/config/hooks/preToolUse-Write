#!/usr/bin/env zsh
# zsh-lint disable-file=missingSetE
# Hook must always exit 0 — non-zero exits bypass permission logic
#
# PreToolUse hook for Create/Write/Edit
# Auto-allow file operations on whitelisted paths
# Reads hook JSON from stdin, writes hookSpecificOutput JSON to stdout

local hookDir="${0:A:h}"

source "${hookDir}/lib/input.zsh"
source "${hookDir}/lib/permission.zsh"

# Check the path against the allowlist (glob patterns)
# Usage:
# $ pathIsAllowed "/tmp/oroshi/claude/draft.md"  # exit 0
# $ pathIsAllowed "/home/tim/project/index.js"   # exit 1
function pathIsAllowed() {
  local -a allowlist=(
    "/tmp/oroshi/claude/**"
    "*/local/tmp/oroshi/claude/**"
    "*/local/tmp/oroshi/git-file-watch/**"
    "*/local/www/plans/**"
    "$HOME/.oroshi/todo.txt"
  )

  local glob
  for glob in "${allowlist[@]}"; do
    # shellcheck disable=SC2053
    [[ "$1" == ${~glob} ]] && return 0
  done

  return 1
}

hookInit
local filePath="$(inputKeyRead '.tool_input.file_path')"

# No path, no decision
[[ "$filePath" == "" ]] && exit 0

# shellcheck disable=SC2119
pathIsAllowed "$filePath" && autoApprove

exit 0
