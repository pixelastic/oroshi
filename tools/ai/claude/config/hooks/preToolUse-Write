#!/usr/bin/env zsh
# PreToolUse hook for Create/Write/Edit
# Auto-allow file operations on whitelisted paths
set -e

# Allowlist (glob patterns)
local -a allowlist=(
  "/tmp/oroshi/claude/**"
  "*/plans/**"
)

local inputJson="$(cat)"
local filePath="$(json-get '.tool_input.file_path' <<<"$inputJson")"

[[ "$filePath" == "" ]] && exit 0

for glob in "${allowlist[@]}"; do
  # Skip if not matching
  # shellcheck disable=SC2053
  [[ "$filePath" != ${~glob} ]] && continue

  jo -d. \
    hookSpecificOutput.hookEventName="PreToolUse" \
    hookSpecificOutput.permissionDecision="allow"
  exit 0
done

exit 0
