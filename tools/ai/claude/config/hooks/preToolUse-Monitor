#!/usr/bin/env zsh
# zsh-lint disable-file=missingSetE
# Hook must always exit 0 — non-zero exits bypass permission logic
#
# PreToolUse hook for Monitor: run solkan (allow/ask) and apply its guard-rail rewrites
# No token-saving rewrite, no subagent prefix, no approval tracking
# Reads hook JSON from stdin, writes hookSpecificOutput JSON to stdout
#
# Env overrides for testing:
#   CLAUDE_HOOKS_LOG_DIR  — defaults to /tmp/oroshi/claude/hooks
#   CLAUDE_SESSIONS_DIR   — defaults to /tmp/oroshi/claude/sessions

local hookDir="${0:A:h}"

source "${hookDir}/lib/input.zsh"
source "${hookDir}/lib/log.zsh"
source "${hookDir}/lib/output.zsh"

# The original tool input, with only the command replaced
# Usage:
# $ toolInputWithCommand "$inputJson" "rm-guarded a"  # {"command":"rm-guarded a","description":"...","timeout_ms":...}
function toolInputWithCommand() {
  jq \
    --compact-output \
    --arg command "$2" \
    '.tool_input | .command = $command' <<<"$1"
}

# Ask the user, listing the rejected commands without approval count
# Ends the hook: askWithReasonToolInput exits
# Usage:
# $ askRejected "$updatedToolInput"
function askRejected() {
  local -a reasonArgs=()
  local rejectedCommand
  for rejectedCommand in $SOLKAN_REJECTED; do
    reasonArgs+=(--command "$rejectedCommand" --count 0)
  done

  askWithReasonToolInput "$(askReasonFormat "${reasonArgs[@]}")" "$1"
}

# Parse input
local inputJson="$(inputRead)"

# Session id: scopes the session allow-list, must be set before sourcing solkan.zsh
inputSessionExport "$inputJson"

source "${hookDir}/lib/solkan.zsh"

# Save input for debugging
logInput monitor "$inputJson"

# No command (WebSocket): leave the decision to the native permission flow
local inputCommand="$(inputField "$inputJson" '.tool_input.command')"
[[ "$inputCommand" == "" ]] && exit 0

# Solkan: guard-rail rewrites only, then allow or reject
solkanEvaluate --skip-token-saving "$inputCommand" "$(inputField "$inputJson" '.cwd')"
local updatedToolInput="$(toolInputWithCommand "$inputJson" "$SOLKAN_COMMAND")"

# Allowed by solkan: approve without asking
[[ "$SOLKAN_VERDICT" == "allow" ]] && autoApproveToolInput "$updatedToolInput"

askRejected "$updatedToolInput"
