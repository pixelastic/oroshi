#!/usr/bin/env zsh
# zsh-lint disable-file=missingSetE
# Hook must always exit 0 — non-zero exits bypass permission logic
#
# PreToolUse hook for Monitor: run solkan (allow/ask) and apply its guard-rail rewrites
# No token-saving rewrite, no subagent prefix, no approval tracking
# Reads hook JSON from stdin, writes hookSpecificOutput JSON to stdout
#
# Env overrides for testing:
#   CLAUDE_SESSIONS_DIR   — defaults to /tmp/oroshi/claude/sessions

local hookDir="${0:A:h}"

source "${hookDir}/lib/input.zsh"
source "${hookDir}/lib/log.zsh"
source "${hookDir}/lib/permission.zsh"

# Ask the user, listing the rejected commands without approval count
# Ends the hook: askWithReason exits
# Usage:
# $ askRejected "$updatedToolInput"
function askRejected() {
  askWithReason "$(rejectedCommandsFormat "${SOLKAN_REJECTED[@]}")" "$1"
}

# Parse input and set up the session: scopes approval state, must come before using approval-memory.zsh
hookInit

source "${hookDir}/lib/solkan.zsh"

# Uncomment for debugging: save the input to ${OROSHI_FOLDER_CACHE}/claude/hooks
# logInput monitor

# No command (WebSocket): leave the decision to the native permission flow
local inputCommand="$(inputKeyRead '.tool_input.command')"
[[ "$inputCommand" == "" ]] && exit 0

# Solkan: guard-rail rewrites only, then allow or reject
solkanEvaluate --skip-token-saving "$inputCommand"
inputKeyWrite '.tool_input.command' "$SOLKAN_COMMAND"
local updatedToolInput="$(inputKeyRead '.tool_input')"

# Allowed by solkan: approve without asking
[[ "$SOLKAN_VERDICT" == "allow" ]] && autoApprove "$updatedToolInput"

askRejected "$updatedToolInput"
