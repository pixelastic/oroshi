#!/usr/bin/env zsh
# zsh-lint disable-file=missingSetE
# Hook must always exit 0 — non-zero exits bypass permission logic
#
# Orchestrate Bash hook: run solkan (allow/ask) and apply its rewrite
# Reads hook JSON from stdin, writes hookSpecificOutput JSON to stdout
#
# Env overrides for testing:
#   CLAUDE_SESSIONS_DIR   — defaults to /tmp/oroshi/claude/sessions
#
# TEST CASES - This hook must handle:
# - echo hello                           -> accept (allowlisted)
# - rm -rf file                          -> ask (not allowlisted)
# - git log --oneline                    -> accept (multi-word allowlisted command)
# - FOO=bar echo hello                   -> accept (env vars stripped)
# - echo hello | grep hello              -> accept (both allowed)
# - echo hello | rm file                 -> ask (rm not allowed)
# - echo a | grep a && echo b || echo c  -> accept (all subcommands allowed)
# - echo ok; wget something              -> ask (wget not allowed)
# - echo "rm -rf /"                      -> accept (rm is a string, not a command)
# - time echo "test"                     -> accept (time is ignored)

local hookDir="${0:A:h}"

source "${hookDir}/lib/input.zsh"
source "${hookDir}/lib/log.zsh"
source "${hookDir}/lib/permission.zsh"
source "${hookDir}/lib/solkan.zsh"
source "${hookDir}/lib/approval-memory.zsh"

# Parse input and set up the session
hookInit

# Uncomment for debugging: save the input to ${OROSHI_FOLDER_CACHE}/claude/hooks
# logInput bash

# Parse the command with solkan
local inputCommand="$(inputKeyRead '.tool_input.command')"
solkanEvaluate "$inputCommand"

# If running in a subagent, update the command
local agentId="$(inputKeyRead '.agent_id')"
if [[ "$agentId" != "" ]]; then
  SOLKAN_COMMAND="export CLAUDE_IS_SUBAGENT=1; $SOLKAN_COMMAND"
fi

# Update the tool_input.command with the rewritten command
inputKeyWrite '.tool_input.command' "$SOLKAN_COMMAND"

# Allowed by solkan: we autoapprove it
if [[ "$SOLKAN_VERDICT" == "allow" ]]; then
  autoApprove "$(inputKeyRead '.tool_input')"
fi

# From now on, we know the command is rejected
# Remember each rejected command as waiting for the user's answer
# and collect how many times it was already approved, as command:count
local toolUseId="$(inputKeyRead '.tool_use_id')"
local -a rejectedWithCount=()
local rejectedCommand
for rejectedCommand in $SOLKAN_REJECTED; do
  # Mark this command as being open for approval (postToolUse will check if it was approved or not)
  approvalRequestOpen --tool-use-id "$toolUseId" --command "$rejectedCommand"

  # Keep track of the rejected commands and their count
  local approvalCount="$(approvalCountGet --command "$rejectedCommand")"
  rejectedWithCount+=("${rejectedCommand}:${approvalCount:-0}")
done

# Ask the use for permission to run the command
local reason="$(rejectedCommandsFormat "${rejectedWithCount[@]}")"
local updatedToolInput="$(inputKeyRead '.tool_input')"
askWithReason "$reason" "$updatedToolInput"
