#!/usr/bin/env zsh
# zsh-lint disable-file=missingSetE
# Hook must always exit 0 — non-zero exits bypass permission logic
#
# Orchestrate Bash hook: run solkan (allow/ask) and apply its rewrite
# Reads hook JSON from stdin, writes hookSpecificOutput JSON to stdout
#
# Env overrides for testing:
#   CLAUDE_HOOKS_LOG_DIR  — defaults to /tmp/oroshi/claude/hooks
#   CLAUDE_SESSIONS_DIR   — defaults to /tmp/oroshi/claude/sessions
#
# TEST CASES - This hook must handle:
# - echo hello                           -> accept (allowlisted)
# - rm -rf file                          -> ask (not allowlisted)
# - git log --oneline                    -> accept (multi-word allowlisted command)
# - FOO=bar echo hello                   -> accept (env vars stripped)
# - echo hello | grep hello              -> accept (both allowed)
# - echo hello | rm file                 -> ask (rm not allowed)
# - echo a | grep a && echo b || echo c  -> accept (all subcommands allowed)
# - echo ok; wget something              -> ask (wget not allowed)
# - echo "rm -rf /"                      -> accept (rm is a string, not a command)
# - time echo "test"                     -> accept (time is ignored)

local hookDir="${0:A:h}"

source "${hookDir}/lib/input.zsh"
source "${hookDir}/lib/log.zsh"
source "${hookDir}/lib/output.zsh"

# Parse input
local inputJson="$(inputRead)"
local inputCommand="$(inputField "$inputJson" '.tool_input.command')"
local inputCwd="$(inputField "$inputJson" '.cwd')"

# Session id: scopes approval state, must be set before sourcing Bash-approval.zsh
inputSessionExport "$inputJson"

source "${hookDir}/lib/solkan.zsh"
source "${hookDir}/Bash-approval.zsh"

# Save input for debugging
logInput bash "$inputJson"

# Solkan: rewrite the command, then allow or reject it
solkanEvaluate "$inputCommand" "$inputCwd"
local updatedInputCommand="$SOLKAN_COMMAND"

# Subagent detection: prefix with env export when agent_id is present
local agentId="$(inputField "$inputJson" '.agent_id')"
[[ "$agentId" != "" ]] && updatedInputCommand="export CLAUDE_IS_SUBAGENT=1; $updatedInputCommand"

# Allowed by solkan: approve without asking
[[ "$SOLKAN_VERDICT" == "allow" ]] && autoApprove "$updatedInputCommand"

# Approval progress of each rejected command, read before recording this prompt
local -a pendingArgs=()
local -a reasonArgs=()
local rejectedCommand
for rejectedCommand in $SOLKAN_REJECTED; do
  local approvalCount="$(approvalCountGet --command "$rejectedCommand")"
  pendingArgs+=(--command "$rejectedCommand")
  reasonArgs+=(--command "$rejectedCommand" --count "$approvalCount")
done

# Remember what the user is asked to approve, for postToolUse-Bash to count
local toolUseId="$(inputField "$inputJson" '.tool_use_id')"
approvalPendingAdd --tool-use-id "$toolUseId" "${pendingArgs[@]}"

askWithReason "$(askReasonFormat "${reasonArgs[@]}")" "$updatedInputCommand"
