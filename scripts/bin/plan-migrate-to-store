#!/usr/bin/env zsh
# One-shot migration: copy worktree plans to $OROSHI_PLANS_DIR and init git repos
# Usage:
# $ plan-migrate-to-store
set -e

PLANS_DIR="${OROSHI_PLANS_DIR:-$HOME/local/www/plans}"
WORKTREES_DIR="${OROSHI_WORKTREES_DIR:-$HOME/local/www/worktrees}"
THIS_WORKTREE="$WORKTREES_DIR/oroshi--plan-storage"

mkdir -p "$PLANS_DIR"

# Extract unique project names from worktree directory names
local -A seenProjects
for worktreeDirectory in "$WORKTREES_DIR"/*/; do
  local directoryName="${worktreeDirectory:t}"
  local project="${directoryName%%--*}"
  [[ "${seenProjects[$project]}" != "" ]] && continue
  seenProjects[$project]="$worktreeDirectory"
done

# For each project, list worktrees and migrate matching plans
for project sampleDirectory in ${(kv)seenProjects}; do
  local worktreeList="$(git -C "$sampleDirectory" worktree list)"

  for line in ${(f)worktreeList}; do
    local parts=(${=line})
    local worktreePath="$parts[1]"
    # Branch is last element, wrapped in []
    local branch="${parts[-1]//[\[\]]/}"
    local branchSlug="${branch//\//_}"

    # Only migrate plans matching this worktree's branch
    [[ ! -d "${worktreePath}/plans/${branchSlug}" ]] && continue

    local destinationName="${project}--${branchSlug}"
    local destinationDirectory="${PLANS_DIR}/${destinationName}"

    # Skip if already migrated (idempotent)
    if [[ -d "$destinationDirectory" ]]; then
      echo "Skip: ${destinationName} (already exists)"
      continue
    fi

    cp -r "${worktreePath}/plans/${branchSlug}" "$destinationDirectory"

    # Init a Plan Repo with initial commit
    git -C "$destinationDirectory" init --quiet
    git -C "$destinationDirectory" add --all
    git -C "$destinationDirectory" \
      commit \
      --quiet \
      --message "Initial plan import"

    echo "Migrated: ${destinationName}"
  done
done

# Replace local plan-storage dir with symlink to Plans Store
local localPlanDirectory="$THIS_WORKTREE/plans/plan-storage"
local symlinkTarget="$PLANS_DIR/oroshi--plan-storage"

if [[ ! -d "$symlinkTarget" ]]; then
  echo "Error: $symlinkTarget not found, cannot create symlink"
  exit 1
fi

if [[ -L "$localPlanDirectory" ]]; then
  echo "Skip: plans/plan-storage already a symlink"
  exit 0
fi

rm -rf "$localPlanDirectory"
ln -s "$symlinkTarget" "$localPlanDirectory"
echo "Symlinked: plans/plan-storage -> $symlinkTarget"
