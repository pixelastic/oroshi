#!/usr/bin/env zsh
# Convert an MP3 audio file to a VTT subtitle file using OpenAI's Whisper API.
# Usage:
# $ mp32vtt file.mp3  # Creates file.vtt
set -e

inputFile="$1"

# Validate input is an existing file
if [[ "$inputFile" == "" || ! -f "$inputFile" ]]; then
  echoerr "Usage: mp32vtt <file.mp3>"
  exit 1
fi
# Validate file is an mp3
if [[ "$inputFile" != *.mp3 ]]; then
  echoerr "Usage: mp32vtt <file.mp3>"
  exit 1
fi

if [[ "$OPENAI_API_KEY" == "" ]]; then
  echoerr "Error: OPENAI_API_KEY not set"
  exit 1
fi

outputFile="${inputFile:r}.vtt"

curl -s https://api.openai.com/v1/audio/transcriptions \
  -H "Authorization: Bearer $OPENAI_API_KEY" \
  -F "file=@$inputFile" \
  -F "model=whisper-1" \
  -F "response_format=vtt" >"$outputFile"
