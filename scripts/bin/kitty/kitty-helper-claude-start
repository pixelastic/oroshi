#!/usr/bin/env zsh
# Helper: run Claude in a kitty window, forwarding all args to claude
# Usage:
# $ kitty-helper-claude-start
# $ kitty-helper-claude-start "@/file.md"
# $ kitty-helper-claude-start --permission-mode acceptEdits "@/file.md"
set -e

# Start from the git root to make resuming sessions easier
local projectRoot="$(git-directory-root)"

# Build the claude command with safe quoting for all arguments
local cmd="claude"
for arg in "$@"; do
  cmd+=" ${(q)arg}"
done

# Launch inside interactive zsh so Claude inherits env vars from the .zshrc
# chain (NOTION_TOKEN, etc.) that aren't available in non-interactive context.
# ZSH has no --run-then-stay mode: -ic runs the command then exits, so we
# exec a fresh interactive zsh after Claude to keep the tab alive.
exec zsh -ic "cd ${(q)projectRoot} && { $cmd || true; }; exec zsh"
