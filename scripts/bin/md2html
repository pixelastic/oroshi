#!/usr/bin/env zsh
# Convert markdown files to HTML using pandoc
# Usage:
# $ md2html file.md              # Single file
# $ md2html file1.md file2.md    # Multiple files
set -e

for file in $@; do
  pandoc \
    --standalone \
    --embed-resources \
    --resource-path "${file:a:h}" \
    --css "https://cdn.jsdelivr.net/npm/sakura.css/css/sakura-dark.css" \
    --metadata title="${file:t:r}" \
    "$file" \
    -o "${file:a:r}.html"
  echo "✔ ${file:r} converted to html"
done
