#!/usr/bin/env zsh
# Check if running inside a Claude Code subagent
# CLAUDE_IS_SUBAGENT is NOT a native Claude Code env var — it is injected by
# the preToolUse-Bash hook when agent_id is present in the hook's stdin JSON
# Usage:
# $ is-claude-subagent && echo "inside subagent"
set -e

[[ "$CLAUDE_IS_SUBAGENT" == "1" ]]
