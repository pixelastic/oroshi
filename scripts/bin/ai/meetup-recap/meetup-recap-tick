#!/usr/bin/env zsh
# Copy a meetup-recap draft file to clipboard
# Usage:
# $ meetup-recap-tick /path/to/draft.md
set -e

local draftPath="$1"

# Draft file is required
if [[ "$draftPath" == "" ]]; then
  echoerr "Usage: meetup-recap-tick <draft-path>"
  return 1
fi
if [[ ! -f "$draftPath" ]]; then
  echoerr "Draft file not found: $draftPath"
  return 1
fi

clipboard-write "$(cat "$draftPath")"
