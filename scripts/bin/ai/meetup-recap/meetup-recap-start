#!/usr/bin/env zsh
# Initialize a meetup-recap session and output JSON with the draft filepath
# Usage:
# $ meetup-recap-start
# {"draftPath":"/tmp/oroshi/claude/meetup-recap/e8d0442d.md"}
set -e

local sessionDir="/tmp/oroshi/claude/meetup-recap"
mkdir --parents "$sessionDir"

local id="$(uuidgen)"
local draftPath="$sessionDir/$id.md"

jo draftPath="$draftPath"
