#!/usr/bin/env zsh
# Initialize a slack-writer session and output JSON with the draft filepath
# Usage:
# $ slack-writer-start
# {"draftPath":"/tmp/oroshi/claude/slack-writer/e8d0442d.md"}
set -e

local sessionDir="/tmp/oroshi/claude/slack-writer"
mkdir --parents "$sessionDir"

local id="$(uuidgen)"
local draftPath="$sessionDir/$id.md"

jo draftPath="$draftPath"
